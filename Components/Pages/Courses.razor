@page "/cursos"
@rendermode RenderMode.InteractiveServer
@using MudBlazor
@using EscuelaManagement.Data.Models
@using EscuelaManagement.Data.Services
@inject FirebaseService Firebase
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-6 pb-12" Style="min-height: 100vh;">
    
    <!-- ENCABEZADO M3 EXPRESSIVE -->
    <div class="mb-8 d-flex align-center gap-4 fade-in-suave">
        <MudAvatar Size="Size.Large" Style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; width: 64px; height: 64px; box-shadow: 0 10px 15px -3px rgba(16,185,129,0.3);">
            <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Size="Size.Large" />
        </MudAvatar>
        <div>
            <MudText Typo="Typo.h3" Class="font-weight-bold mb-1" Style="color: var(--mud-palette-text-primary); letter-spacing: -1px;">Gestión de Cursos</MudText>
            <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">Crea, edita y administra los cursos activos y sus esquemas de pago.</MudText>
        </div>
    </div>

    <MudGrid>
        <!-- COLUMNA IZQUIERDA: Formulario M3 -->
        <MudItem xs="12" md="5">
            <EditForm Model="@newCourse" OnValidSubmit="HandleSubmit">
                <MudPaper Elevation="0" Class="pa-8 rounded-xxl m3-section-card fade-in-up" Style="background-color: var(--mud-palette-surface);">
                    
                    <div class="d-flex align-center mb-6">
                        <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="@(isEditing ? "background-color: rgba(245,158,11,0.15); color: #f59e0b;" : "background-color: rgba(59,130,246,0.15); color: #3b82f6;")" Class="mr-3 rounded-lg">
                            <MudIcon Icon="@(isEditing ? Icons.Material.Filled.Edit : Icons.Material.Filled.AddCard)" />
                        </MudAvatar>
                        <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">
                            @(isEditing ? "Editar Curso Seleccionado" : "Nuevo Curso y Pagos")
                        </MudText>
                    </div>
                    
                    <MudGrid>
                        <MudItem xs="12">
                            <MudTextField T="string" Label="Nombre del Curso*" @bind-Value="newCourse.Name" Required="true" Variant="Variant.Outlined" Class="modern-input" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField T="string" Label="Horario (Ej. Lunes a Viernes 4-6 pm)" @bind-Value="newCourse.Schedule" Variant="Variant.Outlined" Class="modern-input" />
                        </MudItem>
                        
                        <MudItem xs="12">
                            <MudNumericField T="double" Label="Costo Una Sola Exhibición ($)*" @bind-Value="newCourse.SinglePaymentCost" Required="true" Variant="Variant.Outlined" Min="0" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AttachMoney" Class="modern-input" />
                        </MudItem>

                        <MudItem xs="12" Class="mt-2">
                            <MudPaper Elevation="0" Class="pa-5 rounded-xl" Style="background-color: var(--mud-palette-background-grey); border: 1px dashed var(--mud-palette-lines-default);">
                                <MudSwitch T="bool" @bind-Value="newCourse.AllowInstallments" Color="Color.Primary" Label="¿Ofrecer opción de pago a plazos?" Class="font-weight-bold" />
                            </MudPaper>
                        </MudItem>

                        @if (newCourse.AllowInstallments)
                        {
                            <MudItem xs="12">
                                <div class="m3-alert m3-alert-info d-flex align-center pa-3 rounded-xl mb-4 mt-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" Size="Size.Small" />
                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Plazos Disponibles</MudText>
                                </div>
                                
                                @if (newCourse.InstallmentOptions == null || !newCourse.InstallmentOptions.Any())
                                {
                                    <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-disabled);" Class="d-block mb-4 text-center"><i>No se han agregado plazos todavía.</i></MudText>
                                }
                                else
                                {
                                    <MudChipSet T="string" AllClosable="false" Class="mb-4">
                                        @foreach (var opcion in newCourse.InstallmentOptions)
                                        {
                                            <MudChip @key="opcion" T="string" Color="Color.Secondary" Variant="Variant.Filled" OnClose="(() => RemoverPlazo(opcion))" Class="font-weight-bold shadow-sm">
                                                @opcion.InstallmentCount @opcion.InstallmentPeriod de @opcion.InstallmentAmount.ToString("C")
                                            </MudChip>
                                        }
                                    </MudChipSet>
                                }
                            </MudItem>

                            <!-- Mini-formulario para agregar plazos -->
                            <MudItem xs="4">
                                <MudNumericField T="int" Label="Cant.*" @bind-Value="tempCount" Variant="Variant.Outlined" Min="1" Class="modern-input" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudSelect T="string" Label="Periodo*" @bind-Value="tempPeriod" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Class="modern-input">
                                    <MudSelectItem T="string" Value="@("Semanas")">Semanas</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("Quincenas")">Quincenas</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("Meses")">Meses</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="4">
                                <MudNumericField T="double" Label="Monto ($)*" @bind-Value="tempAmount" Variant="Variant.Outlined" Min="0" Class="modern-input" />
                            </MudItem>
                            <MudItem xs="12" Class="d-flex justify-end">
                                <MudButton OnClick="AgregarPlazoALista" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircleOutline" Class="rounded-lg font-weight-bold px-4" Style="text-transform: none; border-width: 2px;">
                                    Añadir Plazo
                                </MudButton>
                            </MudItem>
                        }
                    </MudGrid>
                    
                    <div class="d-flex gap-4 justify-end mt-8 pt-6" style="border-top: 1px solid var(--mud-palette-lines-default);">
                        @if (isEditing)
                        {
                            <MudButton OnClick="CancelarEdicion" Variant="Variant.Text" Color="Color.Default" Class="font-weight-bold rounded-xl px-6" Style="text-transform: none;">Cancelar</MudButton>
                        }
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" DisableElevation="true" Color="@(isEditing ? Color.Warning : Color.Primary)" StartIcon="@(isEditing ? Icons.Material.Filled.Save : Icons.Material.Filled.Add)" Class="font-weight-bold rounded-xl px-8 py-2 btn-vivid" Style="text-transform: none; font-size: 15px;">
                            @(isEditing ? "Guardar Cambios" : "Agregar Curso")
                        </MudButton>
                    </div>
                </MudPaper>
            </EditForm>
        </MudItem>

        <!-- COLUMNA DERECHA: Tabla M3 -->
        <MudItem xs="12" md="7">
            @if (isLoading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4 rounded-lg" />
            }
            else
            {
                <MudPaper Elevation="0" Class="pa-8 rounded-xxl m3-section-card fade-in-suave" Style="background-color: var(--mud-palette-surface);">
                    
                    <div class="d-flex align-center mb-6">
                        <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="background-color: rgba(139,92,246,0.15); color: #8b5cf6;" Class="mr-3 rounded-lg">
                            <MudIcon Icon="@Icons.Material.Filled.FormatListBulleted" />
                        </MudAvatar>
                        <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">Lista de Cursos Activos</MudText>
                    </div>
                    
                    <MudTable T="Course" Items="@listaCursos" Hover="true" Elevation="0" Class="modern-table transparent-table">
                        <HeaderContent>
                            <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); font-size: 0.75rem;">Nombre / Horario</MudTh>
                            <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); font-size: 0.75rem;">Una Exhibición</MudTh>
                            <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); font-size: 0.75rem;">Esquemas a Plazos</MudTh>
                            <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); font-size: 0.75rem; text-align: right;">Acciones</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Nombre / Horario">
                                <MudText Typo="Typo.body1" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">@context.Name</MudText>
                                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">@context.Schedule</MudText>
                            </MudTd>
                            <MudTd DataLabel="Una Exhibición">
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled" Class="font-weight-bold shadow-sm rounded-lg px-3">
                                    @context.SinglePaymentCost.ToString("C")
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Esquemas a Plazos">
                                @if (context.AllowInstallments && context.InstallmentOptions != null && context.InstallmentOptions.Any())
                                {
                                    @foreach (var opcion in context.InstallmentOptions)
                                    {
                                        <MudText Typo="Typo.caption" Class="d-block mb-1 font-weight-medium" Style="color: var(--mud-palette-text-secondary);">
                                            • <span style="color: var(--mud-palette-text-primary);">@opcion.InstallmentCount</span> @opcion.InstallmentPeriod de <span style="color: var(--mud-palette-text-primary);">@opcion.InstallmentAmount.ToString("C")</span>
                                        </MudText>
                                    }
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Outlined" Class="font-weight-bold rounded-lg px-2" Style="border-width: 2px; opacity: 0.8;">No disponible</MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="Acciones" Style="text-align: right;">
                                <div class="d-flex justify-end gap-2">
                                    <MudTooltip Text="Editar Curso" Arrow="true" Placement="Placement.Top">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="(() => IniciarEdicion(context))" Class="rounded-lg action-btn" />
                                    </MudTooltip>
                                    <MudTooltip Text="Eliminar Curso" Arrow="true" Placement="Placement.Top">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="(() => ConfirmarEliminar(context))" Class="rounded-lg action-btn" />
                                    </MudTooltip>
                                </div>
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <div class="pa-8 d-flex flex-column align-center justify-center">
                                <MudIcon Icon="@Icons.Material.Filled.Inbox" Style="font-size: 3rem; color: var(--mud-palette-text-disabled);" Class="mb-3" />
                                <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">No se encontraron cursos registrados</MudText>
                            </div>
                        </NoRecordsContent>
                    </MudTable>
                </MudPaper>
            }
        </MudItem>
    </MudGrid>

    <MudMessageBox @ref="mbox" Title="Confirmar Eliminación">
        <MessageContent>
            ¿Estás seguro de que deseas eliminar el curso "<b>@cursoAEliminar?.Name</b>"? Esta acción borrará de forma permanente el registro en Firebase.
        </MessageContent>
        <YesButton><MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" Class="rounded-xl px-6 font-weight-bold" Style="text-transform: none;">Eliminar</MudButton></YesButton>
        <CancelButton><MudButton Variant="Variant.Text" Color="Color.Default" Class="rounded-xl px-4 font-weight-bold" Style="text-transform: none;">Cancelar</MudButton></CancelButton>
    </MudMessageBox>
</MudContainer>

<style>
    /* Efecto Flotante M3 */
    .m3-section-card {
        border: 1px solid var(--mud-palette-lines-default);
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .m3-section-card:hover {
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.08);
    }

    /* Estilos modernos para los inputs (Efecto Pop-out) */
    .modern-input .mud-input-outlined-border {
        border: 2px solid transparent !important;
        transition: all 0.3s ease-in-out;
    }
    .modern-input .mud-input {
        background-color: var(--mud-palette-background-grey) !important;
        border-radius: 16px !important;
        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
    }
    .modern-input .mud-input.mud-input-focused {
        background-color: var(--mud-palette-surface) !important;
        transform: scale(1.02) translateY(-2px);
        box-shadow: 0 10px 20px -5px rgba(59, 130, 246, 0.15) !important;
    }
    .modern-input .mud-input.mud-input-focused .mud-input-outlined-border {
        border-color: var(--mud-palette-primary) !important;
        background-color: transparent !important;
    }

    /* Animación del botón guardar */
    .btn-vivid {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%) !important;
        transition: all 0.3s ease !important;
    }
    .btn-vivid:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.3) !important;
    }

    /* Botones de acción en tabla */
    .action-btn {
        background-color: var(--mud-palette-background-grey);
        transition: all 0.2s ease;
    }
    .action-btn:hover {
        transform: scale(1.1);
    }

    /* Estilos limpios para la tabla */
    .transparent-table {
        background-color: transparent !important;
    }
    .modern-table .mud-table-cell {
        border-bottom: 1px solid var(--mud-palette-lines-default) !important;
        padding: 18px 12px !important;
    }
    .modern-table .mud-table-root {
        border: none !important;
    }

    /* Pastillas de Alerta M3 */
    .m3-alert { border-left: 5px solid; }
    .m3-alert-info { background-color: rgba(59,130,246,0.1); border-left-color: #3b82f6; color: #1e40af; }
    .mud-palette-dark .m3-alert-info { color: #60a5fa; }
</style>

@code {
    private MudMessageBox mbox = default!;
    private Course? cursoAEliminar;
    private Course newCourse = new();
    private List<Course> listaCursos = new();
    private bool isLoading = true;
    private bool isEditing = false;
    private int tempCount = 12;
    private string tempPeriod = "Semanas";
    private double tempAmount = 0;

    protected override async Task OnInitializedAsync() => await CargarCursos();

    private async Task CargarCursos()
    {
        try
        {
            isLoading = true;
            listaCursos = await Firebase.GetCoursesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar cursos: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void AgregarPlazoALista()
    {
        if (tempAmount <= 0) { Snackbar.Add("El monto por plazo debe ser mayor a 0", Severity.Warning); return; }
        if (newCourse.InstallmentOptions == null) newCourse.InstallmentOptions = new List<InstallmentOption>();
        newCourse.InstallmentOptions.Add(new InstallmentOption { InstallmentCount = tempCount, InstallmentPeriod = tempPeriod, InstallmentAmount = tempAmount });
        tempAmount = 0;
        StateHasChanged();
    }

    private void RemoverPlazo(InstallmentOption opcion) { newCourse.InstallmentOptions.Remove(opcion); StateHasChanged(); }

    private void IniciarEdicion(Course cursoSeleccionado)
    {
        isEditing = true;
        newCourse = new Course { Id = cursoSeleccionado.Id, Name = cursoSeleccionado.Name, Schedule = cursoSeleccionado.Schedule, SinglePaymentCost = cursoSeleccionado.SinglePaymentCost, AllowInstallments = cursoSeleccionado.AllowInstallments, InstallmentOptions = cursoSeleccionado.InstallmentOptions != null ? new List<InstallmentOption>(cursoSeleccionado.InstallmentOptions) : new List<InstallmentOption>() };
        StateHasChanged();
    }

    private void CancelarEdicion() { isEditing = false; newCourse = new Course(); tempAmount = 0; StateHasChanged(); }

    private async Task ConfirmarEliminar(Course curso)
    {
        cursoAEliminar = curso;
        if (await mbox.ShowAsync() == true)
        {
            try { await Firebase.DeleteCourseAsync(curso.Id); Snackbar.Add("Curso eliminado con éxito", Severity.Success); if (isEditing && newCourse.Id == curso.Id) CancelarEdicion(); await CargarCursos(); }
            catch (Exception ex) { Snackbar.Add($"Error al eliminar el curso: {ex.Message}", Severity.Error); }
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            if (!newCourse.AllowInstallments) newCourse.InstallmentOptions.Clear();
            else if (newCourse.InstallmentOptions == null || !newCourse.InstallmentOptions.Any()) { Snackbar.Add("Habilitaste los plazos pero no añadiste ninguno a la lista.", Severity.Warning); return; }
            await Firebase.AddCourseAsync(newCourse);
            Snackbar.Add(isEditing ? "Curso actualizado con éxito" : "Curso registrado con éxito", Severity.Success);
            isEditing = false; newCourse = new Course(); await CargarCursos();
        }
        catch (Exception ex) { Snackbar.Add($"Error al procesar curso: {ex.Message}", Severity.Error); }
    }
}
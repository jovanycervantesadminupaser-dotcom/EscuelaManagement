@page "/materias"
@rendermode RenderMode.InteractiveServer
@using MudBlazor
@using EscuelaManagement.Data.Models
@using EscuelaManagement.Data.Services
@inject FirebaseService Firebase
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-6 pb-12" Style="min-height: 100vh;">
    
    <!-- ENCABEZADO M3 EXPRESSIVE -->
    <div class="mb-8 d-flex align-center gap-4 fade-in-suave">
        <MudAvatar Size="Size.Large" Style="background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); color: white; width: 64px; height: 64px; box-shadow: 0 10px 15px -3px rgba(14,165,233,0.3);">
            <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Size="Size.Large" />
        </MudAvatar>
        <div>
            <MudText Typo="Typo.h3" Class="font-weight-bold mb-1" Style="color: var(--mud-palette-text-primary); letter-spacing: -1px;">Gestión de Materias y Asignaciones</MudText>
            <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">Registra nuevas materias y asígnalas a los profesores y cursos correspondientes.</MudText>
        </div>
    </div>

    <MudGrid>
        <!-- COLUMNA IZQUIERDA: Formulario M3 -->
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="pa-8 rounded-xxl m3-section-card fade-in-up" Style="background-color: var(--mud-palette-surface);">
                
                <div class="d-flex align-center mb-6">
                    <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="background-color: rgba(14,165,233,0.15); color: #0ea5e9;" Class="mr-3 rounded-lg">
                        <MudIcon Icon="@Icons.Material.Filled.MenuBook" />
                    </MudAvatar>
                    <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">Nueva Materia</MudText>
                </div>
                
                <MudForm @ref="form" @bind-IsValid="@success">
                    <MudSelect T="string" Label="Seleccionar Curso" @bind-Value="nuevaMateria.CursoId" Required="true" RequiredError="Debes elegir un curso" Variant="Variant.Outlined" Class="modern-input mb-4" AnchorOrigin="Origin.BottomCenter">
                        @if (listaCursos.Any())
                        {
                            @foreach (var curso in listaCursos)
                            {
                                <MudSelectItem T="string" Value="@curso.Id">@curso.Name</MudSelectItem>
                            }
                        }
                        else
                        {
                            <MudSelectItem T="string" Value="@string.Empty" Disabled="true">Cargando cursos...</MudSelectItem>
                        }
                    </MudSelect>
                    
                    <MudTextField T="string" @bind-Value="nuevaMateria.Nombre" Label="Nombre de la Materia (Ej. Matemáticas)" Required="true" RequiredError="El nombre es obligatorio" Variant="Variant.Outlined" Class="modern-input mb-4" />
                    
                    <MudTextField T="string" @bind-Value="nuevaMateria.Profesor" Label="Profesor Titular" Required="true" RequiredError="Asigna un profesor" Variant="Variant.Outlined" Class="modern-input mb-8" />
                    
                    <div class="d-flex justify-end pt-2" style="border-top: 1px solid var(--mud-palette-lines-default);">
                        <MudButton T="string" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" OnClick="GuardarMateria" Disabled="@(!success)" Class="rounded-xl font-weight-bold py-3 btn-vivid" Style="text-transform: none; color: white;">
                            Registrar Materia
                        </MudButton>
                    </div>
                </MudForm>
            </MudPaper>
        </MudItem>

        <!-- COLUMNA DERECHA: Catálogo / Tabla M3 -->
        <MudItem xs="12" md="8">
            @if (isLoading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4 rounded-lg" />
            }
            else
            {
                <MudPaper Elevation="0" Class="pa-8 rounded-xxl m3-section-card fade-in-suave h-100" Style="background-color: var(--mud-palette-surface);">
                    <MudTable T="Materia" Items="@MateriasFiltradas" Hover="true" Elevation="0" Class="modern-table transparent-table">
                        <ToolBarContent>
                            <div class="d-flex align-center">
                                <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="background-color: rgba(139,92,246,0.15); color: #8b5cf6;" Class="mr-3 rounded-lg">
                                    <MudIcon Icon="@Icons.Material.Filled.CollectionsBookmark" />
                                </MudAvatar>
                                <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">Catálogo Activo</MudText>
                            </div>
                            <MudSpacer />
                            <MudTextField T="string" @bind-Value="searchString" Placeholder="Buscar por materia o profesor..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0 modern-input" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Clearable="true"></MudTextField>
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); font-size: 0.75rem; border-bottom: 2px solid var(--mud-palette-lines-default);">Curso</MudTh>
                            <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); font-size: 0.75rem; border-bottom: 2px solid var(--mud-palette-lines-default);">Materia</MudTh>
                            <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); font-size: 0.75rem; border-bottom: 2px solid var(--mud-palette-lines-default);">Profesor Asignado</MudTh>
                            <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); text-align:center; font-size: 0.75rem; border-bottom: 2px solid var(--mud-palette-lines-default);">Acciones</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Curso">
                                <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled" Class="font-weight-bold shadow-sm rounded-lg px-3">
                                    @(ObtenerNombreCurso(context.CursoId))
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Materia">
                                <MudText Typo="Typo.body1" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">@context.Nombre</MudText>
                            </MudTd>
                            <MudTd DataLabel="Profesor">
                                <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">@context.Profesor</MudText>
                            </MudTd>
                            <MudTd DataLabel="Acciones" Style="text-align:center;">
                                <MudTooltip Text="Eliminar Materia" Arrow="true" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => BorrarMateria(context))" Class="rounded-lg action-btn" />
                                </MudTooltip>
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <div class="d-flex flex-column align-center justify-center pa-12 fade-in-suave">
                                <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Color="Color.Default" Style="font-size: 6rem; opacity: 0.3;" Class="mb-4" />
                                <MudText Typo="Typo.h5" Class="mb-2 font-weight-bold" Style="color: var(--mud-palette-text-secondary);">Aún no hay materias</MudText>
                                <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">No se encontraron materias registradas o que coincidan con tu búsqueda.</MudText>
                            </div>
                        </NoRecordsContent>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" RowsPerPageString="Materias por página:" InfoFormat="{first_item}-{last_item} de {all_items}" />
                        </PagerContent>
                    </MudTable>
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
</MudContainer>

<style>
    /* Efecto Flotante M3 */
    .m3-section-card {
        border: 1px solid var(--mud-palette-lines-default);
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05);
        transition: transform 0.3s ease, background-color 0.3s ease, border-color 0.3s ease;
    }
    .m3-section-card:hover {
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.08);
    }

    /* Inputs adaptables nativamente al Modo Oscuro */
    .modern-input .mud-input-outlined-border {
        border: 2px solid transparent !important;
        transition: all 0.3s ease-in-out;
    }
    .modern-input .mud-input {
        background-color: var(--mud-palette-background) !important;
        border-radius: 16px !important;
        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
    }
    .modern-input .mud-input.mud-input-focused {
        background-color: var(--mud-palette-surface) !important;
        transform: scale(1.02) translateY(-2px);
        box-shadow: 0 10px 20px -5px rgba(14, 165, 233, 0.15) !important;
    }
    .modern-input .mud-input.mud-input-focused .mud-input-outlined-border {
        border-color: var(--mud-palette-primary) !important;
        background-color: transparent !important;
    }

    /* Estilos limpios para la tabla */
    .transparent-table { background-color: transparent !important; }
    .modern-table .mud-table-cell {
        border-bottom: 1px solid var(--mud-palette-lines-default) !important;
        padding: 18px 16px !important;
    }
    .modern-table .mud-table-root { border: none !important; }

    /* Botones de acción en tabla */
    .action-btn {
        background-color: var(--mud-palette-background);
        transition: all 0.2s ease;
    }
    .action-btn:hover { transform: scale(1.1); }

    /* Botón Vívido */
    .btn-vivid {
        background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%) !important;
        transition: all 0.3s ease !important;
    }
    .btn-vivid:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(14, 165, 233, 0.3) !important;
    }
</style>

@code {
    private MudForm form = default!;
    private bool success;
    private string searchString = "";
    private bool isLoading = true;
    
    private Materia nuevaMateria = new();
    private List<Materia> listaMaterias = new();
    private List<Course> listaCursos = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        isLoading = true;
        try
        {
            listaMaterias = await Firebase.GetMateriasAsync() ?? new();
            listaCursos = await Firebase.GetCoursesAsync() ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<Materia> MateriasFiltradas =>
        listaMaterias.Where(m => string.IsNullOrWhiteSpace(searchString) 
            || m.Nombre.Contains(searchString, StringComparison.OrdinalIgnoreCase) 
            || m.Profesor.Contains(searchString, StringComparison.OrdinalIgnoreCase));

    private string ObtenerNombreCurso(string cursoId)
    {
        var curso = listaCursos.FirstOrDefault(c => c.Id == cursoId);
        return curso?.Name ?? "Desconocido";
    }

    private async Task GuardarMateria()
    {
        await form.ValidateAsync();
        if (form.IsValid)
        {
            if (string.IsNullOrEmpty(nuevaMateria.Id))
                nuevaMateria.Id = Guid.NewGuid().ToString();

            await Firebase.AddMateriaAsync(nuevaMateria);
            
            Snackbar.Add("Materia registrada exitosamente", Severity.Success);
            
            nuevaMateria = new Materia();
            await form.ResetAsync();
            await CargarDatos();
            StateHasChanged();
        }
    }

    private async Task BorrarMateria(Materia materia)
    {
        if (string.IsNullOrEmpty(materia.Id)) return;

        await Firebase.DeleteMateriaAsync(materia.Id);
        await CargarDatos();
        Snackbar.Add("Materia eliminada correctamente", Severity.Warning);
        StateHasChanged();
    }
}
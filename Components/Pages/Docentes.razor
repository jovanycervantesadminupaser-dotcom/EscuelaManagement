@page "/control-escolar/docentes"
@rendermode RenderMode.InteractiveServer
@using MudBlazor
@using System.IO
@using EscuelaManagement.Data.Models
@using EscuelaManagement.Data.Services
@using QuestPDF.Fluent

@inject FirebaseService Firebase
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-6 pb-12" Style="min-height: 100vh;">
    
    <!-- ENCABEZADO M3 EXPRESSIVE -->
    <div class="mb-8 d-flex align-center gap-4 fade-in-suave">
        <MudAvatar Size="Size.Large" Style="background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); color: white; width: 64px; height: 64px; box-shadow: 0 10px 15px -3px rgba(14,165,233,0.3);">
            <MudIcon Icon="@Icons.Material.Filled.CoPresent" Size="Size.Large" />
        </MudAvatar>
        <div>
            <MudText Typo="Typo.h3" Class="font-weight-bold mb-1" Style="color: var(--mud-palette-text-primary); letter-spacing: -1px;">Directorio de Docentes</MudText>
            <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">Registra el expediente de los profesores y genera sus credenciales institucionales.</MudText>
        </div>
    </div>

    <!-- TABS M3 EXPRESSIVE -->
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelClass="pt-8 fade-in-suave" Style="background-color: transparent;">
        
        @* --- PESTAÑA 1: REGISTRO Y DIRECTORIO --- *@
        <MudTabPanel Text="Expediente" Icon="@Icons.Material.Filled.AssignmentInd">
            
            <MudGrid>
                <!-- COLUMNA IZQUIERDA: FORMULARIO DETALLADO -->
                <MudItem xs="12" md="8">
                    <MudPaper Elevation="0" Class="pa-8 mb-8 rounded-xxl m3-section-card fade-in-up" Style="background-color: var(--mud-palette-surface);">
                        <div class="d-flex align-center mb-6">
                            <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="background-color: rgba(14,165,233,0.15); color: #0ea5e9;" Class="mr-3 rounded-lg">
                                <MudIcon Icon="@Icons.Material.Filled.AssignmentInd" />
                            </MudAvatar>
                            <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">Expediente del Profesor</MudText>
                        </div>

                        <MudGrid>
                            <!-- Datos Personales y Académicos -->
                            <MudItem xs="12">
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2" Style="color: var(--mud-palette-text-secondary);">Datos Personales y Académicos</MudText>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="nuevoDocente.NombreCompleto" Label="Nombre Completo" Variant="Variant.Outlined" Class="modern-input" Required="true" RequiredError="Requerido" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="nuevoDocente.EspecialidadCarrera" Label="Especialidad o Carrera" Variant="Variant.Outlined" Class="modern-input" Placeholder="Ej. Lic. en Matemáticas" Required="true" RequiredError="Requerido" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="nuevoDocente.UniversidadEgreso" Label="Universidad de Egreso" Variant="Variant.Outlined" Class="modern-input" Placeholder="Ej. UNAM, IPN" />
                            </MudItem>

                            <!-- Domicilio Detallado -->
                            <MudItem xs="12" Class="mt-2">
                                <MudDivider />
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold mt-4 mb-2" Style="color: var(--mud-palette-text-secondary);">Domicilio</MudText>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="nuevoDocente.Calle" Label="Calle" Variant="Variant.Outlined" Class="modern-input" />
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <MudTextField @bind-Value="nuevoDocente.NumeroExterior" Label="No. Ext." Variant="Variant.Outlined" Class="modern-input" />
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <MudTextField @bind-Value="nuevoDocente.NumeroInterior" Label="No. Int. (Opcional)" Variant="Variant.Outlined" Class="modern-input" />
                            </MudItem>
                            <MudItem xs="12" md="5">
                                <MudTextField @bind-Value="nuevoDocente.Colonia" Label="Colonia" Variant="Variant.Outlined" Class="modern-input" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="nuevoDocente.Municipio" Label="Municipio/Alcaldía" Variant="Variant.Outlined" Class="modern-input" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudTextField @bind-Value="nuevoDocente.CodigoPostal" Label="C.P." Variant="Variant.Outlined" MaxLength="5" Class="modern-input" />
                            </MudItem>

                            <!-- Contacto -->
                            <MudItem xs="12" Class="mt-2">
                                <MudDivider />
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold mt-4 mb-2" Style="color: var(--mud-palette-text-secondary);">Contacto</MudText>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="nuevoDocente.Telefono" Label="Teléfono" Variant="Variant.Outlined" MaxLength="10" InputType="InputType.Telephone" Class="modern-input" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="nuevoDocente.CorreoElectronico" Label="Correo Electrónico" Variant="Variant.Outlined" InputType="InputType.Email" Class="modern-input" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>

                <!-- COLUMNA DERECHA: FOTOGRAFÍA Y GUARDAR -->
                <MudItem xs="12" md="4">
                    <MudPaper Elevation="0" Class="pa-8 mb-8 rounded-xxl m3-section-card fade-in-up" Style="background-color: var(--mud-palette-surface); animation-delay: 0.1s;">
                        <div class="d-flex flex-column align-center justify-center w-100">
                            <MudText Typo="Typo.h6" Class="font-weight-bold mb-4" Style="color: var(--mud-palette-text-primary);">Fotografía Oficial</MudText>
                            
                            @if (isCameraOpen)
                            {
                                <div class="fade-in-suave w-100 d-flex flex-column align-center">
                                    <video id="cameraVideo" width="100%" style="max-width: 240px; border-radius: 16px; background-color: black; border: 4px solid var(--mud-palette-primary);" autoplay></video>
                                    <div class="mt-4 d-flex gap-2 w-100 justify-center">
                                        <MudButton OnClick="CapturarFoto" Color="Color.Success" Variant="Variant.Filled" DropShadow="false" StartIcon="@Icons.Material.Filled.Camera" Class="rounded-xl font-weight-bold px-4" Style="text-transform: none;">Tomar</MudButton>
                                        <MudButton OnClick="CerrarCamara" Color="Color.Error" Variant="Variant.Text" Class="font-weight-bold rounded-xl px-4" Style="text-transform: none;">Cancelar</MudButton>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex flex-column align-center gap-4 w-100">
                                    @if (!string.IsNullOrEmpty(nuevoDocente.FotoBase64))
                                    {
                                        <MudImage Src="@nuevoDocente.FotoBase64" Width="160" Height="160" ObjectFit="ObjectFit.Cover" Elevation="4" Class="rounded-xxl fade-in-suave" Style="border: 3px solid var(--mud-palette-background);" />
                                    }
                                    else
                                    {
                                        <MudPaper Width="160px" Height="160px" Class="d-flex align-center justify-center rounded-xxl fade-in-suave" Elevation="0" Style="border: 2px dashed var(--mud-palette-lines-default); background-color: var(--mud-palette-background);">
                                            <MudIcon Icon="@Icons.Material.Filled.PersonOutline" Style="font-size: 5rem; color: var(--mud-palette-text-disabled);" />
                                        </MudPaper>
                                    }
                                    
                                    <div class="d-flex gap-2 w-100 justify-center">
                                        <MudButton HtmlTag="label" for="fileInputDocente" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FileUpload" Class="rounded-xl font-weight-bold px-4 py-2" Style="text-transform: none;">Subir</MudButton>
                                        <MudButton OnClick="AbrirCamara" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CameraAlt" DropShadow="false" Class="rounded-xl font-weight-bold px-4 py-2" Style="text-transform: none; background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); color: white;">Cámara</MudButton>
                                    </div>
                                    <InputFile id="fileInputDocente" OnChange="UploadPhoto" accept=".jpg,.jpeg,.png" style="display: none;" />
                                </div>
                            }

                            <MudDivider Class="my-6 w-100" />

                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Large" FullWidth="true" OnClick="GuardarDocente" Disabled="@guardando" StartIcon="@Icons.Material.Filled.Save" Class="rounded-xl font-weight-bold py-3" DropShadow="false" Style="text-transform: none;">
                                @if (guardando)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <span>Guardando...</span>
                                }
                                else
                                {
                                    <span>Guardar Expediente</span>
                                }
                            </MudButton>
                            
                            @if (!string.IsNullOrEmpty(nuevoDocente.Id))
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" OnClick="LimpiarFormulario" Class="mt-2 rounded-xl font-weight-bold" Style="text-transform: none;">
                                    Nueva Captura
                                </MudButton>
                            }
                        </div>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <!-- TABLA DE DIRECTORIO DE DOCENTES -->
            @if (isLoading)
            {
                <div class="d-flex justify-center pa-8">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                </div>
            }
            else
            {
                <MudPaper Elevation="0" Class="pa-8 rounded-xxl m3-section-card fade-in-suave" Style="background-color: var(--mud-palette-surface);">
                    <div class="d-flex align-center justify-space-between mb-6">
                        <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">Docentes Registrados (@listaDocentes.Count)</MudText>
                    </div>

                    <MudTable Items="@listaDocentes" Hover="true" Elevation="0" Class="modern-table transparent-table" Striped="true">
                        <HeaderContent>
                            <MudTh Style="font-weight: bold; color: var(--mud-palette-text-secondary); text-transform: uppercase;">Profesor</MudTh>
                            <MudTh Style="font-weight: bold; color: var(--mud-palette-text-secondary); text-transform: uppercase;">Especialidad</MudTh>
                            <MudTh Style="font-weight: bold; color: var(--mud-palette-text-secondary); text-transform: uppercase;">Contacto</MudTh>
                            <MudTh Style="font-weight: bold; color: var(--mud-palette-text-secondary); text-transform: uppercase; text-align: center;">Acciones</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="docente">
                            <MudTd DataLabel="Profesor">
                                <div class="d-flex align-center gap-3">
                                    @if (!string.IsNullOrEmpty(docente.FotoBase64))
                                    {
                                        <MudAvatar Size="Size.Medium">
                                            <MudImage Src="@docente.FotoBase64" ObjectFit="ObjectFit.Cover" Width="40" Height="40" />
                                        </MudAvatar>
                                    }
                                    else
                                    {
                                        <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">@docente.NombreCompleto.FirstOrDefault()</MudAvatar>
                                    }
                                    <MudText Typo="Typo.body1" Class="font-weight-bold">@docente.NombreCompleto</MudText>
                                </div>
                            </MudTd>
                            <MudTd DataLabel="Especialidad">
                                <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Text" Class="font-weight-bold">@docente.EspecialidadCarrera</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Contacto">
                                <MudText Typo="Typo.body2">@docente.Telefono</MudText>
                                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">@docente.CorreoElectronico</MudText>
                            </MudTd>
                            <MudTd DataLabel="Acciones" Style="text-align: center;">
                                <MudTooltip Text="Generar Credencial PDF" Arrow="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Badge" Color="Color.Info" OnClick="() => GenerarCredencialIndividual(docente)" />
                                </MudTooltip>
                                <MudTooltip Text="Editar Datos" Arrow="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" OnClick="() => EditarDocente(docente)" />
                                </MudTooltip>
                                <MudTooltip Text="Dar de Baja" Arrow="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => EliminarDocente(docente)" />
                                </MudTooltip>
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Align="Align.Center">Aún no hay docentes registrados.</MudText>
                        </NoRecordsContent>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" RowsPerPageString="Docentes por página:" />
                        </PagerContent>
                    </MudTable>
                </MudPaper>
            }
        </MudTabPanel>

        @* --- PESTAÑA 2: EMISIÓN EN LOTE --- *@
        <MudTabPanel Text="Emisión en Lote" Icon="@Icons.Material.Filled.PeopleAlt">
            <div class="fade-in-suave">
                <div class="m3-alert m3-alert-info d-flex align-center pa-4 rounded-xl mb-6">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-3" />
                    <div>
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Información de Formato</MudText>
                        <MudText Typo="Typo.body2">El sistema generará el <b>Anverso y Reverso</b> de las credenciales de los docentes seleccionados, listas para imprimirse.</MudText>
                    </div>
                </div>

                <!-- CONTROLES DE IMPRESIÓN (BÚSQUEDA Y CONFIGURACIÓN) -->
                <MudPaper Elevation="0" Class="pa-6 rounded-xxl mb-6 m3-section-card" Style="background-color: var(--mud-palette-surface);">
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="searchStringLote" Label="Buscar por nombre..." Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Class="modern-input" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="vigenciaInput" Label="Vigencia" Variant="Variant.Outlined" Class="modern-input" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="directorInput" Label="Firma Director" Variant="Variant.Outlined" Class="modern-input" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <MudPaper Elevation="0" Class="pa-8 rounded-xxl m3-section-card" Style="background-color: var(--mud-palette-surface);">
                    <MudTable T="Teacher" Items="@DocentesFiltradosLote" MultiSelection="true" @bind-SelectedItems="docentesSeleccionados" Hover="true" Elevation="0" Class="modern-table transparent-table">
                        <ToolBarContent>
                            <div class="d-flex align-center">
                                <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="background-color: rgba(139,92,246,0.15); color: #8b5cf6;" Class="mr-3 rounded-lg">
                                    <MudIcon Icon="@Icons.Material.Filled.RecentActors" />
                                </MudAvatar>
                                <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">Docentes Disponibles para Imprimir</MudText>
                            </div>
                            <MudSpacer />
                            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Print" Disabled="@(!docentesSeleccionados.Any() || generandoPdfLote)" OnClick="GenerarPDFLote" Class="rounded-xl font-weight-bold py-2 px-6 btn-vivid-success" Style="text-transform: none; color: white;">
                                @if (generandoPdfLote)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                                    <span>Procesando...</span>
                                }
                                else
                                {
                                    <span>Generar @docentesSeleccionados.Count Credenciales</span>
                                }
                            </MudButton>
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); font-size: 0.75rem; border-bottom: 2px solid var(--mud-palette-lines-default);">Foto</MudTh>
                            <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); font-size: 0.75rem; border-bottom: 2px solid var(--mud-palette-lines-default);">Nombre del Docente</MudTh>
                            <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); font-size: 0.75rem; border-bottom: 2px solid var(--mud-palette-lines-default);">Especialidad</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="docenteRow">
                            <MudTd DataLabel="Foto">
                                @if (!string.IsNullOrEmpty(docenteRow.FotoBase64))
                                {
                                    <MudAvatar Size="Size.Medium" Class="rounded-lg shadow-sm">
                                        <MudImage Src="@docenteRow.FotoBase64" ObjectFit="ObjectFit.Cover" Width="40" Height="40" />
                                    </MudAvatar>
                                }
                                else
                                {
                                    <MudAvatar Color="Color.Primary" Size="Size.Medium" Class="rounded-lg shadow-sm">@((docenteRow.NombreCompleto ?? "U").Substring(0, 1))</MudAvatar>
                                }
                            </MudTd>
                            <MudTd DataLabel="Nombre">
                                <MudText Typo="Typo.body1" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">@docenteRow.NombreCompleto</MudText>
                            </MudTd>
                            <MudTd DataLabel="Especialidad">
                                <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled" Class="font-weight-bold shadow-sm rounded-lg px-3">@docenteRow.EspecialidadCarrera</MudChip>
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <div class="d-flex flex-column align-center justify-center pa-12 fade-in-suave">
                                <MudIcon Icon="@Icons.Material.Filled.GroupOff" Color="Color.Default" Style="font-size: 6rem; opacity: 0.3;" Class="mb-4" />
                                <MudText Typo="Typo.h5" Class="mb-2 font-weight-bold" Style="color: var(--mud-palette-text-secondary);">Sin resultados</MudText>
                                <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">No se encontraron docentes con los filtros actuales.</MudText>
                            </div>
                        </NoRecordsContent>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" RowsPerPageString="Filas:" />
                        </PagerContent>
                    </MudTable>
                </MudPaper>
            </div>
        </MudTabPanel>

    </MudTabs>
</MudContainer>

<MudMessageBox @ref="mbox" Title="Confirmar Baja">
    <MessageContent>
        ¿Estás seguro de que deseas eliminar permanentemente el expediente de este profesor?
    </MessageContent>
    <YesButton><MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever" Class="rounded-xl px-4 py-2" Style="text-transform: none;">Eliminar</MudButton></YesButton>
    <CancelButton><MudButton Variant="Variant.Text" Class="rounded-xl px-4 py-2" Style="text-transform: none;">Cancelar</MudButton></CancelButton>
</MudMessageBox>

<style>
    .m3-section-card { border: 1px solid var(--mud-palette-lines-default); box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05); transition: transform 0.3s ease, background-color 0.3s ease, border-color 0.3s ease; }
    .m3-section-card:hover { box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.08); }
    .modern-input .mud-input-outlined-border { border: 2px solid transparent !important; transition: all 0.3s ease-in-out; }
    .modern-input .mud-input { background-color: var(--mud-palette-background) !important; border-radius: 12px !important; transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) !important; }
    .modern-input .mud-input.mud-input-focused { background-color: var(--mud-palette-surface) !important; transform: scale(1.02) translateY(-2px); box-shadow: 0 10px 20px -5px rgba(14, 165, 233, 0.15) !important; }
    .modern-input .mud-input.mud-input-focused .mud-input-outlined-border { border-color: var(--mud-palette-primary) !important; background-color: transparent !important; }
    .transparent-table { background-color: transparent !important; }
    .modern-table .mud-table-cell { border-bottom: 1px solid var(--mud-palette-lines-default) !important; padding: 12px 16px !important; }

    .m3-alert { border-left: 5px solid; transition: all 0.3s ease; }
    .m3-alert-info { background-color: rgba(14,165,233,0.1); border-left-color: #0ea5e9; color: #0369a1; }
    .mud-palette-dark .m3-alert-info { background-color: rgba(14,165,233,0.15); color: #7dd3fc; }

    .btn-vivid-success { background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important; transition: all 0.3s ease !important; }
    .btn-vivid-success:hover { transform: translateY(-2px); box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.3) !important; }
</style>

@code {
    private Teacher nuevoDocente = new();
    private List<Teacher> listaDocentes = new();
    private ConfiguracionEscuela configuracionEscuela = new();
    
    private MudMessageBox mbox = default!;
    private bool isCameraOpen = false;
    private bool isLoading = true;
    private bool guardando = false;

    // --- Variables para Pestaña 2 (Emisión en Lote y Configuración) ---
    private string searchStringLote = "";
    private bool generandoPdfLote = false;
    private HashSet<Teacher> docentesSeleccionados = new();

    private string vigenciaInput = "2026 - 2027";
    private string directorInput = "MTRO. JOVANY IVAN CERVANTES CARRERAS";

    private IEnumerable<Teacher> DocentesFiltradosLote => listaDocentes.Where(x => 
        (string.IsNullOrEmpty(searchStringLote) || $"{(x.NombreCompleto ?? "")}".Contains(searchStringLote, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        QuestPDF.Settings.License = QuestPDF.Infrastructure.LicenseType.Community;
        configuracionEscuela = await Firebase.GetConfiguracionAsync() ?? new();
        await CargarDirectorio();
    }

    private async Task CargarDirectorio()
    {
        isLoading = true;
        StateHasChanged();
        listaDocentes = await Firebase.GetAllTeachersAsync();
        isLoading = false;
        StateHasChanged();
    }

    private async Task GuardarDocente()
    {
        if (string.IsNullOrWhiteSpace(nuevoDocente.NombreCompleto) || string.IsNullOrWhiteSpace(nuevoDocente.EspecialidadCarrera))
        {
            Snackbar.Add("El nombre completo y la especialidad son obligatorios.", Severity.Warning);
            return;
        }

        guardando = true;
        StateHasChanged();

        try
        {
            await Firebase.AddTeacherAsync(nuevoDocente);
            Snackbar.Add("Expediente del docente guardado con éxito.", Severity.Success);
            LimpiarFormulario();
            await CargarDirectorio();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar: {ex.Message}", Severity.Error);
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    private void EditarDocente(Teacher docente)
    {
        nuevoDocente = new Teacher
        {
            Id = docente.Id,
            NombreCompleto = docente.NombreCompleto,
            Calle = docente.Calle,
            NumeroExterior = docente.NumeroExterior,
            NumeroInterior = docente.NumeroInterior,
            Colonia = docente.Colonia,
            Municipio = docente.Municipio,
            CodigoPostal = docente.CodigoPostal,
            UniversidadEgreso = docente.UniversidadEgreso,
            Telefono = docente.Telefono,
            CorreoElectronico = docente.CorreoElectronico,
            EspecialidadCarrera = docente.EspecialidadCarrera,
            FotoBase64 = docente.FotoBase64,
            Activo = docente.Activo,
            FechaRegistro = docente.FechaRegistro
        };
        Snackbar.Add("Modifica los datos y presiona Guardar Expediente.", Severity.Info);
    }

    private async Task EliminarDocente(Teacher docente)
    {
        if (await mbox.ShowAsync() == true)
        {
            try
            {
                await Firebase.DeleteTeacherAsync(docente.Id);
                Snackbar.Add("Expediente eliminado.", Severity.Success);
                await CargarDirectorio();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
        }
    }

    private void LimpiarFormulario()
    {
        nuevoDocente = new Teacher();
        isCameraOpen = false;
        StateHasChanged();
    }

    private async Task AbrirCamara()
    {
        isCameraOpen = true;
        StateHasChanged();
        await Task.Delay(100); 
        await JSRuntime.InvokeVoidAsync("cameraHelper.startCamera", "cameraVideo");
    }

    private async Task CapturarFoto()
    {
        try
        {
            var base64 = await JSRuntime.InvokeAsync<string>("cameraHelper.takeSnapshot", "cameraVideo");
            nuevoDocente.FotoBase64 = base64;
            await CerrarCamara();
            Snackbar.Add("Fotografía capturada.", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Error al tomar la foto.", Severity.Error);
            await CerrarCamara();
        }
    }

    private async Task CerrarCamara()
    {
        await JSRuntime.InvokeVoidAsync("cameraHelper.stopCamera");
        isCameraOpen = false;
        StateHasChanged();
    }

    private async Task UploadPhoto(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            var buffer = memoryStream.ToArray();
            nuevoDocente.FotoBase64 = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
        }
    }
    
    private async Task GenerarCredencialIndividual(Teacher docente)
    {
        try
        {
            Snackbar.Add("Preparando diseño de credencial...", Severity.Info);
            var pdfBytes = CrearPdfCredencialesDocentes(new List<Teacher> { docente });
            await DescargarPdf(pdfBytes, $"Credencial_{docente.NombreCompleto}.pdf");
            Snackbar.Add("Credencial descargada correctamente.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al generar credencial: {ex.Message}", Severity.Error);
        }
    }

    private async Task GenerarPDFLote()
    {
        if (!docentesSeleccionados.Any()) return;

        try
        {
            generandoPdfLote = true;
            StateHasChanged();
            await Task.Delay(100); 

            var pdfBytes = CrearPdfCredencialesDocentes(docentesSeleccionados.ToList());
            
            using var stream = new MemoryStream(pdfBytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JSRuntime.InvokeVoidAsync("downloadFileFromStream", $"Lote_Credenciales_Docentes_{DateTime.Now:yyyyMMdd_HHmm}.pdf", streamRef);
            
            Snackbar.Add($"¡{docentesSeleccionados.Count} credenciales de docente generadas exitosamente!", Severity.Success);
            docentesSeleccionados.Clear();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al generar las credenciales: {ex.Message}", Severity.Error);
        }
        finally
        {
            generandoPdfLote = false;
            StateHasChanged();
        }
    }

    private byte[] CrearPdfCredencialesDocentes(List<Teacher> docentesAImprimir)
    {
        byte[]? logoBytes = null;
        if (!string.IsNullOrEmpty(configuracionEscuela.LogoBase64))
        {
            try
            {
                var base64Logo = configuracionEscuela.LogoBase64.Contains(',', StringComparison.Ordinal) 
                    ? configuracionEscuela.LogoBase64.Substring(configuracionEscuela.LogoBase64.IndexOf(',', StringComparison.Ordinal) + 1) 
                    : configuracionEscuela.LogoBase64;
                logoBytes = Convert.FromBase64String(base64Logo);
            }
            catch { }
        }

        return Document.Create(container =>
        {
            container.Page(page =>
            {
                page.Size(QuestPDF.Helpers.PageSizes.Letter);
                page.Margin(1, QuestPDF.Infrastructure.Unit.Centimetre);
                page.PageColor(QuestPDF.Helpers.Colors.White);
                page.DefaultTextStyle(x => x.FontSize(10).FontFamily("Arial"));

                page.Content().Inlined(inlined =>
                {
                    inlined.Spacing(5, QuestPDF.Infrastructure.Unit.Millimetre);

                    foreach (var docente in docentesAImprimir)
                    {
                        byte[]? fotoBytes = null;
                        if (!string.IsNullOrEmpty(docente.FotoBase64))
                        {
                            try
                            {
                                var base64Foto = docente.FotoBase64.Contains(',', StringComparison.Ordinal) 
                                    ? docente.FotoBase64.Substring(docente.FotoBase64.IndexOf(',', StringComparison.Ordinal) + 1) 
                                    : docente.FotoBase64;
                                fotoBytes = Convert.FromBase64String(base64Foto);
                            }
                            catch { }
                        }

                        inlined.Item().Row(credencialCompleta => 
                        {
                            // =====================================
                            // ANVERSO (FRENTE) VERTICAL 5.4 x 8.6 cm
                            // =====================================
                            credencialCompleta.ConstantItem(5.4f, QuestPDF.Infrastructure.Unit.Centimetre)
                                .Height(8.6f, QuestPDF.Infrastructure.Unit.Centimetre)
                                .Border(1).BorderColor(QuestPDF.Helpers.Colors.Grey.Lighten2)
                                .Column(col =>
                                {
                                    // Encabezado
                                    col.Item().Background("#003366").Height(1.5f, QuestPDF.Infrastructure.Unit.Centimetre).Row(row =>
                                    {
                                        if (logoBytes != null)
                                        {
                                            row.ConstantItem(1.2f, QuestPDF.Infrastructure.Unit.Centimetre).Padding(2).Image(logoBytes);
                                        }
                                        row.RelativeItem().PaddingTop(5).Column(c =>
                                        {
                                            c.Item().Text("UPASER").Bold().FontColor(QuestPDF.Helpers.Colors.White).FontSize(11).AlignCenter();
                                            c.Item().Text("DOCENTE").SemiBold().FontColor(QuestPDF.Helpers.Colors.Yellow.Lighten2).FontSize(7).AlignCenter();
                                        });
                                    });

                                    // Foto
                                    col.Item().PaddingTop(5).AlignCenter().Container().Width(2.5f, QuestPDF.Infrastructure.Unit.Centimetre).Height(3f, QuestPDF.Infrastructure.Unit.Centimetre).Background(QuestPDF.Helpers.Colors.Grey.Lighten3).AlignCenter().AlignMiddle().Element(e => 
                                    {
                                        if (fotoBytes != null)
                                        {
                                            e.Image(fotoBytes).FitArea();
                                        }
                                        else
                                        {
                                            e.Text("Sin Foto").FontSize(8).FontColor(QuestPDF.Helpers.Colors.Grey.Darken1);
                                        }
                                    });

                                    // Textos: Nombre y Especialidad
                                    col.Item().PaddingTop(5).PaddingHorizontal(5).Column(c =>
                                    {
                                        c.Item().Text(docente.NombreCompleto.ToUpperInvariant()).Bold().FontSize(8).AlignCenter().FontColor(QuestPDF.Helpers.Colors.Grey.Darken4);
                                        c.Item().PaddingTop(2).Text(docente.EspecialidadCarrera).FontSize(6).AlignCenter().FontColor(QuestPDF.Helpers.Colors.Blue.Darken2);
                                    });

                                    // Empujar el ID hasta abajo
                                    col.Item().ExtendVertical();

                                    // Pie de Identificación (ID)
                                    col.Item().Background(QuestPDF.Helpers.Colors.Grey.Lighten4)
                                        .Height(0.7f, QuestPDF.Infrastructure.Unit.Centimetre).AlignCenter().AlignMiddle()
                                        .Text($"ID: {docente.Id.Substring(0, 8).ToUpperInvariant()}")
                                        .FontSize(6).FontColor(QuestPDF.Helpers.Colors.Grey.Darken3);
                                });

                            // Espacio entre anverso y reverso
                            credencialCompleta.ConstantItem(2, QuestPDF.Infrastructure.Unit.Millimetre);

                            // =====================================
                            // REVERSO (ATRÁS) VERTICAL 5.4 x 8.6 cm
                            // =====================================
                            credencialCompleta.ConstantItem(5.4f, QuestPDF.Infrastructure.Unit.Centimetre)
                                .Height(8.6f, QuestPDF.Infrastructure.Unit.Centimetre)
                                .Border(1).BorderColor(QuestPDF.Helpers.Colors.Grey.Lighten2)
                                .Layers(layers =>
                                {
                                    // Marca de agua
                                    if (logoBytes != null)
                                    {
                                        layers.PrimaryLayer().AlignCenter().AlignMiddle().Width(3.0f, QuestPDF.Infrastructure.Unit.Centimetre).Image(logoBytes);
                                    }
                                    
                                    layers.Layer().Column(col =>
                                    {
                                        // Encabezado
                                        col.Item().Background("#003366").Height(1.5f, QuestPDF.Infrastructure.Unit.Centimetre).Row(row =>
                                        {
                                            if (logoBytes != null)
                                            {
                                                row.ConstantItem(1.2f, QuestPDF.Infrastructure.Unit.Centimetre).Padding(2).Image(logoBytes);
                                            }
                                            row.RelativeItem().PaddingTop(5).Column(c =>
                                            {
                                                c.Item().Text("UPASER").Bold().FontColor(QuestPDF.Helpers.Colors.White).FontSize(11).AlignCenter();
                                                c.Item().Text("DOCENTE").SemiBold().FontColor(QuestPDF.Helpers.Colors.Yellow.Lighten2).FontSize(7).AlignCenter();
                                            });
                                        });

                                        // Empujar firma y vigencia hacia abajo
                                        col.Item().ExtendVertical();

                                        // Firma del director
                                        col.Item().PaddingHorizontal(5).PaddingBottom(4).Column(c =>
                                        {
                                            c.Item().LineHorizontal(0.5f).LineColor(QuestPDF.Helpers.Colors.Black);
                                            c.Item().PaddingTop(2).Text(directorInput).Bold().FontSize(5.5f).AlignCenter().FontColor(QuestPDF.Helpers.Colors.Black);
                                            c.Item().Text("DIRECTOR DEL PLANTEL").FontSize(4.5f).AlignCenter().FontColor(QuestPDF.Helpers.Colors.Black);
                                        });

                                        // Pie de página (Vigencia)
                                        col.Item().Background(QuestPDF.Helpers.Colors.Grey.Lighten4)
                                            .Height(0.7f, QuestPDF.Infrastructure.Unit.Centimetre).AlignCenter().AlignMiddle()
                                            .Text($"VIGENCIA: {vigenciaInput}")
                                            .FontSize(6).Bold().FontColor(QuestPDF.Helpers.Colors.Grey.Darken3);
                                    });
                                });
                        });
                    }
                });
            });
        }).GeneratePdf();
    }

    private async Task DescargarPdf(byte[] bytes, string fileName)
    {
        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JSRuntime.InvokeVoidAsync("descargarArchivoPdf", fileName, streamRef);
    }
}
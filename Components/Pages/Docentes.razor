@code {
    private Teacher nuevoDocente = new();
    private List<Teacher> listaDocentes = new();
    private ConfiguracionEscuela configuracionEscuela = new();
    private CredencialDiseno disenoDocente = new();
    
    private MudMessageBox mbox = default!;
    private bool isCameraOpen = false;
    private bool isLoading = true;
    private bool guardando = false;

    private string searchStringLote = "";
    private bool generandoPdfLote = false;
    private HashSet<Teacher> docentesSeleccionados = new();

    private string vigenciaInput = "2026 - 2027";
    private string directorInput = "MTRO. JOVANY IVAN CERVANTES CARRERAS";

    private IEnumerable<Teacher> DocentesFiltradosLote => listaDocentes.Where(x => 
        (string.IsNullOrEmpty(searchStringLote) || $"{(x.NombreCompleto ?? "")}".Contains(searchStringLote, StringComparison.OrdinalIgnoreCase)));

    private string Px(float mm) => $"{(mm * 3.78f).ToString("0.##", CultureInfo.InvariantCulture)}px";

    protected override async Task OnInitializedAsync()
    {
        QuestPDF.Settings.License = QuestPDF.Infrastructure.LicenseType.Community;
        configuracionEscuela = await Firebase.GetConfiguracionAsync() ?? new();

        var disenoGuardado = await Firebase.GetDisenoCredencialDocenteAsync();
        if (disenoGuardado != null)
        {
            disenoDocente = disenoGuardado;
        }
        else
        {
            // Valores iniciales sugeridos para credencial vertical (54 x 86 mm)
            disenoDocente = new CredencialDiseno
            {
                FotoX = 14.5f,
                FotoY = 18.0f,
                FotoW = 25.0f,
                FotoH = 30.0f,
                NombreX = 2.0f,
                NombreY = 51.0f,
                MatriculaX = 2.0f,
                MatriculaY = 76.0f,
                FirmaLineaX = 7.0f,
                FirmaLineaY = 62.0f,
                FirmaLineaW = 40.0f
            };
        }

        await CargarDirectorio();
    }

    private async Task CargarDirectorio()
    {
        isLoading = true;
        StateHasChanged();
        listaDocentes = await Firebase.GetAllTeachersAsync();
        isLoading = false;
        StateHasChanged();
    }

    private async Task GuardarDocente()
    {
        if (string.IsNullOrWhiteSpace(nuevoDocente.NombreCompleto) || string.IsNullOrWhiteSpace(nuevoDocente.EspecialidadCarrera))
        {
            Snackbar.Add("El nombre completo y la especialidad son obligatorios.", Severity.Warning);
            return;
        }

        guardando = true;
        StateHasChanged();

        try
        {
            await Firebase.AddTeacherAsync(nuevoDocente);
            Snackbar.Add("Expediente del docente guardado con éxito.", Severity.Success);
            LimpiarFormulario();
            await CargarDirectorio();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar: {ex.Message}", Severity.Error);
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    private void EditarDocente(Teacher docente)
    {
        nuevoDocente = new Teacher
        {
            Id = docente.Id,
            NumeroEmpleado = docente.NumeroEmpleado,
            NombreCompleto = docente.NombreCompleto,
            Calle = docente.Calle,
            NumeroExterior = docente.NumeroExterior,
            NumeroInterior = docente.NumeroInterior,
            Colonia = docente.Colonia,
            Municipio = docente.Municipio,
            CodigoPostal = docente.CodigoPostal,
            UniversidadEgreso = docente.UniversidadEgreso,
            Telefono = docente.Telefono,
            CorreoElectronico = docente.CorreoElectronico,
            EspecialidadCarrera = docente.EspecialidadCarrera,
            FotoBase64 = docente.FotoBase64,
            Activo = docente.Activo,
            FechaRegistro = docente.FechaRegistro
        };
        Snackbar.Add("Modifica los datos y presiona Guardar Expediente.", Severity.Info);
    }

    private async Task EliminarDocente(Teacher docente)
    {
        if (await mbox.ShowAsync() == true)
        {
            try
            {
                await Firebase.DeleteTeacherAsync(docente.Id);
                Snackbar.Add("Expediente eliminado.", Severity.Success);
                await CargarDirectorio();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
        }
    }

    private void LimpiarFormulario()
    {
        nuevoDocente = new Teacher();
        isCameraOpen = false;
        StateHasChanged();
    }

    private async Task AbrirCamara()
    {
        isCameraOpen = true;
        StateHasChanged();
        await Task.Delay(100); 
        await JSRuntime.InvokeVoidAsync("cameraHelper.startCamera", "cameraVideo");
    }

    private async Task CapturarFoto()
    {
        try
        {
            var base64 = await JSRuntime.InvokeAsync<string>("cameraHelper.takeSnapshot", "cameraVideo");
            nuevoDocente.FotoBase64 = base64;
            await CerrarCamara();
            Snackbar.Add("Fotografía capturada.", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Error al tomar la foto.", Severity.Error);
            await CerrarCamara();
        }
    }

    private async Task CerrarCamara()
    {
        await JSRuntime.InvokeVoidAsync("cameraHelper.stopCamera");
        isCameraOpen = false;
        StateHasChanged();
    }

    private async Task UploadPhoto(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            var buffer = memoryStream.ToArray();
            nuevoDocente.FotoBase64 = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
        }
    }

    // --- MÉTODOS PESTAÑA 3 (CONFIGURAR PLANTILLA DOCENTE) ---
    private async Task SubirFrenteDocente(InputFileChangeEventArgs e)
    {
        if (e.File == null) return;
        disenoDocente.PlantillaFrenteBase64 = await ConvertToBase64(e.File);
        Snackbar.Add("Plantilla del anverso cargada. Presiona 'Guardar Diseño' para conservarla.", Severity.Info);
        StateHasChanged();
    }

    private async Task SubirReversoDocente(InputFileChangeEventArgs e)
    {
        if (e.File == null) return;
        disenoDocente.PlantillaReversoBase64 = await ConvertToBase64(e.File);
        Snackbar.Add("Plantilla del reverso cargada. Presiona 'Guardar Diseño' para conservarla.", Severity.Info);
        StateHasChanged();
    }

    private async Task<string> ConvertToBase64(IBrowserFile file)
    {
        using var ms = new MemoryStream();
        await file.OpenReadStream(1024 * 1024 * 5).CopyToAsync(ms);
        return $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
    }

    private async Task GuardarDisenoDocente()
    {
        try
        {
            await Firebase.SaveDisenoCredencialDocenteAsync(disenoDocente);
            Snackbar.Add("Diseño de plantilla docente guardado exitosamente.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar el diseño: {ex.Message}", Severity.Error);
        }
    }
    
    // --- GENERACIÓN DE CREDENCIALES ---
    private async Task GenerarCredencialIndividual(Teacher docente)
    {
        try
        {
            Snackbar.Add("Preparando diseño de credencial...", Severity.Info);
            var pdfBytes = CrearPdfCredencialesDocentes(new List<Teacher> { docente });
            await DescargarPdf(pdfBytes, $"Credencial_{docente.NombreCompleto}.pdf");
            Snackbar.Add("Credencial descargada correctamente.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al generar credencial: {ex.Message}", Severity.Error);
        }
    }

    private async Task GenerarPDFLote()
    {
        if (!docentesSeleccionados.Any()) return;

        try
        {
            generandoPdfLote = true;
            StateHasChanged();
            await Task.Delay(100); 

            var pdfBytes = CrearPdfCredencialesDocentes(docentesSeleccionados.ToList());
            
            using var stream = new MemoryStream(pdfBytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JSRuntime.InvokeVoidAsync("downloadFileFromStream", $"Lote_Credenciales_Docentes_{DateTime.Now:yyyyMMdd_HHmm}.pdf", streamRef);
            
            Snackbar.Add($"¡{docentesSeleccionados.Count} credenciales de docente generadas exitosamente!", Severity.Success);
            docentesSeleccionados.Clear();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al generar las credenciales: {ex.Message}", Severity.Error);
        }
        finally
        {
            generandoPdfLote = false;
            StateHasChanged();
        }
    }

    private static byte[]? ExtraerBytesBase64(string? base64String)
    {
        if (string.IsNullOrEmpty(base64String)) return null;
        try
        {
            var data = base64String.Contains(',', StringComparison.Ordinal)
                ? base64String.Substring(base64String.IndexOf(',', StringComparison.Ordinal) + 1)
                : base64String;
            return Convert.FromBase64String(data);
        }
        catch
        {
            return null;
        }
    }

    private byte[] CrearPdfCredencialesDocentes(List<Teacher> docentesAImprimir)
    {
        byte[]? logoBytes = ExtraerBytesBase64(configuracionEscuela.LogoBase64);
        byte[]? plantillaFrenteBytes = ExtraerBytesBase64(disenoDocente.PlantillaFrenteBase64);
        byte[]? plantillaReversoBytes = ExtraerBytesBase64(disenoDocente.PlantillaReversoBase64);

        return Document.Create(container =>
        {
            container.Page(page =>
            {
                page.Size(QuestPDF.Helpers.PageSizes.Letter);
                page.Margin(1, QuestPDF.Infrastructure.Unit.Centimetre);
                page.PageColor(QuestPDF.Helpers.Colors.White);
                page.DefaultTextStyle(x => x.FontSize(10).FontFamily("Arial"));

                page.Content().Inlined(inlined =>
                {
                    inlined.Spacing(5, QuestPDF.Infrastructure.Unit.Millimetre);

                    foreach (var docente in docentesAImprimir)
                    {
                        byte[]? fotoBytes = ExtraerBytesBase64(docente.FotoBase64);
                        var numeroMostrar = !string.IsNullOrWhiteSpace(docente.NumeroEmpleado)
                            ? docente.NumeroEmpleado.Trim().ToUpperInvariant()
                            : (!string.IsNullOrEmpty(docente.Id) && docente.Id.Length >= 8
                                ? docente.Id.Substring(0, 8).ToUpperInvariant()
                                : (docente.Id ?? "S/N").ToUpperInvariant());

                        inlined.Item().Row(credencialCompleta => 
                        {
                            // =====================================
                            // ANVERSO (FRENTE) VERTICAL 54 x 86 mm
                            // =====================================
                            credencialCompleta.ConstantItem(54, QuestPDF.Infrastructure.Unit.Millimetre)
                                .Height(86, QuestPDF.Infrastructure.Unit.Millimetre)
                                .Border(1).BorderColor(QuestPDF.Helpers.Colors.Grey.Lighten2)
                                .Element(anverso =>
                                {
                                    if (plantillaFrenteBytes != null)
                                    {
                                        // MODO PLANTILLA PERSONALIZADA CALIBRADA
                                        anverso.Layers(layers =>
                                        {
                                            layers.PrimaryLayer().Image(plantillaFrenteBytes).FitArea();

                                            if (fotoBytes != null)
                                            {
                                                layers.Layer()
                                                    .PaddingLeft(disenoDocente.FotoX, QuestPDF.Infrastructure.Unit.Millimetre)
                                                    .PaddingTop(disenoDocente.FotoY, QuestPDF.Infrastructure.Unit.Millimetre)
                                                    .Width(disenoDocente.FotoW, QuestPDF.Infrastructure.Unit.Millimetre)
                                                    .Height(disenoDocente.FotoH, QuestPDF.Infrastructure.Unit.Millimetre)
                                                    .Image(fotoBytes).FitArea();
                                            }

                                            layers.Layer()
                                                .PaddingLeft(disenoDocente.NombreX, QuestPDF.Infrastructure.Unit.Millimetre)
                                                .PaddingRight(2, QuestPDF.Infrastructure.Unit.Millimetre)
                                                .PaddingTop(disenoDocente.NombreY, QuestPDF.Infrastructure.Unit.Millimetre)
                                                .Column(c =>
                                                {
                                                    c.Item().Text(docente.NombreCompleto.ToUpperInvariant()).Bold().FontSize(7.5f).AlignCenter().FontColor(QuestPDF.Helpers.Colors.Black);
                                                    c.Item().PaddingTop(1).Text(docente.EspecialidadCarrera).FontSize(6).AlignCenter().FontColor(QuestPDF.Helpers.Colors.Blue.Darken2);
                                                });

                                            layers.Layer()
                                                .PaddingLeft(disenoDocente.MatriculaX, QuestPDF.Infrastructure.Unit.Millimetre)
                                                .PaddingRight(2, QuestPDF.Infrastructure.Unit.Millimetre)
                                                .PaddingTop(disenoDocente.MatriculaY, QuestPDF.Infrastructure.Unit.Millimetre)
                                                .AlignCenter()
                                                .Text($"NO. EMPLEADO: {numeroMostrar}")
                                                .FontSize(6).Bold().FontColor(QuestPDF.Helpers.Colors.Grey.Darken3);
                                        });
                                    }
                                    else
                                    {
                                        // MODO PREDETERMINADO CON LAYERS (ALIGN TOP / ALIGN BOTTOM)
                                        anverso.Layers(layers =>
                                        {
                                            layers.PrimaryLayer().Background(QuestPDF.Helpers.Colors.White);

                                            // Capa superior: Encabezado + Foto + Nombre y Especialidad
                                            layers.Layer().AlignTop().Column(col =>
                                            {
                                                col.Item().Background("#003366").Height(15, QuestPDF.Infrastructure.Unit.Millimetre).Row(row =>
                                                {
                                                    if (logoBytes != null)
                                                    {
                                                        row.ConstantItem(12, QuestPDF.Infrastructure.Unit.Millimetre).Padding(2).Image(logoBytes);
                                                    }
                                                    row.RelativeItem().PaddingTop(5).Column(c =>
                                                    {
                                                        c.Item().Text("UPASER").Bold().FontColor(QuestPDF.Helpers.Colors.White).FontSize(11).AlignCenter();
                                                        c.Item().Text("DOCENTE").SemiBold().FontColor(QuestPDF.Helpers.Colors.Yellow.Lighten2).FontSize(7).AlignCenter();
                                                    });
                                                });

                                                col.Item().PaddingTop(5).AlignCenter().Container()
                                                    .Width(25, QuestPDF.Infrastructure.Unit.Millimetre)
                                                    .Height(30, QuestPDF.Infrastructure.Unit.Millimetre)
                                                    .Background(QuestPDF.Helpers.Colors.Grey.Lighten3)
                                                    .AlignCenter().AlignMiddle().Element(e => 
                                                    {
                                                        if (fotoBytes != null) e.Image(fotoBytes).FitArea();
                                                        else e.Text("Sin Foto").FontSize(8).FontColor(QuestPDF.Helpers.Colors.Grey.Darken1);
                                                    });

                                                col.Item().PaddingTop(5).PaddingHorizontal(4).Column(c =>
                                                {
                                                    c.Item().Text(docente.NombreCompleto.ToUpperInvariant()).Bold().FontSize(7.5f).AlignCenter().FontColor(QuestPDF.Helpers.Colors.Grey.Darken4);
                                                    c.Item().PaddingTop(2).Text(docente.EspecialidadCarrera).FontSize(6).AlignCenter().FontColor(QuestPDF.Helpers.Colors.Blue.Darken2);
                                                });
                                            });

                                            // Capa inferior: Número de Empleado anclado estrictamente al borde inferior
                                            layers.Layer().AlignBottom()
                                                .Background(QuestPDF.Helpers.Colors.Grey.Lighten4)
                                                .Height(7, QuestPDF.Infrastructure.Unit.Millimetre)
                                                .AlignCenter().AlignMiddle()
                                                .Text($"NO. EMPLEADO: {numeroMostrar}")
                                                .FontSize(6).Bold().FontColor(QuestPDF.Helpers.Colors.Grey.Darken3);
                                        });
                                    }
                                });

                            // Espacio entre anverso y reverso
                            credencialCompleta.ConstantItem(2, QuestPDF.Infrastructure.Unit.Millimetre);

                            // =====================================
                            // REVERSO (ATRÁS) VERTICAL 54 x 86 mm
                            // =====================================
                            credencialCompleta.ConstantItem(54, QuestPDF.Infrastructure.Unit.Millimetre)
                                .Height(86, QuestPDF.Infrastructure.Unit.Millimetre)
                                .Border(1).BorderColor(QuestPDF.Helpers.Colors.Grey.Lighten2)
                                .Element(reverso =>
                                {
                                    if (plantillaReversoBytes != null)
                                    {
                                        // MODO PLANTILLA PERSONALIZADA CALIBRADA
                                        reverso.Layers(layers =>
                                        {
                                            layers.PrimaryLayer().Image(plantillaReversoBytes).FitArea();

                                            layers.Layer()
                                                .PaddingLeft(disenoDocente.FirmaLineaX, QuestPDF.Infrastructure.Unit.Millimetre)
                                                .PaddingTop(disenoDocente.FirmaLineaY, QuestPDF.Infrastructure.Unit.Millimetre)
                                                .Width(disenoDocente.FirmaLineaW, QuestPDF.Infrastructure.Unit.Millimetre)
                                                .Height(0.5f, QuestPDF.Infrastructure.Unit.Millimetre)
                                                .Background(QuestPDF.Helpers.Colors.Black);

                                            layers.Layer()
                                                .PaddingLeft(disenoDocente.FirmaLineaX, QuestPDF.Infrastructure.Unit.Millimetre)
                                                .PaddingTop(disenoDocente.FirmaLineaY + 1, QuestPDF.Infrastructure.Unit.Millimetre)
                                                .Width(disenoDocente.FirmaLineaW, QuestPDF.Infrastructure.Unit.Millimetre)
                                                .Column(c =>
                                                {
                                                    c.Item().AlignCenter().Text(directorInput).FontSize(5.5f).Bold().FontColor(QuestPDF.Helpers.Colors.Black);
                                                    c.Item().AlignCenter().Text("DIRECTOR DEL PLANTEL").FontSize(4.5f).FontColor(QuestPDF.Helpers.Colors.Black);
                                                    c.Item().PaddingTop(3).AlignCenter().Text($"VIGENCIA: {vigenciaInput}").FontSize(5.5f).Bold().FontColor(QuestPDF.Helpers.Colors.Grey.Darken3);
                                                });
                                        });
                                    }
                                    else
                                    {
                                        // MODO PREDETERMINADO CON LAYERS (ALIGN TOP / ALIGN BOTTOM)
                                        reverso.Layers(layers =>
                                        {
                                            // Capa base: Fondo blanco + Logo centrado en la zona libre
                                            layers.PrimaryLayer().Background(QuestPDF.Helpers.Colors.White)
                                                .PaddingTop(16, QuestPDF.Infrastructure.Unit.Millimetre)
                                                .PaddingBottom(24, QuestPDF.Infrastructure.Unit.Millimetre)
                                                .AlignCenter().AlignMiddle().Element(e =>
                                                {
                                                    if (logoBytes != null)
                                                    {
                                                        e.Width(24, QuestPDF.Infrastructure.Unit.Millimetre).Image(logoBytes);
                                                    }
                                                });

                                            // Capa superior: Encabezado Azul
                                            layers.Layer().AlignTop().Background("#003366").Height(15, QuestPDF.Infrastructure.Unit.Millimetre).Row(row =>
                                            {
                                                if (logoBytes != null)
                                                {
                                                    row.ConstantItem(12, QuestPDF.Infrastructure.Unit.Millimetre).Padding(2).Image(logoBytes);
                                                }
                                                row.RelativeItem().PaddingTop(5).Column(c =>
                                                {
                                                    c.Item().Text("UPASER").Bold().FontColor(QuestPDF.Helpers.Colors.White).FontSize(11).AlignCenter();
                                                    c.Item().Text("DOCENTE").SemiBold().FontColor(QuestPDF.Helpers.Colors.Yellow.Lighten2).FontSize(7).AlignCenter();
                                                });
                                            });

                                            // Capa inferior: Firma + Leyenda + Vigencia anclados al borde inferior
                                            layers.Layer().AlignBottom().Column(col =>
                                            {
                                                col.Item().PaddingHorizontal(5).PaddingBottom(3).Column(c =>
                                                {
                                                    c.Item().LineHorizontal(0.5f).LineColor(QuestPDF.Helpers.Colors.Black);
                                                    c.Item().PaddingTop(2).Text(directorInput).Bold().FontSize(5.5f).AlignCenter().FontColor(QuestPDF.Helpers.Colors.Black);
                                                    c.Item().Text("DIRECTOR DEL PLANTEL").FontSize(4.5f).AlignCenter().FontColor(QuestPDF.Helpers.Colors.Black);
                                                });

                                                col.Item().PaddingBottom(2).PaddingHorizontal(3)
                                                    .Text("Esta credencial es personal e intransferible y debe ser portada obligatoriamente.")
                                                    .FontSize(3.8f).FontColor(QuestPDF.Helpers.Colors.Grey.Darken3).AlignCenter();

                                                col.Item().Background(QuestPDF.Helpers.Colors.Grey.Lighten4)
                                                    .Height(7, QuestPDF.Infrastructure.Unit.Millimetre)
                                                    .AlignCenter().AlignMiddle()
                                                    .Text($"VIGENCIA: {vigenciaInput}")
                                                    .FontSize(6).Bold().FontColor(QuestPDF.Helpers.Colors.Grey.Darken3);
                                            });
                                        });
                                    }
                                });
                        });
                    }
                });
            });
        }).GeneratePdf();
    }

    private async Task DescargarPdf(byte[] bytes, string fileName)
    {
        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JSRuntime.InvokeVoidAsync("descargarArchivoPdf", fileName, streamRef);
    }
}
@page "/configuracion"
@rendermode RenderMode.InteractiveServer
@using MudBlazor
@using System.IO
@using EscuelaManagement.Data.Models
@using EscuelaManagement.Data.Services
@inject FirebaseService Firebase
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-6 pb-12">
    
    <!-- ENCABEZADO -->
    <div class="mb-8">
        <MudText Typo="Typo.h4" Class="font-weight-bold mb-1">Opciones Administrativas</MudText>
        <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">Configuración global del sistema, diseño de reportes y control de accesos.</MudText>
    </div>

    <!-- TABS MODERNOS SIN FONDO PESADO -->
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="false" Color="Color.Primary" PanelClass="pt-6 fade-in-suave">
        
        @* ========================================== *@
        @* PESTAÑA 1: IDENTIDAD ESCOLAR               *@
        @* ========================================== *@
        <MudTabPanel Text="Identidad Escolar" Icon="@Icons.Material.Filled.Business">
            <MudGrid>
                
                @* --- 1. NOMBRE DE LA INSTITUCIÓN --- *@
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="pa-6 rounded-xl" Style="border: 1px solid var(--mud-palette-lines-default);">
                        <MudText Typo="Typo.h6" Class="font-weight-bold mb-4" Color="Color.Primary">Información Institucional</MudText>
                        <MudTextField @bind-Value="config.NombreEscuela" 
                                      Label="Nombre de la Institución Educativa" 
                                      Variant="Variant.Outlined" 
                                      Required="true"
                                      Class="modern-input" />
                    </MudPaper>
                </MudItem>

                @* --- 2. LOGOTIPO OFICIAL --- *@
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-6 rounded-xl modern-card d-flex flex-column align-center justify-center text-center h-100" Style="border: 1px solid var(--mud-palette-lines-default);">
                        <MudText Typo="Typo.h6" Class="font-weight-bold mb-4">Logotipo Oficial</MudText>
                        
                        @if (!string.IsNullOrEmpty(config.LogoBase64))
                        {
                            <MudImage Src="@config.LogoBase64" Width="180" Height="180" ObjectFit="ObjectFit.Contain" Elevation="0" Class="rounded-lg mb-4 pa-2" Style="border: 1px dashed var(--mud-palette-lines-default);" />
                        }
                        else
                        {
                            <MudPaper Elevation="0" Width="180px" Height="180px" Class="d-flex align-center justify-center rounded-lg mb-4" Style="background-color: var(--mud-palette-background-grey); border: 1px dashed var(--mud-palette-lines-default);">
                                <MudIcon Icon="@Icons.Material.Filled.Image" Style="font-size: 4rem; color: var(--mud-palette-text-secondary);" />
                            </MudPaper>
                        }

                        <MudButton HtmlTag="label" for="logoInput" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PhotoCamera" Class="rounded-lg font-weight-bold" Style="text-transform: none;">
                            Subir Logotipo
                        </MudButton>
                        <InputFile id="logoInput" OnChange="CambiarLogo" accept=".jpg,.jpeg,.png" style="display: none;" />
                        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);" Class="mt-2">Formatos sugeridos: PNG o JPG transparentes.</MudText>
                    </MudPaper>
                </MudItem>

                @* --- 3. FONDO DE PANTALLA LOGIN --- *@
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-6 rounded-xl modern-card d-flex flex-column align-center justify-center text-center h-100" Style="border: 1px solid var(--mud-palette-lines-default);">
                        <MudText Typo="Typo.h6" Class="font-weight-bold mb-4">Fondo de Pantalla (Login)</MudText>
                        
                        @if (!string.IsNullOrEmpty(config.BackgroundLoginBase64))
                        {
                            <MudImage Src="@config.BackgroundLoginBase64" Width="280" Height="160" ObjectFit="ObjectFit.Cover" Elevation="0" Class="rounded-lg mb-4" Style="border: 1px solid var(--mud-palette-lines-default);" />
                        }
                        else
                        {
                            <MudPaper Elevation="0" Width="280px" Height="160px" Class="d-flex align-center justify-center rounded-lg mb-4" Style="background-color: var(--mud-palette-background-grey); border: 1px dashed var(--mud-palette-lines-default);">
                                <MudIcon Icon="@Icons.Material.Filled.Wallpaper" Style="font-size: 4rem; color: var(--mud-palette-text-secondary);" />
                            </MudPaper>
                        }

                        <MudButton HtmlTag="label" for="bgInput" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PhotoCamera" Class="rounded-lg font-weight-bold" Style="text-transform: none;">
                            Subir Imagen de Fondo
                        </MudButton>
                        <InputFile id="bgInput" OnChange="UploadBackground" accept=".jpg,.jpeg,.png" style="display: none;" />
                        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);" Class="mt-2">Formatos sugeridos: JPG o PNG de alta resolución.</MudText>
                    </MudPaper>
                </MudItem>

                @* --- 4. BOTÓN DE GUARDAR AL FINAL --- *@
                <MudItem xs="12" Class="d-flex justify-end mt-4">
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               StartIcon="@Icons.Material.Filled.Save" 
                               OnClick="GuardarAjustes"
                               Class="rounded-lg font-weight-bold px-8 py-3"
                               Style="text-transform: none;">
                        Guardar Configuración Visual
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        @* ========================================== *@
        @* PESTAÑA 2: USUARIOS Y ROLES                *@
        @* ========================================== *@
        <MudTabPanel Text="Usuarios y Roles" Icon="@Icons.Material.Filled.SupervisorAccount">
            <MudPaper Elevation="0" Class="pa-6 rounded-xl" Style="border: 1px solid var(--mud-palette-lines-default);">
                <div class="d-flex flex-wrap justify-space-between align-center mb-6 gap-4">
                    <MudText Typo="Typo.h6" Class="font-weight-bold" Color="Color.Primary">Personal con Acceso al Sistema</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="AbrirDialogoNuevo" Class="rounded-lg font-weight-bold px-6" Style="text-transform: none;">
                        Nuevo Usuario
                    </MudButton>
                </div>

                @if (cargandoUsuarios)
                {
                    <div class="d-flex flex-column align-center justify-center py-8 fade-in-suave">
                        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" Class="mb-4" />
                        <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">Cargando directorio de accesos...</MudText>
                    </div>
                }
                else
                {
                    <MudTable Items="@listaUsuarios" Hover="true" Elevation="0" Class="modern-table">
                        <HeaderContent>
                            <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary);">Usuario / Correo</MudTh>
                            <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary);">Nombre Completo</MudTh>
                            <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary);">Rol Asignado</MudTh>
                            <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary);">Estado</MudTh>
                            <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); text-align:right;">Acciones</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Correo">@context.Correo</MudTd>
                            <MudTd DataLabel="Nombre">
                                <MudText Typo="Typo.body1" Class="font-weight-bold">@context.Nombre</MudText>
                            </MudTd>
                            <MudTd DataLabel="Rol">
                                <MudChip T="string" Color="@(context.Rol == "Administrador" ? Color.Error : Color.Info)" Size="Size.Small" Variant="Variant.Filled" Class="font-weight-bold px-3">
                                    @context.Rol
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Estado">
                                @if(context.Activo)
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined" Class="font-weight-bold">Activo</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Outlined" Class="font-weight-bold">Inactivo</MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="Acciones" Style="text-align:right;">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" Class="mr-2" OnClick="@(() => AbrirDialogoEditar(context))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => EliminarUsuario(context))" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudTabPanel>

    </MudTabs>
</MudContainer>

<!-- ========================================== -->
<!-- DIÁLOGO PARA CREAR/EDITAR USUARIO          -->
<!-- ========================================== -->
<MudDialog @bind-Visible="dialogoVisible" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="font-weight-bold" Color="Color.Primary">
            <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-2 mb-1"/> @(editando ? "Editar Usuario" : "Registrar Nuevo Usuario")
        </MudText>
    </TitleContent>
    <DialogContent>
        <div class="pa-2">
            <MudTextField @bind-Value="usuarioActual.Nombre" Label="Nombre Completo" Required="true" Variant="Variant.Outlined" Class="mb-4 modern-input" />
            <MudTextField @bind-Value="usuarioActual.Correo" Label="Correo Electrónico" Required="true" Variant="Variant.Outlined" Class="mb-4 modern-input" InputType="InputType.Email" />
            <MudTextField @bind-Value="usuarioActual.Password" Label="Contraseña de Acceso" Required="true" Variant="Variant.Outlined" Class="mb-4 modern-input" InputType="InputType.Text" HelperText="Guarda esta contraseña; el usuario la necesitará para entrar." />
            
            <MudSelect T="string" Label="Rol Asignado" @bind-Value="usuarioActual.Rol" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Class="mb-6 modern-input">
                <MudSelectItem Value="@("Administrador")">Administrador (Acceso Total)</MudSelectItem>
                <MudSelectItem Value="@("Control Escolar")">Control Escolar (Pagos y Calificaciones)</MudSelectItem>
                <MudSelectItem Value="@("Docente")">Docente (Solo Lectura/Captura)</MudSelectItem>
            </MudSelect>

            <MudSwitch T="bool" @bind-Value="usuarioActual.Activo" Label="@(usuarioActual.Activo ? "Usuario Activo y Permitido" : "Usuario Suspendido")" Color="@(usuarioActual.Activo ? Color.Success : Color.Error)" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CerrarDialogo" Variant="Variant.Text" Class="rounded-lg font-weight-bold mr-2" Style="text-transform: none;">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GuardarUsuario" Class="rounded-lg font-weight-bold px-6" Style="text-transform: none;">Guardar Usuario</MudButton>
    </DialogActions>
</MudDialog>

<style>
    /* Efecto de tarjetas */
    .modern-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        background-color: var(--mud-palette-background-grey);
    }
    .modern-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.15) !important;
        background-color: var(--mud-palette-surface);
        border-color: var(--mud-palette-primary) !important;
    }

    /* Estilos modernos para los inputs */
    .modern-input .mud-input-outlined-border {
        border-color: var(--mud-palette-lines-default) !important;
    }
    .modern-input .mud-input {
        background-color: transparent !important;
        border-radius: 8px !important;
    }
    .modern-input .mud-input.mud-input-focused .mud-input-outlined-border {
        border-width: 2px !important;
        border-color: var(--mud-palette-primary) !important;
    }

    /* Estilos limpios para la tabla */
    .modern-table .mud-table-cell {
        border-bottom: 1px solid var(--mud-palette-lines-default) !important;
        padding: 16px 12px !important;
    }
    .modern-table .mud-table-root {
        border: none !important;
    }
</style>

@code {
    private ConfiguracionEscuela config = new();
    
    // Variables para la gestión de usuarios
    private List<Usuario> listaUsuarios = new();
    private bool cargandoUsuarios = true;
    
    // Variables para el diálogo
    private bool dialogoVisible;
    private bool editando;
    private Usuario usuarioActual = new();
    private DialogOptions dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, BackdropClick = false };

    protected override async Task OnInitializedAsync()
    {
        config = await Firebase.GetConfiguracionAsync() ?? new();
        await CargarUsuarios();
    }

    private async Task CargarUsuarios()
    {
        cargandoUsuarios = true;
        listaUsuarios = await Firebase.GetUsuariosAsync() ?? new();
        cargandoUsuarios = false;
    }

    // --- LÓGICA DE IDENTIDAD ESCOLAR CON COMPRESIÓN ---
    private async Task CambiarLogo(InputFileChangeEventArgs e)
    {
        try
        {
            var archivo = e.File;
            if (archivo != null)
            {
                var format = "image/png";
                var resizedImage = await archivo.RequestImageFileAsync(format, 500, 500);

                using var stream = resizedImage.OpenReadStream(maxAllowedSize: 1024 * 1024 * 10);
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);
                var buffer = memoryStream.ToArray();
                
                config.LogoBase64 = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al procesar el logo: {ex.Message}", Severity.Error);
        }
    }

    private async Task UploadBackground(InputFileChangeEventArgs e)
    {
        try
        {
            var archivo = e.File;
            if (archivo != null)
            {
                Snackbar.Add("Optimizando imagen, por favor espera...", Severity.Info);
                
                var format = "image/jpeg";
                var resizedImage = await archivo.RequestImageFileAsync(format, 1280, 720);
                
                using var stream = resizedImage.OpenReadStream(maxAllowedSize: 1024 * 1024 * 15); 
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);
                var buffer = memoryStream.ToArray();
                
                config.BackgroundLoginBase64 = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
                StateHasChanged();
                
                Snackbar.Add("Fondo optimizado con éxito. ¡Haz clic en GUARDAR CONFIGURACIÓN!", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar la imagen. Intenta con una diferente. ({ex.Message})", Severity.Error);
        }
    }

    private async Task GuardarAjustes()
    {
        if (string.IsNullOrWhiteSpace(config.NombreEscuela))
        {
            Snackbar.Add("El nombre de la escuela no puede estar vacío.", Severity.Error);
            return;
        }

        try
        {
            await Firebase.SaveConfiguracionAsync(config);
            Snackbar.Add("Configuración institucional guardada correctamente.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar en Firebase: Verifica que la imagen no sea excesivamente grande. ({ex.Message})", Severity.Error);
        }
    }

    // --- LÓGICA DE USUARIOS ---
    private void AbrirDialogoNuevo()
    {
        editando = false;
        usuarioActual = new Usuario { Activo = true, Rol = "Control Escolar" };
        dialogoVisible = true;
    }

    private void AbrirDialogoEditar(Usuario usr)
    {
        editando = true;
        usuarioActual = new Usuario
        {
            Id = usr.Id,
            Nombre = usr.Nombre,
            Correo = usr.Correo,
            Rol = usr.Rol,
            Password = usr.Password,
            Activo = usr.Activo
        };
        dialogoVisible = true;
    }

    private void CerrarDialogo()
    {
        dialogoVisible = false;
    }

    private async Task GuardarUsuario()
    {
        if (string.IsNullOrWhiteSpace(usuarioActual.Nombre) || string.IsNullOrWhiteSpace(usuarioActual.Correo) || string.IsNullOrWhiteSpace(usuarioActual.Password))
        {
            Snackbar.Add("Por favor completa todos los campos requeridos.", Severity.Warning);
            return;
        }

        if (editando)
        {
            await Firebase.UpdateUsuarioAsync(usuarioActual);
            Snackbar.Add("Usuario actualizado.", Severity.Success);
        }
        else
        {
            await Firebase.AddUsuarioAsync(usuarioActual);
            Snackbar.Add("Nuevo usuario creado exitosamente.", Severity.Success);
        }

        CerrarDialogo();
        await CargarUsuarios(); 
    }

    private async Task EliminarUsuario(Usuario usr)
    {
        // NOTA: Usa DialogService.ShowMessageBoxAsync que es el estándar actualizado en MudBlazor v7
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Eliminar Acceso", 
            $"¿Estás absolutamente seguro de eliminar el usuario de {usr.Nombre}? Perderá el acceso al sistema inmediatamente.", 
            yesText: "Sí, Eliminar", cancelText: "Cancelar");

        if (result == true)
        {
            await Firebase.DeleteUsuarioAsync(usr.Id);
            Snackbar.Add("Usuario eliminado del sistema.", Severity.Info);
            await CargarUsuarios();
        }
    }
}
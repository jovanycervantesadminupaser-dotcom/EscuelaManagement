@page "/configuracion"
@rendermode RenderMode.InteractiveServer
@using MudBlazor
@using System.IO
@using EscuelaManagement.Data.Models
@using EscuelaManagement.Data.Services
@inject FirebaseService Firebase
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-6 pb-12" Style="min-height: 100vh;">
    
    <!-- ENCABEZADO M3 EXPRESSIVE -->
    <div class="mb-8 d-flex align-center gap-4 fade-in-suave">
        <MudAvatar Size="Size.Large" Style="background: linear-gradient(135deg, #334155 0%, #0f172a 100%); color: white; width: 64px; height: 64px; box-shadow: 0 10px 15px -3px rgba(15,23,42,0.3);">
            <MudIcon Icon="@Icons.Material.Filled.SettingsApplications" Size="Size.Large" />
        </MudAvatar>
        <div>
            <MudText Typo="Typo.h3" Class="font-weight-bold mb-1" Style="color: var(--mud-palette-text-primary); letter-spacing: -1px;">Opciones Administrativas</MudText>
            <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">Configuración global del sistema, diseño de reportes y control de accesos.</MudText>
        </div>
    </div>

    <!-- TABS M3 EXPRESSIVE -->
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="false" PanelClass="pt-8 fade-in-suave" Style="background-color: transparent;">
        
        @* ========================================== *@
        @* PESTAÑA 1: IDENTIDAD ESCOLAR               *@
        @* ========================================== *@
        <MudTabPanel Text="Identidad Escolar" Icon="@Icons.Material.Filled.Business">
            <MudGrid>
                
                @* --- 1. NOMBRE DE LA INSTITUCIÓN --- *@
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="pa-8 rounded-xxl m3-section-card" Style="background-color: var(--mud-palette-surface);">
                        <div class="d-flex align-center mb-6">
                            <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="background-color: rgba(99,102,241,0.15); color: #6366f1;" Class="mr-3 rounded-lg">
                                <MudIcon Icon="@Icons.Material.Filled.Badge" />
                            </MudAvatar>
                            <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">Información Institucional</MudText>
                        </div>
                        <MudTextField T="string" @bind-Value="config.NombreEscuela" 
                                      Label="Nombre de la Institución Educativa" 
                                      Variant="Variant.Outlined" 
                                      Required="true"
                                      Class="modern-input" />
                    </MudPaper>
                </MudItem>

                @* --- 2. LOGOTIPO OFICIAL --- *@
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-8 rounded-xxl m3-section-card d-flex flex-column align-center justify-center text-center h-100" Style="background-color: var(--mud-palette-surface);">
                        <MudText Typo="Typo.h5" Class="font-weight-bold mb-6" Style="color: var(--mud-palette-text-primary);">Logotipo Oficial</MudText>
                        
                        @if (!string.IsNullOrEmpty(config.LogoBase64))
                        {
                            <div class="image-preview-container rounded-xl mb-6 d-flex align-center justify-center">
                                <MudImage Src="@config.LogoBase64" Width="180" Height="180" ObjectFit="ObjectFit.Contain" Elevation="0" />
                            </div>
                        }
                        else
                        {
                            <div class="image-preview-container empty-preview rounded-xl mb-6 d-flex align-center justify-center">
                                <MudIcon Icon="@Icons.Material.Filled.Image" Style="font-size: 5rem; color: var(--mud-palette-text-disabled);" />
                            </div>
                        }

                        <MudButton HtmlTag="label" for="logoInput" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PhotoCamera" Class="rounded-xl font-weight-bold px-6 py-2 hover-lift" Style="text-transform: none; border-width: 2px;">
                            Subir Logotipo
                        </MudButton>
                        <InputFile id="logoInput" OnChange="CambiarLogo" accept=".jpg,.jpeg,.png" style="display: none;" />
                        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);" Class="mt-4">Formatos sugeridos: PNG o JPG transparentes.</MudText>
                    </MudPaper>
                </MudItem>

                @* --- 3. FONDO DE PANTALLA LOGIN --- *@
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-8 rounded-xxl m3-section-card d-flex flex-column align-center justify-center text-center h-100" Style="background-color: var(--mud-palette-surface);">
                        <MudText Typo="Typo.h5" Class="font-weight-bold mb-6" Style="color: var(--mud-palette-text-primary);">Fondo de Pantalla (Login)</MudText>
                        
                        @if (!string.IsNullOrEmpty(config.BackgroundLoginBase64))
                        {
                            <div class="image-preview-container rounded-xl mb-6 d-flex align-center justify-center" style="width: 100%; max-width: 320px; height: 180px; overflow: hidden;">
                                <MudImage Src="@config.BackgroundLoginBase64" Style="width: 100%; height: 100%; object-fit: cover;" Elevation="0" />
                            </div>
                        }
                        else
                        {
                            <div class="image-preview-container empty-preview rounded-xl mb-6 d-flex align-center justify-center" style="width: 100%; max-width: 320px; height: 180px;">
                                <MudIcon Icon="@Icons.Material.Filled.Wallpaper" Style="font-size: 5rem; color: var(--mud-palette-text-disabled);" />
                            </div>
                        }

                        <MudButton HtmlTag="label" for="bgInput" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PhotoCamera" Class="rounded-xl font-weight-bold px-6 py-2 hover-lift" Style="text-transform: none; border-width: 2px;">
                            Subir Imagen de Fondo
                        </MudButton>
                        <InputFile id="bgInput" OnChange="UploadBackground" accept=".jpg,.jpeg,.png" style="display: none;" />
                        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);" Class="mt-4">Formatos sugeridos: JPG o PNG de alta resolución.</MudText>
                    </MudPaper>
                </MudItem>

                @* --- 4. BOTÓN DE GUARDAR AL FINAL --- *@
                <MudItem xs="12" Class="d-flex justify-end mt-4">
                    <MudButton T="string" Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               StartIcon="@Icons.Material.Filled.Save" 
                               OnClick="GuardarAjustes"
                               Class="rounded-xl font-weight-bold px-8 py-3 btn-vivid"
                               Style="text-transform: none; color: white;">
                        Guardar Configuración Visual
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        @* ========================================== *@
        @* PESTAÑA 2: USUARIOS Y ROLES                *@
        @* ========================================== *@
        <MudTabPanel Text="Usuarios y Roles" Icon="@Icons.Material.Filled.SupervisorAccount">
            <MudPaper Elevation="0" Class="pa-8 rounded-xxl m3-section-card" Style="background-color: var(--mud-palette-surface);">
                <div class="d-flex flex-wrap justify-space-between align-center mb-6 gap-4">
                    <div class="d-flex align-center">
                        <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="background-color: rgba(14,165,233,0.15); color: #0ea5e9;" Class="mr-3 rounded-lg">
                            <MudIcon Icon="@Icons.Material.Filled.Security" />
                        </MudAvatar>
                        <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">Personal con Acceso al Sistema</MudText>
                    </div>
                    <MudButton T="string" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="AbrirDialogoNuevo" Class="rounded-xl font-weight-bold px-6 py-2 btn-vivid" Style="text-transform: none; color: white;">
                        Nuevo Usuario
                    </MudButton>
                </div>

                @if (cargandoUsuarios)
                {
                    <div class="d-flex flex-column align-center justify-center py-12 fade-in-suave">
                        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" Class="mb-4" />
                        <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">Cargando directorio...</MudText>
                        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">Recuperando información de accesos.</MudText>
                    </div>
                }
                else
                {
                    <MudTable T="Usuario" Items="@listaUsuarios" Hover="true" Elevation="0" Class="modern-table transparent-table">
                        <HeaderContent>
                            <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); font-size: 0.75rem; border-bottom: 2px solid var(--mud-palette-lines-default);">Usuario / Correo</MudTh>
                            <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); font-size: 0.75rem; border-bottom: 2px solid var(--mud-palette-lines-default);">Nombre Completo</MudTh>
                            <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); font-size: 0.75rem; border-bottom: 2px solid var(--mud-palette-lines-default);">Rol Asignado</MudTh>
                            <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); font-size: 0.75rem; border-bottom: 2px solid var(--mud-palette-lines-default);">Estado</MudTh>
                            <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); font-size: 0.75rem; border-bottom: 2px solid var(--mud-palette-lines-default); text-align:right;">Acciones</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="usuarioRow">
                            <MudTd DataLabel="Correo" Style="color: var(--mud-palette-text-secondary);">@usuarioRow.Correo</MudTd>
                            <MudTd DataLabel="Nombre">
                                <MudText Typo="Typo.body1" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">@usuarioRow.Nombre</MudText>
                            </MudTd>
                            <MudTd DataLabel="Rol">
                                <MudChip T="string" Color="@(usuarioRow.Rol == "Administrador" ? Color.Error : Color.Info)" Size="Size.Small" Variant="Variant.Filled" Class="font-weight-bold px-4 rounded-lg shadow-sm">
                                    @usuarioRow.Rol
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Estado">
                                @if(usuarioRow.Activo)
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined" Class="font-weight-bold rounded-lg px-3" Style="border-width: 2px;">Activo</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Outlined" Class="font-weight-bold rounded-lg px-3" Style="border-width: 2px;">Inactivo</MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="Acciones" Style="text-align:right;">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" Class="mr-2 rounded-lg hover-lift" OnClick="@(() => AbrirDialogoEditar(usuarioRow))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Class="rounded-lg hover-lift" OnClick="@(() => EliminarUsuario(usuarioRow))" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudTabPanel>

    </MudTabs>
</MudContainer>

<!-- ========================================== -->
<!-- DIÁLOGO PARA CREAR/EDITAR USUARIO M3       -->
<!-- ========================================== -->
<MudDialog @bind-Visible="dialogoVisible" Options="dialogOptions" Class="m3-dialog rounded-xxl" Style="background-color: var(--mud-palette-surface);">
    <TitleContent>
        <div class="d-flex align-center pb-2" style="border-bottom: 1px solid var(--mud-palette-lines-default);">
            <MudAvatar Variant="Variant.Filled" Size="Size.Small" Style="background-color: rgba(14,165,233,0.15); color: #0ea5e9;" Class="mr-3 rounded-sm">
                <MudIcon Icon="@Icons.Material.Filled.Person" />
            </MudAvatar>
            <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">
                @(editando ? "Editar Usuario" : "Registrar Nuevo Usuario")
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="pa-4 pt-6">
            <MudTextField T="string" @bind-Value="usuarioActual.Nombre" Label="Nombre Completo" Required="true" Variant="Variant.Outlined" Class="mb-5 modern-input" />
            <MudTextField T="string" @bind-Value="usuarioActual.Correo" Label="Correo Electrónico" Required="true" Variant="Variant.Outlined" Class="mb-5 modern-input" InputType="InputType.Email" />
            <MudTextField T="string" @bind-Value="usuarioActual.Password" Label="Contraseña de Acceso" Required="true" Variant="Variant.Outlined" Class="mb-5 modern-input" InputType="InputType.Text" HelperText="Guarda esta contraseña; el usuario la necesitará para entrar." />
            
            <MudSelect T="string" Label="Rol Asignado" @bind-Value="usuarioActual.Rol" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Class="mb-6 modern-input">
                <MudSelectItem T="string" Value="@("Administrador")">Administrador (Acceso Total)</MudSelectItem>
                <MudSelectItem T="string" Value="@("Control Escolar")">Control Escolar (Pagos y Calificaciones)</MudSelectItem>
                <MudSelectItem T="string" Value="@("Docente")">Docente (Solo Lectura/Captura)</MudSelectItem>
            </MudSelect>

            <MudSwitch T="bool" @bind-Value="usuarioActual.Activo" Label="@(usuarioActual.Activo ? "Usuario Activo y Permitido" : "Usuario Suspendido")" Color="@(usuarioActual.Activo ? Color.Success : Color.Error)" />
        </div>
    </DialogContent>
    <DialogActions>
        <div class="pa-4 pt-0 w-100 d-flex justify-end gap-3">
            <MudButton T="string" OnClick="CerrarDialogo" Variant="Variant.Outlined" Class="rounded-xl font-weight-bold px-6 py-2" Style="text-transform: none; border-width: 2px;">Cancelar</MudButton>
            <MudButton T="string" Color="Color.Primary" Variant="Variant.Filled" OnClick="GuardarUsuario" Class="rounded-xl font-weight-bold px-6 py-2 btn-vivid" Style="text-transform: none; color: white;">Guardar Usuario</MudButton>
        </div>
    </DialogActions>
</MudDialog>

<style>
    /* Efecto Flotante M3 */
    .m3-section-card {
        border: 1px solid var(--mud-palette-lines-default) !important;
        box-shadow: 0 4px 20px -5px rgba(0, 0, 0, 0.05);
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }
    .m3-section-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 25px -10px rgba(0, 0, 0, 0.1);
        border-color: var(--mud-palette-primary) !important;
    }

    /* Solución 100% Nativa para Modo Oscuro en Inputs M3 */
    .modern-input .mud-input-outlined-border {
        border-color: var(--mud-palette-lines-default) !important;
        transition: all 0.3s ease-in-out;
    }
    
    /* Hacemos el fondo transparente para que herede el color de la tarjeta (claro u oscuro) */
    .modern-input .mud-input {
        background-color: transparent !important; 
        border-radius: 12px !important;
        transition: all 0.3s ease-in-out !important;
    }
    
    .modern-input .mud-input.mud-input-focused {
        background-color: var(--mud-palette-background) !important;
        transform: scale(1.01) translateY(-1px);
    }

    .modern-input .mud-input.mud-input-focused .mud-input-outlined-border {
        border-color: var(--mud-palette-primary) !important;
        border-width: 2px !important;
    }

    /* Estilos limpios para la tabla M3 */
    .transparent-table { background-color: transparent !important; }
    .modern-table .mud-table-cell {
        border-bottom: 1px solid var(--mud-palette-lines-default) !important;
        padding: 16px !important;
    }
    .modern-table .mud-table-root { border: none !important; }

    /* Estilos para Diálogos M3 */
    .m3-dialog {
        border: 1px solid var(--mud-palette-lines-default);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25) !important;
    }

    /* Botones Vívidos Adaptables al Tema */
    .hover-lift { transition: all 0.3s ease; }
    .hover-lift:hover { transform: translateY(-3px); box-shadow: 0 6px 15px var(--mud-palette-lines-default); }
    
    .btn-vivid {
        background-color: var(--mud-palette-primary) !important;
        color: white !important;
        transition: all 0.3s ease !important;
    }
    .btn-vivid:hover { 
        transform: translateY(-2px); 
        box-shadow: 0 6px 15px var(--mud-palette-lines-default) !important; 
    }

    .btn-vivid-error {
        background-color: var(--mud-palette-error) !important;
        color: white !important;
        transition: all 0.3s ease !important;
    }
    .btn-vivid-error:hover { 
        transform: translateY(-2px); 
        box-shadow: 0 6px 15px var(--mud-palette-lines-default) !important; 
    }

    /* Contenedores de Imágenes Adaptables (Usado en Configuración) */
    .image-preview-container {
        border: 2px dashed var(--mud-palette-lines-default);
        background-color: transparent;
        padding: 16px;
        transition: all 0.3s ease;
    }
    .image-preview-container.empty-preview {
        background-color: var(--mud-palette-background);
    }
</style>

@code {
    private ConfiguracionEscuela config = new();
    
    // Variables para la gestión de usuarios
    private List<Usuario> listaUsuarios = new();
    private bool cargandoUsuarios = true;
    
    // Variables para el diálogo
    private bool dialogoVisible;
    private bool editando;
    private Usuario usuarioActual = new();
    private DialogOptions dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, BackdropClick = false };

    protected override async Task OnInitializedAsync()
    {
        config = await Firebase.GetConfiguracionAsync() ?? new();
        await CargarUsuarios();
    }

    private async Task CargarUsuarios()
    {
        cargandoUsuarios = true;
        listaUsuarios = await Firebase.GetUsuariosAsync() ?? new();
        cargandoUsuarios = false;
    }

    // --- LÓGICA DE IDENTIDAD ESCOLAR CON COMPRESIÓN ---
    private async Task CambiarLogo(InputFileChangeEventArgs e)
    {
        try
        {
            var archivo = e.File;
            if (archivo != null)
            {
                var format = "image/png";
                var resizedImage = await archivo.RequestImageFileAsync(format, 500, 500);

                using var stream = resizedImage.OpenReadStream(maxAllowedSize: 1024 * 1024 * 10);
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);
                var buffer = memoryStream.ToArray();
                
                config.LogoBase64 = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al procesar el logo: {ex.Message}", Severity.Error);
        }
    }

    private async Task UploadBackground(InputFileChangeEventArgs e)
    {
        try
        {
            var archivo = e.File;
            if (archivo != null)
            {
                Snackbar.Add("Optimizando imagen, por favor espera...", Severity.Info);
                
                var format = "image/jpeg";
                var resizedImage = await archivo.RequestImageFileAsync(format, 1280, 720);
                
                using var stream = resizedImage.OpenReadStream(maxAllowedSize: 1024 * 1024 * 15); 
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);
                var buffer = memoryStream.ToArray();
                
                config.BackgroundLoginBase64 = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
                StateHasChanged();
                
                Snackbar.Add("Fondo optimizado con éxito. ¡Haz clic en GUARDAR CONFIGURACIÓN!", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar la imagen. Intenta con una diferente. ({ex.Message})", Severity.Error);
        }
    }

    private async Task GuardarAjustes()
    {
        if (string.IsNullOrWhiteSpace(config.NombreEscuela))
        {
            Snackbar.Add("El nombre de la escuela no puede estar vacío.", Severity.Error);
            return;
        }

        try
        {
            await Firebase.SaveConfiguracionAsync(config);
            Snackbar.Add("Configuración institucional guardada correctamente.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar en Firebase: Verifica que la imagen no sea excesivamente grande. ({ex.Message})", Severity.Error);
        }
    }

    // --- LÓGICA DE USUARIOS ---
    private void AbrirDialogoNuevo()
    {
        editando = false;
        usuarioActual = new Usuario { Activo = true, Rol = "Control Escolar" };
        dialogoVisible = true;
    }

    private void AbrirDialogoEditar(Usuario usr)
    {
        editando = true;
        usuarioActual = new Usuario
        {
            Id = usr.Id,
            Nombre = usr.Nombre,
            Correo = usr.Correo,
            Rol = usr.Rol,
            Password = usr.Password,
            Activo = usr.Activo
        };
        dialogoVisible = true;
    }

    private void CerrarDialogo()
    {
        dialogoVisible = false;
    }

    private async Task GuardarUsuario()
    {
        if (string.IsNullOrWhiteSpace(usuarioActual.Nombre) || string.IsNullOrWhiteSpace(usuarioActual.Correo) || string.IsNullOrWhiteSpace(usuarioActual.Password))
        {
            Snackbar.Add("Por favor completa todos los campos requeridos.", Severity.Warning);
            return;
        }

        if (editando)
        {
            await Firebase.UpdateUsuarioAsync(usuarioActual);
            Snackbar.Add("Usuario actualizado.", Severity.Success);
        }
        else
        {
            await Firebase.AddUsuarioAsync(usuarioActual);
            Snackbar.Add("Nuevo usuario creado exitosamente.", Severity.Success);
        }

        CerrarDialogo();
        await CargarUsuarios(); 
    }

    private async Task EliminarUsuario(Usuario usr)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Eliminar Acceso", 
            $"¿Estás absolutamente seguro de eliminar el usuario de {usr.Nombre}? Perderá el acceso al sistema inmediatamente.", 
            yesText: "Sí, Eliminar", cancelText: "Cancelar");

        if (result == true)
        {
            await Firebase.DeleteUsuarioAsync(usr.Id);
            Snackbar.Add("Usuario eliminado del sistema.", Severity.Info);
            await CargarUsuarios();
        }
    }
}
@page "/inicio"
@using MudBlazor
@using System.Text.Json
@using System.Globalization
@using EscuelaManagement.Data.Models
@using EscuelaManagement.Data.Services
@inject FirebaseService Firebase
@inject UserSessionService UserSession
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-6 pb-12" Style="background-color: #f8fafc; min-height: 100vh;">
    
    <!-- BANNER DE BIENVENIDA / HERO (ESTILO DEL BOCETO SGE) -->
    <div class="d-flex justify-space-between align-center mb-8 flex-wrap gap-4 fade-in-suave">
        <div>
            <MudText Typo="Typo.h3" Class="font-weight-bold" Style="color: #1e1b4b; letter-spacing: -1px;">
                ¡Hola, @(string.IsNullOrWhiteSpace(UserSession.Nombre) ? "Administrador" : UserSession.Nombre)! 👋
            </MudText>
            <MudText Typo="Typo.body1" Style="color: #64748b;" Class="mt-1">
                Bienvenido a tu panel de control central. Aquí tienes tu resumen operativo y actividades de hoy.
            </MudText>
        </div>
        
        <!-- ACCIÓN DE EDITAR PANEL -->
        <MudButton Variant="@(isEditMode ? Variant.Filled : Variant.Outlined)" 
                   Color="@(isEditMode ? Color.Success : Color.Default)" 
                   StartIcon="@(isEditMode ? Icons.Material.Filled.Save : Icons.Material.Filled.Edit)" 
                   OnClick="ToggleEditMode"
                   Class="rounded-xl font-weight-bold px-6 py-2.5" 
                   Style="text-transform: none; border-color: #cbd5e1; background: white;">
            @(isEditMode ? "Guardar Panel" : "Editar Panel")
        </MudButton>
    </div>

    <!-- ================================================= -->
    <!-- TARJETAS MÉTRICAS SUPERIORES (COLORES DEL BOCETO) -->
    <!-- ================================================= -->
    <MudGrid Class="mb-8 fade-in-suave">
        <!-- Tarjeta 1: Alumnos Activos (Verde Turquesa del Boceto) -->
        <MudItem xs="12" md="4">
            <div class="pa-6 rounded-xxl position-relative overflow-hidden" style="background: linear-gradient(135deg, #0d9488 0%, #14b8a6 100%); color: white; min-height: 150px; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 12px 25px -5px rgba(13, 148, 136, 0.3);">
                <div class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Alumnos Activos</MudText>
                    <MudIcon Icon="@Icons.Material.Filled.Group" Style="font-size: 2rem; opacity: 0.85;" />
                </div>
                <div>
                    <MudText Typo="Typo.h3" Class="font-weight-bold">1,245</MudText>
                    <MudText Typo="Typo.caption" Style="opacity: 0.9;">Matriculados en el ciclo actual</MudText>
                </div>
            </div>
        </MudItem>

        <!-- Tarjeta 2: Asistencia Diaria (Petróleo / Esmeralda con Gráfica) -->
        <MudItem xs="12" md="4">
            <div class="pa-6 rounded-xxl position-relative overflow-hidden" style="background: linear-gradient(135deg, #0f766e 0%, #0d9488 100%); color: white; min-height: 150px; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 12px 25px -5px rgba(15, 118, 110, 0.3);">
                <div class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Asistencia Diaria</MudText>
                    <MudProgressCircular Value="92" Color="Color.Warning" Size="Size.Small" Thickness="6" />
                </div>
                <div>
                    <MudText Typo="Typo.h3" Class="font-weight-bold">92%</MudText>
                    <MudText Typo="Typo.caption" Style="opacity: 0.9;">Promedio general del plantel</MudText>
                </div>
            </div>
        </MudItem>

        <!-- Tarjeta 3: Mensajes Nuevos (Coral / Salmón del Boceto) -->
        <MudItem xs="12" md="4">
            <div class="pa-6 rounded-xxl position-relative overflow-hidden" style="background: linear-gradient(135deg, #fb923c 0%, #f87171 100%); color: white; min-height: 150px; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 12px 25px -5px rgba(248, 113, 113, 0.3);">
                <div class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Mensajes Nuevos</MudText>
                    <MudChip T="string" Size="Size.Small" Style="background: rgba(255,255,255,0.3); color: white; font-weight: bold; border-radius: 8px;">14</MudChip>
                </div>
                <div>
                    <MudText Typo="Typo.h3" Class="font-weight-bold">Bandeja</MudText>
                    <MudText Typo="Typo.caption" Style="opacity: 0.9;">Avisos pendientes de tutores</MudText>
                </div>
            </div>
        </MudItem>
    </MudGrid>

    <!-- ============================================== -->
    <!-- MÓDULOS DE GESTIÓN (M3 CARDS INTERACTIVAS) -->
    <!-- ============================================== -->
    <MudText Typo="Typo.h5" Class="font-weight-bold mb-4" Style="color: #1e1b4b;">Módulos de Gestión</MudText>
    
    <MudGrid Class="mb-8 fade-in-suave">
        @foreach (var modulo in ModulosGestion.Where(m => !m.SoloAdmin || UserSession.EsControlEscolar))
        {
            <MudItem xs="12" sm="6" md="3" Style="position: relative;">
                @if (isEditMode)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small" Class="eliminar-btn" OnClick="() => RemoveCard(modulo, true)" />
                }
                <MudPaper Elevation="0" Class="pa-6 d-flex flex-column align-start rounded-xxl m3-modern-card h-100" Style="border: 1px solid #e2e8f0; background-color: #ffffff;" @onclick="() => NavigateIfNormal(modulo.Ruta)">
                    <MudAvatar Variant="Variant.Filled" Size="Size.Large" Style="@($"background-color: rgba(var(--mud-palette-{modulo.ColorBase}-rgb), 0.12); color: var(--mud-palette-{modulo.ColorBase});")" Class="mb-5 rounded-xl">
                        <MudIcon Icon="@modulo.Icono" Size="Size.Medium" />
                    </MudAvatar>
                    <MudText Typo="Typo.h6" Class="font-weight-bold mb-2" Style="color: #0f172a;">@modulo.Titulo</MudText>
                    <MudText Typo="Typo.body2" Style="color: #64748b; line-height: 1.5;">@modulo.Descripcion</MudText>
                </MudPaper>
            </MudItem>
        }
        
        <!-- BOTÓN AGREGAR MÓDULO -->
        @if (isEditMode)
        {
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Class="pa-6 d-flex flex-column align-center justify-center rounded-xxl cursor-pointer h-100 modern-add-card" @onclick="() => OpenAddDialog(true)">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Style="font-size: 3rem; color: #94a3b8;" Class="mb-2" />
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Style="color: #64748b;">Agregar Módulo</MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <!-- ============================================== -->
    <!-- ACCESOS RÁPIDOS Y ACTIVIDADES (BLOQUE INFERIOR) -->
    <!-- ============================================== -->
    <MudText Typo="Typo.h5" Class="font-weight-bold mb-4" Style="color: #1e1b4b;">Accesos Rápidos</MudText>
    
    <MudGrid Class="fade-in-suave mb-10">
        @foreach (var acceso in AccesosRapidos.Where(a => !a.SoloAdmin || UserSession.EsControlEscolar))
        {
            <MudItem xs="12" sm="6" md="4" Style="position: relative;">
                @if (isEditMode)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small" Class="eliminar-btn" OnClick="() => RemoveCard(acceso, false)" />
                }
                <MudPaper Elevation="0" Class="pa-5 rounded-xxl d-flex align-center m3-action-card h-100" Style="border: 1px solid #e2e8f0; background-color: #ffffff;" @onclick="() => NavigateIfNormal(acceso.Ruta)">
                    <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="@($"background-color: rgba(var(--mud-palette-{acceso.ColorBase}-rgb), 0.12); color: var(--mud-palette-{acceso.ColorBase});")" Class="mr-4 rounded-xl">
                        <MudIcon Icon="@acceso.Icono" Size="Size.Small" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Style="color: #0f172a;">@acceso.Titulo</MudText>
                        <MudText Typo="Typo.caption" Style="color: #64748b;">@acceso.Descripcion</MudText>
                    </div>
                </MudPaper>
            </MudItem>
        }
        
        <!-- BOTÓN AGREGAR ACCESO RÁPIDO -->
        @if (isEditMode)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="0" Class="pa-5 rounded-xxl d-flex align-center justify-center cursor-pointer h-100 modern-add-card" @onclick="() => OpenAddDialog(false)">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Style="font-size: 2rem; color: #94a3b8;" Class="mr-3" />
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Style="color: #64748b;">Agregar Acceso</MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

</MudContainer>

<!-- ============================================== -->
<!-- DIÁLOGO PARA AGREGAR TARJETAS -->
<!-- ============================================== -->
<MudDialog @bind-Visible="isAddDialogOpen" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="font-weight-bold" Color="Color.Primary">
            @(addingToModulo ? "Nuevo Módulo de Gestión" : "Nuevo Acceso Rápido")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" Class="pa-2">
            <MudTextField T="string" @bind-Value="newCard.Titulo" Label="Título" Required="true" Variant="Variant.Outlined" Class="mb-4 modern-input" />
            <MudTextField T="string" @bind-Value="newCard.Descripcion" Label="Descripción breve" Required="true" Variant="Variant.Outlined" Class="mb-4 modern-input" />
            <MudTextField T="string" @bind-Value="newCard.Ruta" Label="Ruta (Ej. /cursos, /asistencia)" Required="true" Variant="Variant.Outlined" Class="mb-4 modern-input" />
            
            <MudGrid>
                <MudItem xs="6">
                    <MudSelect T="string" @bind-Value="newCard.ColorBase" Label="Color del botón" Variant="Variant.Outlined" Class="modern-input" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="string" Value="@("primary")">Azul Institucional</MudSelectItem>
                        <MudSelectItem T="string" Value="@("success")">Verde Éxito</MudSelectItem>
                        <MudSelectItem T="string" Value="@("warning")">Naranja Alerta</MudSelectItem>
                        <MudSelectItem T="string" Value="@("error")">Rojo Peligro</MudSelectItem>
                        <MudSelectItem T="string" Value="@("info")">Celeste Info</MudSelectItem>
                        <MudSelectItem T="string" Value="@("secondary")">Secundario</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="6">
                    <MudSelect T="string" @bind-Value="newCard.Icono" Label="Seleccionar Ícono" Variant="Variant.Outlined" Class="modern-input" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var icon in availableIcons)
                        {
                            <MudSelectItem T="string" Value="@icon.Value">
                                <div class="d-flex align-center">
                                    <MudIcon Icon="@icon.Value" Size="Size.Small" Class="mr-2" />
                                    @icon.Key
                                </div>
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
            
            <MudSwitch T="bool" @bind-Value="newCard.SoloAdmin" Color="Color.Primary" Class="mt-4">
                Mostrar este botón únicamente a Administradores / Control Escolar.
            </MudSwitch>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => isAddDialogOpen = false" Variant="Variant.Text" Class="rounded-xl font-weight-bold">Cancelar</MudButton>
        <MudButton OnClick="SaveCard" Variant="Variant.Filled" Color="Color.Primary" Class="rounded-xl font-weight-bold px-6">Agregar Botón</MudButton>
    </DialogActions>
</MudDialog>

<style>
    /* Estilos Material 3 Expressive (Inspirados en el boceto SGE) */
    .rounded-xxl {
        border-radius: 28px !important;
    }
    .m3-modern-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
    }
    .m3-modern-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01) !important;
        border-color: #cbd5e1 !important;
        background-color: #ffffff;
    }
    .m3-action-card {
        transition: all 0.25s ease-in-out;
        cursor: pointer;
    }
    .m3-action-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.04) !important;
        border-color: #cbd5e1 !important;
        background-color: #ffffff;
    }
    .modern-add-card {
        border: 2px dashed #cbd5e1;
        background-color: transparent;
        transition: all 0.2s ease;
    }
    .modern-add-card:hover {
        border-color: #0d9488;
        background-color: rgba(13, 148, 136, 0.02);
    }
    .eliminar-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        z-index: 10;
        background-color: #ffffff;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }
    .eliminar-btn:hover {
        background-color: #ef4444;
        color: white !important;
    }
    .modern-input .mud-input-outlined-border { border-color: #cbd5e1 !important; }
    .modern-input .mud-input { background-color: #f8fafc !important; border-radius: 12px !important; }
    .modern-input .mud-input.mud-input-focused .mud-input-outlined-border { border-width: 2px !important; border-color: #0d9488 !important; }
</style>

@code {
    private string fechaActual = "";
    private bool isEditMode = false;
    private ConfiguracionEscuela appConfig = new();
    
    private bool isAddDialogOpen = false;
    private bool addingToModulo = true;
    private TarjetaDashboard newCard = new();
    private MudForm form = default!;
    
    private DialogOptions dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, BackdropClick = false };

    public class TarjetaDashboard
    {
        public string Titulo { get; set; } = "";
        public string Descripcion { get; set; } = "";
        public string Icono { get; set; } = "";
        public string ColorBase { get; set; } = "primary"; 
        public string Ruta { get; set; } = "";
        public bool SoloAdmin { get; set; }
    }

    private List<TarjetaDashboard> ModulosGestion = new()
    {
        new TarjetaDashboard { Titulo = "Directorio", Descripcion = "Consulta y gestión general de expedientes de alumnos.", Icono = Icons.Material.Filled.PeopleAlt, ColorBase = "primary", Ruta = "/alumnos", SoloAdmin = false },
        new TarjetaDashboard { Titulo = "Inscripciones", Descripcion = "Registra nuevos ingresos y matriculaciones al plantel.", Icono = Icons.Material.Filled.HowToReg, ColorBase = "success", Ruta = "/inscripciones", SoloAdmin = true },
        new TarjetaDashboard { Titulo = "Cursos Activos", Descripcion = "Administración de materias, grupos y profesores.", Icono = Icons.Material.Filled.MenuBook, ColorBase = "warning", Ruta = "/cursos", SoloAdmin = true },
        new TarjetaDashboard { Titulo = "Control de Pagos", Descripcion = "Ingresos, recibos y estatus financiero de los alumnos.", Icono = Icons.Material.Filled.RequestQuote, ColorBase = "error", Ruta = "/pagos", SoloAdmin = true }
    };

    private List<TarjetaDashboard> AccesosRapidos = new()
    {
        new TarjetaDashboard { Titulo = "Nueva Inscripción", Descripcion = "Ir al formulario de alta", Icono = Icons.Material.Filled.PersonAdd, ColorBase = "primary", Ruta = "/inscripciones", SoloAdmin = true },
        new TarjetaDashboard { Titulo = "Consultar Expedientes", Descripcion = "Buscar historial de alumnos", Icono = Icons.Material.Filled.FolderShared, ColorBase = "secondary", Ruta = "/alumnos", SoloAdmin = false }
    };

    private Dictionary<string, string> availableIcons = new()
    {
        { "Personas / Alumnos", Icons.Material.Filled.PeopleAlt },
        { "Inscripción / Registro", Icons.Material.Filled.HowToReg },
        { "Libros / Cursos", Icons.Material.Filled.MenuBook },
        { "Dinero / Pagos", Icons.Material.Filled.RequestQuote },
        { "Agregar Persona", Icons.Material.Filled.PersonAdd },
        { "Carpeta / Expediente", Icons.Material.Filled.FolderShared },
        { "Calendario / Asistencia", Icons.Material.Filled.CalendarMonth },
        { "Estrella / Calificaciones", Icons.Material.Filled.Star },
        { "Impresora / Reportes", Icons.Material.Filled.Print },
        { "Gráficas / Ventas", Icons.Material.Filled.BarChart },
        { "Credenciales", Icons.Material.Filled.Badge },
        { "Configuración", Icons.Material.Filled.Settings },
        { "Enlace / Web", Icons.Material.Filled.Link }
    };

    protected override async Task OnInitializedAsync()
    {
        var cultura = new CultureInfo("es-ES");
        var fecha = DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", cultura);
        if (!string.IsNullOrEmpty(fecha)) fechaActual = char.ToUpper(fecha[0]) + fecha.Substring(1);

        try
        {
            appConfig = await Firebase.GetConfiguracionAsync() ?? new();

            if (!string.IsNullOrEmpty(appConfig.ModulosDashboardJson))
            {
                ModulosGestion = JsonSerializer.Deserialize<List<TarjetaDashboard>>(appConfig.ModulosDashboardJson) ?? ModulosGestion;
            }
            
            if (!string.IsNullOrEmpty(appConfig.AccesosDashboardJson))
            {
                AccesosRapidos = JsonSerializer.Deserialize<List<TarjetaDashboard>>(appConfig.AccesosDashboardJson) ?? AccesosRapidos;
            }
        }
        catch (Exception) { }
    }

    private async Task ToggleEditMode()
    {
        if (isEditMode)
        {
            try
            {
                appConfig.ModulosDashboardJson = JsonSerializer.Serialize(ModulosGestion);
                appConfig.AccesosDashboardJson = JsonSerializer.Serialize(AccesosRapidos);
                
                await Firebase.SaveConfiguracionAsync(appConfig); 
                Snackbar.Add("Panel guardado correctamente en la base de datos.", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error al guardar en la nube: {ex.Message}", Severity.Error);
            }
        }
        
        isEditMode = !isEditMode;
    }

    private void NavigateIfNormal(string ruta)
    {
        if (!isEditMode && !string.IsNullOrEmpty(ruta))
        {
            NavigationManager.NavigateTo(ruta);
        }
    }

    private void RemoveCard(TarjetaDashboard card, bool isModulo)
    {
        if (isModulo) ModulosGestion.Remove(card);
        else AccesosRapidos.Remove(card);
    }

    private void OpenAddDialog(bool isModulo)
    {
        addingToModulo = isModulo;
        newCard = new TarjetaDashboard { ColorBase = "primary", Icono = Icons.Material.Filled.Dashboard, SoloAdmin = false };
        isAddDialogOpen = true;
    }

    private async Task SaveCard()
    {
        await form.ValidateAsync();
        if (form.IsValid)
        {
            if (addingToModulo) ModulosGestion.Add(newCard);
            else AccesosRapidos.Add(newCard);
                
            isAddDialogOpen = false;
        }
    }
}
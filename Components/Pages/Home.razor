@page "/inicio"
@using MudBlazor
@using EscuelaManagement.Data.Services
@using System.Globalization
@inject UserSessionService UserSession
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-6 pb-12">
    
    <!-- BANNER DE BIENVENIDA (HERO SECTION) -->
    <MudPaper Elevation="0" Class="pa-8 mb-10 rounded-xl d-flex flex-wrap align-center justify-space-between fade-in-suave" Style="background-color: var(--mud-palette-primary); color: white;">
        <div>
            <MudText Typo="Typo.h3" Class="font-weight-bold mb-2">¡Hola, @UserSession.Nombre!</MudText>
            <MudText Typo="Typo.body1" Style="opacity: 0.85;" Class="mb-2">Bienvenido a tu panel de control central. Aquí tienes tu resumen operativo.</MudText>
            <MudText Typo="Typo.caption" Class="font-weight-bold" Style="opacity: 0.7; text-transform: uppercase; letter-spacing: 1px;">@fechaActual</MudText>
        </div>
        <MudIcon Icon="@Icons.Material.Filled.SpaceDashboard" Style="font-size: 7rem; opacity: 0.15;" Class="d-none d-sm-flex" />
    </MudPaper>

    <MudText Typo="Typo.h6" Class="font-weight-bold mb-4" Color="Color.Primary">Módulos de Gestión</MudText>
    
    <!-- Fila de Tarjetas (Navegación / KPIs) -->
    <MudGrid Class="mb-10 fade-in-suave">
        
        @* --- 1. DIRECTORIO --- *@
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="pa-6 d-flex flex-column align-start rounded-xl cursor-pointer modern-card h-100" Style="border: 1px solid var(--mud-palette-lines-default);" @onclick='() => NavigationManager.NavigateTo("/alumnos")'>
                <MudAvatar Variant="Variant.Filled" Size="Size.Large" Style="background-color: rgba(var(--mud-palette-primary-rgb), 0.1); color: var(--mud-palette-primary);" Class="mb-4 rounded-lg">
                    <MudIcon Icon="@Icons.Material.Filled.PeopleAlt" Size="Size.Medium" />
                </MudAvatar>
                <MudText Typo="Typo.h6" Class="font-weight-bold mb-1">Directorio</MudText>
                <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">Consulta y gestión general de expedientes de alumnos.</MudText>
            </MudPaper>
        </MudItem>

        @* --- VALIDACIÓN DE ROLES --- *@
        @if (UserSession.EsControlEscolar)
        {
            @* --- 2. INSCRIPCIONES --- *@
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Class="pa-6 d-flex flex-column align-start rounded-xl cursor-pointer modern-card h-100" Style="border: 1px solid var(--mud-palette-lines-default);" @onclick='() => NavigationManager.NavigateTo("/inscripciones")'>
                    <MudAvatar Variant="Variant.Filled" Size="Size.Large" Style="background-color: rgba(var(--mud-palette-success-rgb), 0.1); color: var(--mud-palette-success);" Class="mb-4 rounded-lg">
                        <MudIcon Icon="@Icons.Material.Filled.HowToReg" Size="Size.Medium" />
                    </MudAvatar>
                    <MudText Typo="Typo.h6" Class="font-weight-bold mb-1">Inscripciones</MudText>
                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">Registra nuevos ingresos y matriculaciones al plantel.</MudText>
                </MudPaper>
            </MudItem>

            @* --- 3. CURSOS ACTIVOS --- *@
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Class="pa-6 d-flex flex-column align-start rounded-xl cursor-pointer modern-card h-100" Style="border: 1px solid var(--mud-palette-lines-default);" @onclick='() => NavigationManager.NavigateTo("/cursos")'>
                    <MudAvatar Variant="Variant.Filled" Size="Size.Large" Style="background-color: rgba(var(--mud-palette-warning-rgb), 0.1); color: var(--mud-palette-warning);" Class="mb-4 rounded-lg">
                        <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Medium" />
                    </MudAvatar>
                    <MudText Typo="Typo.h6" Class="font-weight-bold mb-1">Cursos Activos</MudText>
                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">Administración de materias, grupos y profesores.</MudText>
                </MudPaper>
            </MudItem>

            @* --- 4. CONTROL DE PAGOS --- *@
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Class="pa-6 d-flex flex-column align-start rounded-xl cursor-pointer modern-card h-100" Style="border: 1px solid var(--mud-palette-lines-default);" @onclick='() => NavigationManager.NavigateTo("/pagos")'>
                    <MudAvatar Variant="Variant.Filled" Size="Size.Large" Style="background-color: rgba(var(--mud-palette-error-rgb), 0.1); color: var(--mud-palette-error);" Class="mb-4 rounded-lg">
                        <MudIcon Icon="@Icons.Material.Filled.RequestQuote" Size="Size.Medium" />
                    </MudAvatar>
                    <MudText Typo="Typo.h6" Class="font-weight-bold mb-1">Control de Pagos</MudText>
                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">Ingresos, recibos y estatus financiero de los alumnos.</MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <!-- Sección de Accesos Rápidos -->
    <MudText Typo="Typo.h6" Class="font-weight-bold mb-4" Color="Color.Primary">Accesos Rápidos</MudText>
    
    <MudGrid Class="fade-in-suave">
        @if (UserSession.EsControlEscolar)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="0" Class="pa-4 rounded-xl d-flex align-center cursor-pointer modern-action-card" Style="border: 1px solid var(--mud-palette-lines-default);" @onclick='() => NavigationManager.NavigateTo("/inscripciones")'>
                    <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Color="Color.Primary" Class="mr-4" Style="font-size: 2rem;" />
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Nueva Inscripción</MudText>
                        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">Ir al formulario de alta</MudText>
                    </div>
                </MudPaper>
            </MudItem>
        }
        
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="0" Class="pa-4 rounded-xl d-flex align-center cursor-pointer modern-action-card" Style="border: 1px solid var(--mud-palette-lines-default);" @onclick='() => NavigationManager.NavigateTo("/alumnos")'>
                <MudIcon Icon="@Icons.Material.Filled.FolderShared" Color="Color.Secondary" Class="mr-4" Style="font-size: 2rem;" />
                <div>
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Consultar Expedientes</MudText>
                    <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">Buscar historial de alumnos</MudText>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

</MudContainer>

<style>
    /* Efecto de tarjetas principales */
    .modern-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        background-color: var(--mud-palette-background-grey);
    }
    .modern-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.15) !important;
        background-color: var(--mud-palette-surface);
        border-color: var(--mud-palette-primary) !important;
    }

    /* Efecto de tarjetas de acceso rápido */
    .modern-action-card {
        transition: all 0.2s ease-in-out;
    }
    .modern-action-card:hover {
        background-color: rgba(var(--mud-palette-primary-rgb), 0.04);
        border-color: var(--mud-palette-primary) !important;
    }
</style>

@code {
    private string fechaActual = "";

    protected override void OnInitialized()
    {
        // Genera la fecha actual en un formato elegante: "Sábado, 15 de agosto de 2026"
        var cultura = new CultureInfo("es-ES");
        var fecha = DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", cultura);
        
        // Capitalizar la primera letra
        if (!string.IsNullOrEmpty(fecha))
        {
            fechaActual = char.ToUpper(fecha[0]) + fecha.Substring(1);
        }
    }
}
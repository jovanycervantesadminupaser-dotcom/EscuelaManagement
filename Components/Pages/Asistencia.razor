@page "/asistencia"
@rendermode RenderMode.InteractiveServer
@using MudBlazor
@using System.IO
@using EscuelaManagement.Data.Models
@using EscuelaManagement.Data.Services
@inject FirebaseService Firebase
@inject PdfService Pdf
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-8">
    <MudText Typo="Typo.h4" GutterBottom="true" Color="Color.Primary">Control de Asistencia</MudText>
    <MudText Typo="Typo.subtitle1" Class="mb-6 text-muted">Generación de formato oficial impreso para el pase de lista mensual por curso.</MudText>

    @* --- PANEL DE FILTROS --- *@
    <MudPaper Elevation="3" Class="pa-5 mb-6 rounded-lg">
        <MudGrid AlignItems="Center">
            <MudItem xs="12" md="5">
                <MudSelect T="string" Label="Seleccionar Curso" @bind-Value="cursoSeleccionadoId" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem T="string" Value="@("")" Disabled="true">-- Seleccione un curso --</MudSelectItem>
                    @foreach (var curso in listaCursos)
                    {
                        <MudSelectItem T="string" Value="@curso.Id">@curso.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="string" Label="Mes a Imprimir" @bind-Value="mesSeleccionado" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem T="string" Value="@("Enero")">Enero</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Febrero")">Febrero</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Marzo")">Marzo</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Abril")">Abril</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Mayo")">Mayo</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Junio")">Junio</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Julio")">Julio</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Agosto")">Agosto</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Septiembre")">Septiembre</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Octubre")">Octubre</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Noviembre")">Noviembre</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Diciembre")">Diciembre</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4" Class="d-flex align-center gap-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="CargarListaAlumnos" Disabled="@string.IsNullOrEmpty(cursoSeleccionadoId)">
                    CARGAR
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="GenerarPdfLista" Disabled="@(!alumnosEnCurso.Any())">
                    IMPRIMIR LISTA
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* --- TABLA DE ALUMNOS INSCRITOS --- *@
    @if (cargando)
    {
        <div class="d-flex justify-center my-8">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        </div>
    }
    else if (alumnosEnCurso.Any())
    {
        <MudCard Elevation="3" Class="rounded-lg">
            <MudCardHeader Class="bg-light">
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Alumnos Inscritos (@alumnosEnCurso.Count)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Default">Esta lista se utilizará para generar el formato PDF de asistencia mensual.</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pa-0">
                <MudTable T="Student" Items="@alumnosEnCurso" Hover="true" Striped="true" Elevation="0">
                    <HeaderContent>
                        <MudTh Style="width: 50px;">#</MudTh>
                        <MudTh>Matrícula</MudTh>
                        <MudTh>Nombre Completo del Alumno</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="#">@(alumnosEnCurso.IndexOf(context) + 1)</MudTd>
                        <MudTd DataLabel="Matrícula">@(context.Id?.Length > 6 ? context.Id[..6].ToUpper() : "N/A")</MudTd>
                        <MudTd DataLabel="Alumno">
                            <b>@($"{context.Name} {context.PaternalLastName} {context.MaternalLastName}".Trim())</b>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudCardContent>
        </MudCard>
    }
    else if (!string.IsNullOrEmpty(cursoSeleccionadoId) && !cargando)
    {
        <MudPaper Elevation="1" Class="pa-6 text-center rounded-lg">
            <MudText Typo="Typo.body1" Color="Color.Default">No se encontraron alumnos inscritos en este curso.</MudText>
        </MudPaper>
    }
</MudContainer>

@code {
    private List<Course> listaCursos = [];
    private List<Student> listaAlumnos = [];
    private string cursoSeleccionadoId = "";
    private string mesSeleccionado = DateTime.Now.ToString("MMMM", new System.Globalization.CultureInfo("es-ES"));
    
    private List<Student> alumnosEnCurso = [];
    private bool cargando = false;

    protected override async Task OnInitializedAsync()
    {
        listaCursos = await Firebase.GetCoursesAsync() ?? [];
        listaAlumnos = await Firebase.GetAllStudentsAsync() ?? [];
        
        mesSeleccionado = char.ToUpper(mesSeleccionado[0]) + mesSeleccionado[1..];
    }

    private async Task CargarListaAlumnos()
    {
        if (string.IsNullOrEmpty(cursoSeleccionadoId)) return;

        cargando = true;
        StateHasChanged();

        try
        {
            listaAlumnos = await Firebase.GetAllStudentsAsync() ?? [];
            var todasLasInscripciones = await Firebase.GetAllEnrollmentsAsync() ?? [];
            var inscripcionesDelCurso = todasLasInscripciones.Where(e => e.CourseId == cursoSeleccionadoId).ToList();

            alumnosEnCurso.Clear();

            foreach (var insc in inscripcionesDelCurso)
            {
                var alumno = listaAlumnos.FirstOrDefault(a => a.Id == insc.StudentId);
                if (alumno != null)
                {
                    alumnosEnCurso.Add(alumno);
                }
                else
                {
                    alumnosEnCurso.Add(new Student { Id = insc.StudentId, Name = "ALUMNO DESCONOCIDO" });
                }
            }
            
            alumnosEnCurso = alumnosEnCurso.OrderBy(a => a.Name).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar alumnos: {ex.Message}", Severity.Error);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task GenerarPdfLista()
    {
        if (string.IsNullOrEmpty(cursoSeleccionadoId) || !alumnosEnCurso.Any()) return;

        try
        {
            var configuracionEscuela = await Firebase.GetConfiguracionAsync() ?? new();
            var curso = listaCursos.FirstOrDefault(c => c.Id == cursoSeleccionadoId);
            string nombreCurso = curso?.Name ?? "Curso";

            byte[] pdfBytes = Pdf.GenerarListaAsistencia(alumnosEnCurso, nombreCurso, mesSeleccionado, configuracionEscuela.NombreEscuela ?? "Escuela", configuracionEscuela.LogoBase64 ?? "");

            using var stream = new MemoryStream(pdfBytes);
            var dotNetStreamRef = new DotNetStreamReference(stream: stream);
            
            await JS.InvokeVoidAsync("downloadFileFromStream", $"Asistencia_{mesSeleccionado}_{nombreCurso.Replace(" ", "_")}.pdf", dotNetStreamRef);
            Snackbar.Add("Formato mensual de asistencia descargado exitosamente.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al generar el PDF: {ex.Message}", Severity.Error);
        }
    }
}
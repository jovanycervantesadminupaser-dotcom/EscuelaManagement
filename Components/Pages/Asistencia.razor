@page "/asistencia"
@rendermode RenderMode.InteractiveServer
@using MudBlazor
@using System.IO
@using EscuelaManagement.Data.Models
@using EscuelaManagement.Data.Services
@inject FirebaseService Firebase
@inject PdfService Pdf
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-6 pb-12">
    
    <!-- Encabezado Limpio -->
    <div class="mb-8">
        <MudText Typo="Typo.h4" Class="font-weight-bold mb-1">Control de Asistencia</MudText>
        <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">Generación de formato oficial impreso para el pase de lista mensual por curso.</MudText>
    </div>

    <!-- PANEL DE FILTROS -->
    <MudPaper Elevation="0" Class="pa-6 mb-8 rounded-lg" Style="border: 1px solid var(--mud-palette-lines-default);">
        <MudGrid Class="align-center">
            <MudItem xs="12" md="5">
                <MudSelect T="string" Label="Seleccionar Curso" @bind-Value="cursoSeleccionadoId" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Class="modern-input">
                    <MudSelectItem T="string" Value="@("")" Disabled="true">-- Seleccione un curso --</MudSelectItem>
                    @foreach (var curso in listaCursos)
                    {
                        <MudSelectItem T="string" Value="@curso.Id">@curso.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="string" Label="Mes a Imprimir" @bind-Value="mesSeleccionado" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Class="modern-input">
                    <MudSelectItem T="string" Value="@("Enero")">Enero</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Febrero")">Febrero</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Marzo")">Marzo</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Abril")">Abril</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Mayo")">Mayo</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Junio")">Junio</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Julio")">Julio</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Agosto")">Agosto</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Septiembre")">Septiembre</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Octubre")">Octubre</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Noviembre")">Noviembre</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Diciembre")">Diciembre</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4" Class="d-flex align-center gap-3">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="CargarListaAlumnos" Disabled="@string.IsNullOrEmpty(cursoSeleccionadoId)" Class="rounded-lg font-weight-bold" Style="text-transform: none; height: 56px;">
                    Cargar Lista
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="GenerarPdfLista" Disabled="@(!alumnosEnCurso.Any())" Class="rounded-lg font-weight-bold" Style="text-transform: none; height: 56px;">
                    Imprimir Formato
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- TABLA DE ALUMNOS INSCRITOS -->
    @if (cargando)
    {
        <MudPaper Elevation="0" Class="pa-6 rounded-lg" Style="border: 1px solid var(--mud-palette-lines-default);">
            <div class="d-flex flex-column align-center justify-center py-8 fade-in-suave">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" Class="mb-4" />
                <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">Procesando lista de alumnos...</MudText>
            </div>
        </MudPaper>
    }
    else if (alumnosEnCurso.Any())
    {
        <MudPaper Elevation="0" Class="pa-6 rounded-lg fade-in-suave" Style="border: 1px solid var(--mud-palette-lines-default);">
            <MudText Typo="Typo.h6" Class="font-weight-bold mb-1" Color="Color.Primary">Alumnos Inscritos (@alumnosEnCurso.Count)</MudText>
            <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);" Class="mb-4">Esta lista se utilizará para generar el formato PDF de asistencia mensual.</MudText>
            
            <MudTable T="Student" Items="@alumnosEnCurso" Hover="true" Elevation="0" Class="modern-table">
                <HeaderContent>
                    <MudTh Style="width: 50px; font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary);">#</MudTh>
                    <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary);">Matrícula</MudTh>
                    <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary);">Nombre Completo del Alumno</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="#" Class="font-weight-bold text-muted">@(alumnosEnCurso.IndexOf(context) + 1)</MudTd>
                    <MudTd DataLabel="Matrícula">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                            @(context.Id != null && context.Id.Length > 6 ? context.Id[..6].ToUpper() : "N/A")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Alumno">
                        <MudText Typo="Typo.body1" Class="font-weight-bold">
                            @($"{context.Name} {context.PaternalLastName} {context.MaternalLastName}".Trim())
                        </MudText>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
    else if (!string.IsNullOrEmpty(cursoSeleccionadoId) && !cargando)
    {
        <MudPaper Elevation="0" Class="pa-8 text-center rounded-lg fade-in-suave" Style="border: 1px dashed var(--mud-palette-lines-default); background-color: transparent;">
            <MudIcon Icon="@Icons.Material.Filled.GroupOff" Style="font-size: 4rem; color: var(--mud-palette-text-secondary);" Class="mb-3" />
            <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: var(--mud-palette-text-secondary);">Sin alumnos inscritos</MudText>
            <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">No se encontraron alumnos registrados activamente en este curso.</MudText>
        </MudPaper>
    }
</MudContainer>

<style>
    /* Estilos modernos para los inputs */
    .modern-input .mud-input-outlined-border {
        border-color: var(--mud-palette-lines-default) !important;
    }
    .modern-input .mud-input {
        background-color: transparent !important;
        border-radius: 8px !important;
    }
    .modern-input .mud-input.mud-input-focused .mud-input-outlined-border {
        border-width: 2px !important;
        border-color: var(--mud-palette-primary) !important;
    }

    /* Estilos limpios para la tabla */
    .modern-table .mud-table-cell {
        border-bottom: 1px solid var(--mud-palette-lines-default) !important;
        padding: 16px 12px !important;
    }
    .modern-table .mud-table-root {
        border: none !important;
    }
</style>

@code {
    private List<Course> listaCursos = [];
    private List<Student> listaAlumnos = [];
    private string cursoSeleccionadoId = "";
    private string mesSeleccionado = DateTime.Now.ToString("MMMM", new System.Globalization.CultureInfo("es-ES"));
    
    private List<Student> alumnosEnCurso = [];
    private bool cargando = false;

    protected override async Task OnInitializedAsync()
    {
        listaCursos = await Firebase.GetCoursesAsync() ?? [];
        listaAlumnos = await Firebase.GetAllStudentsAsync() ?? [];
        
        mesSeleccionado = char.ToUpper(mesSeleccionado[0]) + mesSeleccionado[1..];
    }

    private async Task CargarListaAlumnos()
    {
        if (string.IsNullOrEmpty(cursoSeleccionadoId)) return;

        cargando = true;
        StateHasChanged();

        try
        {
            listaAlumnos = await Firebase.GetAllStudentsAsync() ?? [];
            var todasLasInscripciones = await Firebase.GetAllEnrollmentsAsync() ?? [];
            var inscripcionesDelCurso = todasLasInscripciones.Where(e => e.CourseId == cursoSeleccionadoId).ToList();

            alumnosEnCurso.Clear();

            foreach (var insc in inscripcionesDelCurso)
            {
                var alumno = listaAlumnos.FirstOrDefault(a => a.Id == insc.StudentId);
                if (alumno != null)
                {
                    alumnosEnCurso.Add(alumno);
                }
                else
                {
                    alumnosEnCurso.Add(new Student { Id = insc.StudentId ?? "", Name = "ALUMNO DESCONOCIDO" });
                }
            }
            
            alumnosEnCurso = alumnosEnCurso.OrderBy(a => a.Name).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar alumnos: {ex.Message}", Severity.Error);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task GenerarPdfLista()
    {
        if (string.IsNullOrEmpty(cursoSeleccionadoId) || !alumnosEnCurso.Any()) return;

        try
        {
            var configuracionEscuela = await Firebase.GetConfiguracionAsync() ?? new();
            var curso = listaCursos.FirstOrDefault(c => c.Id == cursoSeleccionadoId);
            string nombreCurso = curso?.Name ?? "Curso";

            byte[] pdfBytes = Pdf.GenerarListaAsistencia(alumnosEnCurso, nombreCurso, mesSeleccionado, configuracionEscuela.NombreEscuela ?? "Escuela", configuracionEscuela.LogoBase64 ?? "");

            using var stream = new MemoryStream(pdfBytes);
            var dotNetStreamRef = new DotNetStreamReference(stream: stream);
            
            await JS.InvokeVoidAsync("downloadFileFromStream", $"Asistencia_{mesSeleccionado}_{nombreCurso.Replace(" ", "_")}.pdf", dotNetStreamRef);
            Snackbar.Add("Formato mensual de asistencia descargado exitosamente.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al generar el PDF: {ex.Message}", Severity.Error);
        }
    }
}
@page "/inscripciones"
@rendermode RenderMode.InteractiveServer
@using MudBlazor
@using System.IO
@using EscuelaManagement.Data.Models
@using EscuelaManagement.Data.Services
@using Google.Cloud.Firestore
@using QuestPDF.Fluent
@inject FirebaseService Firebase
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-6 pb-12" Style="min-height: 100vh;">
    
    <!-- ENCABEZADO M3 EXPRESSIVE -->
    <div class="mb-8 d-flex align-center gap-4 fade-in-suave">
        <MudAvatar Size="Size.Large" Style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white; width: 64px; height: 64px; box-shadow: 0 10px 15px -3px rgba(59,130,246,0.3);">
            <MudIcon Icon="@Icons.Material.Filled.PersonAddAlt1" Size="Size.Large" />
        </MudAvatar>
        <div>
            <MudText Typo="Typo.h3" Class="font-weight-bold mb-1" Style="color: var(--mud-palette-text-primary); letter-spacing: -1px;">Ficha de Inscripción</MudText>
            <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">Registra un nuevo alumno o inscribe uno existente en la institución.</MudText>
        </div>
    </div>

    <!-- MÓDULO 1: BUSCADOR DE ALUMNOS -->
    <MudPaper Elevation="0" Class="pa-8 mb-8 rounded-xxl m3-section-card fade-in-up" Style="background-color: var(--mud-palette-surface);">
        <MudGrid Class="d-flex align-center">
            <MudItem xs="12" md="7">
                <MudAutocomplete T="Student" 
                                 Label="Buscar Alumno Inscrito previamente (Nombre o Apellido)" 
                                 Value="@selectedStudent" 
                                 ValueChanged="@OnStudentSelected"
                                 SearchFunc="@SearchStudents" 
                                 ToStringFunc="@DisplayAlumno"
                                 Variant="Variant.Outlined" 
                                 AdornmentIcon="@Icons.Material.Filled.Search" 
                                 AdornmentColor="Color.Primary" 
                                 Clearable="true" 
                                 Placeholder="Escribe para buscar..."
                                 Class="modern-input" />
            </MudItem>
            <MudItem xs="12" md="5">
                @if (isExistingStudent)
                {
                    <div class="m3-alert m3-alert-info d-flex align-center pa-4 rounded-xl">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-3" />
                        <div>
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Alumno Existente</MudText>
                            <MudText Typo="Typo.caption">Se creará un nuevo historial de curso para este perfil.</MudText>
                        </div>
                    </div>
                }
                else
                {
                    <div class="m3-alert m3-alert-success d-flex align-center pa-4 rounded-xl">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-3" />
                        <div>
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Nuevo Registro</MudText>
                            <MudText Typo="Typo.caption">Se registrará un alumno completamente nuevo.</MudText>
                        </div>
                    </div>
                }
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- FORMULARIO PRINCIPAL EN TARJETAS SEPARADAS -->
    <MudForm @ref="form" Class="fade-in-up" Style="animation-delay: 0.1s;">
        
        <!-- SECCIÓN: ASESOR Y FOTOGRAFÍA -->
        <MudPaper Elevation="0" Class="pa-8 mb-8 rounded-xxl m3-section-card" Style="background-color: var(--mud-palette-surface);">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <div class="d-flex align-center mb-6">
                        <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="background-color: rgba(59,130,246,0.15); color: #3b82f6;" Class="mr-3 rounded-lg">
                            <MudIcon Icon="@Icons.Material.Filled.SupportAgent" />
                        </MudAvatar>
                        <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">Asignación de Asesor</MudText>
                    </div>
                    <MudSelect T="string" Label="Ejecutivo que realizó la inscripción" @bind-Value="enrollment.AsesorAsignado" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Clearable="true" Placeholder="Opcional: Seleccione un asesor" Class="modern-input">
                        @if(listaUsuarios != null && listaUsuarios.Any())
                        {
                            @foreach (var usuario in listaUsuarios.Where(u => u.Activo))
                            {
                                <MudSelectItem T="string" Value="@usuario.Nombre">@usuario.Nombre (@usuario.Rol)</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6" Class="d-flex flex-column align-center justify-center">
                    <div class="d-flex align-center mb-6 w-100 justify-center">
                        <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="background-color: rgba(16,185,129,0.15); color: #10b981;" Class="mr-3 rounded-lg">
                            <MudIcon Icon="@Icons.Material.Filled.CameraFront" />
                        </MudAvatar>
                        <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">Fotografía del Alumno</MudText>
                    </div>
                    
                    @if (isCameraOpen)
                    {
                        <div class="fade-in-suave w-100 d-flex flex-column align-center">
                            <video id="cameraVideo" width="100%" style="max-width: 320px; border-radius: 16px; background-color: black; border: 4px solid var(--mud-palette-primary);" autoplay></video>
                            <div class="mt-4 d-flex gap-4">
                                <MudButton OnClick="CapturarFoto" Color="Color.Success" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Camera" Class="rounded-xl font-weight-bold px-6" Style="text-transform: none;">Tomar Foto</MudButton>
                                <MudButton OnClick="CerrarCamara" Color="Color.Error" Variant="Variant.Text" Class="font-weight-bold rounded-xl px-4" Style="text-transform: none;">Cancelar</MudButton>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-center gap-6">
                            @if (!string.IsNullOrEmpty(student.PhotoBase64))
                            {
                                <MudImage Src="@student.PhotoBase64" Width="130" Height="130" ObjectFit="ObjectFit.Cover" Elevation="4" Class="rounded-xxl fade-in-suave" Style="border: 3px solid white;" />
                            }
                            else
                            {
                                <MudPaper Width="130px" Height="130px" Class="d-flex align-center justify-center rounded-xxl fade-in-suave" Elevation="0" Style="border: 2px dashed var(--mud-palette-lines-default); background-color: var(--mud-palette-background-grey);">
                                    <MudIcon Icon="@Icons.Material.Filled.PersonOutline" Style="font-size: 4.5rem; color: var(--mud-palette-text-disabled);" />
                                </MudPaper>
                            }
                            
                            <div class="d-flex flex-column gap-3">
                                <MudButton HtmlTag="label" for="fileInput" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FileUpload" Class="rounded-xl font-weight-bold px-6 py-2" Style="text-transform: none;">Subir Archivo</MudButton>
                                <MudButton OnClick="AbrirCamara" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CameraAlt" DisableElevation="true" Class="rounded-xl font-weight-bold px-6 py-2" Style="text-transform: none; background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);">Usar Cámara</MudButton>
                            </div>
                            <InputFile id="fileInput" OnChange="UploadPhoto" accept=".jpg,.jpeg,.png" style="display: none;" />
                        </div>
                    }
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- SECCIÓN 1: DATOS DEL ALUMNO -->
        <MudPaper Elevation="0" Class="pa-8 mb-8 rounded-xxl m3-section-card" Style="background-color: var(--mud-palette-surface);">
            <div class="d-flex align-center mb-6">
                <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="background-color: rgba(245,158,11,0.15); color: #f59e0b;" Class="mr-3 rounded-lg">
                    <MudIcon Icon="@Icons.Material.Filled.Face" />
                </MudAvatar>
                <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">1. Datos del Alumno</MudText>
            </div>
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Label="Nombre(s)" @bind-Value="student.Name" Variant="Variant.Outlined" Disabled="@isExistingStudent" Class="modern-input" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Label="Apellido Paterno" @bind-Value="student.PaternalLastName" Variant="Variant.Outlined" Disabled="@isExistingStudent" Class="modern-input" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Label="Apellido Materno" @bind-Value="student.MaternalLastName" Variant="Variant.Outlined" Disabled="@isExistingStudent" Class="modern-input" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudDatePicker T="DateTime?" Label="Fecha de Nacimiento" @bind-Date="tempDate" Variant="Variant.Outlined" Disabled="@isExistingStudent" Class="modern-input" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Label="Teléfono del Alumno" @bind-Value="student.Phone" Variant="Variant.Outlined" MaxLength="10" InputType="InputType.Telephone" HelperText="10 dígitos" Disabled="@isExistingStudent" Class="modern-input" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Escuela de Procedencia" @bind-Value="student.PreviousSchool" Variant="Variant.Outlined" Disabled="@isExistingStudent" Class="modern-input" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Escuela a Ingresar" @bind-Value="student.TargetSchool" Variant="Variant.Outlined" Disabled="@isExistingStudent" Class="modern-input" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- SECCIÓN 2: TUTOR / CONTACTO -->
        <MudPaper Elevation="0" Class="pa-8 mb-8 rounded-xxl m3-section-card" Style="background-color: var(--mud-palette-surface);">
            <div class="d-flex align-center mb-6">
                <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="background-color: rgba(139,92,246,0.15); color: #8b5cf6;" Class="mr-3 rounded-lg">
                    <MudIcon Icon="@Icons.Material.Filled.FamilyRestroom" />
                </MudAvatar>
                <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">2. Datos del Tutor / Contacto</MudText>
            </div>
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Label="Nombre del Tutor" @bind-Value="student.Guardian.Name" Variant="Variant.Outlined" Disabled="@isExistingStudent" Class="modern-input" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Label="Apellidos" @bind-Value="student.Guardian.PaternalLastName" Variant="Variant.Outlined" Disabled="@isExistingStudent" Class="modern-input" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Label="Parentesco (Ej. Madre, Tío)" @bind-Value="student.Guardian.Relationship" Variant="Variant.Outlined" Disabled="@isExistingStudent" Class="modern-input" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Teléfono del Tutor" @bind-Value="student.Guardian.Phone" Variant="Variant.Outlined" MaxLength="10" InputType="InputType.Telephone" HelperText="10 dígitos" Disabled="@isExistingStudent" Class="modern-input" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Correo Electrónico del Tutor" @bind-Value="student.Guardian.Email" Variant="Variant.Outlined" InputType="InputType.Email" Disabled="@isExistingStudent" Class="modern-input" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- SECCIÓN 3: DIRECCIÓN -->
        <MudPaper Elevation="0" Class="pa-8 mb-8 rounded-xxl m3-section-card" Style="background-color: var(--mud-palette-surface);">
            <div class="d-flex align-center mb-6">
                <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="background-color: rgba(236,72,153,0.15); color: #ec4899;" Class="mr-3 rounded-lg">
                    <MudIcon Icon="@Icons.Material.Filled.Home" />
                </MudAvatar>
                <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">3. Dirección</MudText>
            </div>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Calle" @bind-Value="student.Address.Street" Variant="Variant.Outlined" Disabled="@isExistingStudent" Class="modern-input" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudTextField T="string" Label="Núm. Exterior" @bind-Value="student.Address.ExtNumber" Variant="Variant.Outlined" Disabled="@isExistingStudent" Class="modern-input" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudTextField T="string" Label="Núm. Interior" @bind-Value="student.Address.IntNumber" Variant="Variant.Outlined" Disabled="@isExistingStudent" Class="modern-input" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Label="Colonia" @bind-Value="student.Address.Neighborhood" Variant="Variant.Outlined" Disabled="@isExistingStudent" Class="modern-input" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Label="Municipio / Alcaldía" @bind-Value="student.Address.Municipality" Variant="Variant.Outlined" Disabled="@isExistingStudent" Class="modern-input" />
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudTextField T="string" Label="Estado" @bind-Value="student.Address.State" Variant="Variant.Outlined" Disabled="@isExistingStudent" Class="modern-input" />
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudTextField T="string" Label="Código Postal" @bind-Value="student.Address.ZipCode" Variant="Variant.Outlined" Disabled="@isExistingStudent" Class="modern-input" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- SECCIÓN 4: ESQUEMA FINANCIERO Y CONDICIONES -->
        <MudPaper Elevation="0" Class="pa-8 mb-8 rounded-xxl m3-section-card" Style="background-color: var(--mud-palette-surface);">
            <div class="d-flex align-center mb-6">
                <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="background-color: rgba(14,165,233,0.15); color: #0ea5e9;" Class="mr-3 rounded-lg">
                    <MudIcon Icon="@Icons.Material.Filled.RequestQuote" />
                </MudAvatar>
                <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">4. Detalles de Inscripción y Esquema Financiero</MudText>
            </div>
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" Label="Seleccionar Curso" Value="@enrollment.CourseId" ValueChanged="@OnCourseSelected" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Class="modern-input">
                        @foreach (var curso in cursosDisponibles)
                        {
                            <MudSelectItem T="string" Value="@curso.Id">@curso.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudSelect T="string" Label="Turno del Curso" @bind-Value="turnoSeleccionado" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Class="modern-input">
                        <MudSelectItem T="string" Value="@("MATUTINO")">MATUTINO</MudSelectItem>
                        <MudSelectItem T="string" Value="@("VESPERTINO")">VESPERTINO</MudSelectItem>
                        <MudSelectItem T="string" Value="@("OTRO")">OTRO (Especificar)</MudSelectItem>
                    </MudSelect>
                </MudItem>

                @if (turnoSeleccionado == "OTRO")
                {
                    <MudItem xs="12" md="4" Class="fade-in-suave">
                        <MudTextField T="string" Label="Especifique el Turno" @bind-Value="turnoManual" Variant="Variant.Outlined" Class="modern-input" />
                    </MudItem>
                }

                <MudItem xs="12" md="4">
                    <MudNumericField T="double" Label="Descuento Aplicado (%)" Value="@enrollment.DiscountAmount" ValueChanged="@OnDiscountChanged" Variant="Variant.Outlined" Min="0" Max="100" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Percent" Class="modern-input" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudSelect T="string" Label="Esquema / Plazo de Pago" Value="@enrollment.TipoPlazo" ValueChanged="@OnTipoPlazoSelected" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Disabled="@(currentCourse == null)" Class="modern-input">
                        @foreach (var plan in availablePaymentPlans)
                        {
                            <MudSelectItem T="string" Value="@plan">@plan</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @if (enrollment.TipoPlazo != "Una Sola Exhibición" && !string.IsNullOrEmpty(enrollment.TipoPlazo))
                {
                    <MudItem xs="6" md="4" Class="fade-in-suave">
                        <MudNumericField T="int" Label="Cantidad de Plazos" @bind-Value="enrollment.NumeroPlazos" Variant="Variant.Outlined" Min="1" ReadOnly="true" Class="modern-input" />
                    </MudItem>
                    <MudItem xs="6" md="4" Class="fade-in-suave">
                        <MudNumericField T="double" Label="Monto por Plazo ($)" @bind-Value="enrollment.MontoPlazo" Variant="Variant.Outlined" Min="0.1" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AttachMoney" ReadOnly="true" Class="modern-input" />
                    </MudItem>
                }
                
                <MudItem xs="12" Class="mt-6">
                    <MudPaper Elevation="0" Class="pa-6 rounded-xxl" Style="background-color: var(--mud-palette-background-grey); border: 1px dashed var(--mud-palette-lines-default);">
                        <MudCheckBox T="bool" @bind-Value="aceptaRetiroSinTutor" Label="Autorización para que el alumno se retire del plantel sin el tutor" Color="Color.Primary" Class="mb-2 font-weight-bold" />
                        <MudCheckBox T="bool" @bind-Value="imprimirTerminos" Label="Imprimir Términos y Condiciones" Color="Color.Secondary" Class="mb-2" />
                        <MudCheckBox T="bool" @bind-Value="imprimirGarantia" Label="Imprimir Póliza de Garantía" Color="Color.Secondary" />
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <!-- ACCIONES FINALES -->
            <div class="d-flex justify-end mt-8 pt-6" style="border-top: 1px solid var(--mud-palette-lines-default);">
                @if (!registroCompletado)
                {
                    <div class="d-flex gap-4 fade-in-suave flex-wrap justify-end">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Email" OnClick="GuardarYEnviarCorreo" Disabled="@enviandoCorreo" Class="rounded-xl font-weight-bold px-8 py-3" Style="text-transform: none; border-width: 2px;">
                            @if (enviandoCorreo)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>ENVIANDO...</span>
                            }
                            else
                            {
                                <span>Guardar y Enviar por Correo</span>
                            }
                        </MudButton>

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" DisableElevation="true" Size="Size.Large" StartIcon="@Icons.Material.Filled.FileDownload" OnClick="GuardarYDescargar" Disabled="@enviandoCorreo" Class="rounded-xl font-weight-bold px-8 py-3" Style="text-transform: none; background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);">
                            Guardar y Descargar PDF
                        </MudButton>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column align-end w-100 fade-in-suave">
                        <div class="m3-alert m3-alert-success w-100 d-flex align-center pa-4 rounded-xl mb-6">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-3" />
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">¡Operación completada exitosamente!</MudText>
                        </div>
                        
                        <div class="d-flex gap-4 flex-wrap justify-end">
                            <MudButton Variant="Variant.Filled" DisableElevation="true" Style="background-color: #25D366; color: white; text-transform: none;" StartIcon="@Icons.Custom.Brands.WhatsApp" Class="rounded-xl font-weight-bold px-8 py-3" OnClick="CompartirWhatsApp">
                                Notificar WhatsApp
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="LimpiarFormulario" Class="rounded-xl font-weight-bold px-8 py-3" Style="text-transform: none; border-width: 2px;">
                                Nueva Inscripción
                            </MudButton>
                        </div>
                    </div>
                }
            </div>
        </MudPaper>
    </MudForm>
</MudContainer>

<style>
    /* Efecto Flotante para las Tarjetas por Sección */
    .m3-section-card {
        border: 1px solid var(--mud-palette-lines-default);
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .m3-section-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.08);
    }

    /* Estilos modernos para los inputs (Efecto Pop-out) */
    .modern-input .mud-input-outlined-border {
        border: 2px solid transparent !important;
        transition: all 0.3s ease-in-out;
    }
    .modern-input .mud-input {
        background-color: var(--mud-palette-background-grey) !important;
        border-radius: 16px !important;
        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
    }
    .modern-input .mud-input.mud-input-focused {
        background-color: var(--mud-palette-surface) !important;
        transform: scale(1.02) translateY(-2px);
        box-shadow: 0 10px 20px -5px rgba(59, 130, 246, 0.15) !important;
    }
    .modern-input .mud-input.mud-input-focused .mud-input-outlined-border {
        border-color: var(--mud-palette-primary) !important;
        background-color: transparent !important;
    }

    /* Pastillas de Alerta M3 */
    .m3-alert { border-left: 6px solid; }
    .m3-alert-info { background-color: rgba(59,130,246,0.1); border-left-color: #3b82f6; color: #1e40af; }
    .m3-alert-success { background-color: rgba(16,185,129,0.1); border-left-color: #10b981; color: #065f46; }

    /* Fix para modo oscuro en alertas */
    .mud-palette-dark .m3-alert-info { color: #60a5fa; }
    .mud-palette-dark .m3-alert-success { color: #34d399; }
</style>

@code {
    private MudForm form = default!;
    private Student student = new();
    private Enrollment enrollment = new();
    private DateTime? tempDate;
    private ConfiguracionEscuela configuracionEscuela = new();
    
    private List<Course> cursosDisponibles = new();
    private List<Student> listaAlumnosCompletos = new(); 
    private List<Usuario> listaUsuarios = new(); 
    private Student? selectedStudent;
    
    private Course? currentCourse;
    private List<string> availablePaymentPlans = new();

    private bool isExistingStudent = false;
    private bool isCameraOpen = false;

    private bool aceptaRetiroSinTutor = false;
    private bool imprimirTerminos = false;
    private bool imprimirGarantia = false;
    private string turnoSeleccionado = "";
    private string turnoManual = "";

    private bool registroCompletado = false;
    private bool enviandoCorreo = false;
    private string tipoAccion = "descargar";

    protected override async Task OnInitializedAsync()
    {
        QuestPDF.Settings.License = QuestPDF.Infrastructure.LicenseType.Community;
        await RecargarDatosDesdeFirebase();
    }

    private async Task RecargarDatosDesdeFirebase()
    {
        try
        {
            configuracionEscuela = await Firebase.GetConfiguracionAsync() ?? new();
            cursosDisponibles = await Firebase.GetCoursesAsync();
            listaAlumnosCompletos = await Firebase.GetAllStudentsAsync();
            listaUsuarios = await Firebase.GetUsuariosAsync() ?? new(); 
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al sincronizar con Firebase: {ex.Message}", Severity.Error);
        }
    }

    private void OnCourseSelected(string courseId)
    {
        enrollment.CourseId = courseId;
        currentCourse = cursosDisponibles.FirstOrDefault(c => c.Id == courseId);
        
        availablePaymentPlans.Clear();
        availablePaymentPlans.Add("Una Sola Exhibición");

        if (currentCourse != null && currentCourse.AllowInstallments && currentCourse.InstallmentOptions != null)
        {
            foreach (var opcion in currentCourse.InstallmentOptions)
            {
                if (!availablePaymentPlans.Contains(opcion.InstallmentPeriod))
                {
                    availablePaymentPlans.Add(opcion.InstallmentPeriod);
                }
            }
        }

        enrollment.TipoPlazo = "";
        enrollment.NumeroPlazos = 0;
        enrollment.MontoPlazo = 0;
    }

    private void OnDiscountChanged(double value)
    {
        enrollment.DiscountAmount = value;
        CalcalcularEsquemaFinanciero();
    }

    private void OnTipoPlazoSelected(string tipoPlazo)
    {
        enrollment.TipoPlazo = tipoPlazo;
        CalcalcularEsquemaFinanciero();
    }

    private void CalcalcularEsquemaFinanciero()
    {
        if (currentCourse == null || string.IsNullOrEmpty(enrollment.TipoPlazo)) return;

        double factorDescuento = 1 - (enrollment.DiscountAmount / 100.0);

        if (enrollment.TipoPlazo == "Una Sola Exhibición")
        {
            enrollment.NumeroPlazos = 1;
            enrollment.MontoPlazo = currentCourse.SinglePaymentCost * factorDescuento;
        }
        else
        {
            var opcionSeleccionada = currentCourse.InstallmentOptions.FirstOrDefault(o => o.InstallmentPeriod == enrollment.TipoPlazo);
            if (opcionSeleccionada != null)
            {
                enrollment.NumeroPlazos = opcionSeleccionada.InstallmentCount;
                enrollment.MontoPlazo = opcionSeleccionada.InstallmentAmount * factorDescuento;
            }
        }
    }

    private string DisplayAlumno(Student? s)
    {
        return s == null ? "" : $"{s.Name} {s.PaternalLastName} {s.MaternalLastName}";
    }

    private Task<IEnumerable<Student>> SearchStudents(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
            return Task.FromResult<IEnumerable<Student>>(listaAlumnosCompletos.Take(10));

        var filtrados = listaAlumnosCompletos.Where(s => 
            (s.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (s.PaternalLastName?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (s.MaternalLastName?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false)
        );

        return Task.FromResult(filtrados);
    }

    private void OnStudentSelected(Student? alumnoSelected)
    {
        selectedStudent = alumnoSelected;
        
        if (alumnoSelected != null)
        {
            student = alumnoSelected;
            isExistingStudent = true;

            if (student.DateOfBirth != null)
            {
                tempDate = student.DateOfBirth.Value.ToDateTime();
            }
        }
        else
        {
            LimpiarFormulario();
        }
        StateHasChanged();
    }

    private void LimpiarFormulario()
    {
        student = new Student();
        enrollment = new Enrollment();
        tempDate = null;
        selectedStudent = null;
        currentCourse = null;
        availablePaymentPlans.Clear();
        isExistingStudent = false;
        aceptaRetiroSinTutor = false;
        imprimirTerminos = false;
        imprimirGarantia = false;
        turnoSeleccionado = "";
        turnoManual = "";
        registroCompletado = false;
        enviandoCorreo = false;
        tipoAccion = "descargar";
    }

    private async Task AbrirCamara()
    {
        isCameraOpen = true;
        StateHasChanged();
        await Task.Delay(100); 
        await JSRuntime.InvokeVoidAsync("cameraHelper.startCamera", "cameraVideo");
    }

    private async Task CapturarFoto()
    {
        try
        {
            Snackbar.Add("Procesando imagen...", Severity.Info);
            var base64 = await JSRuntime.InvokeAsync<string>("cameraHelper.takeSnapshot", "cameraVideo");
            student.PhotoBase64 = base64;
            await CerrarCamara();
            Snackbar.Add("¡Fotografía capturada con éxito!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al tomar la foto: {ex.Message}", Severity.Error);
            await CerrarCamara();
        }
    }

    private async Task CerrarCamara()
    {
        await JSRuntime.InvokeVoidAsync("cameraHelper.stopCamera");
        isCameraOpen = false;
        StateHasChanged();
    }

    private async Task UploadPhoto(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            var buffer = memoryStream.ToArray();
            
            student.PhotoBase64 = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
        }
    }

    private async Task GuardarYEnviarCorreo()
    {
        tipoAccion = "correo";
        enviandoCorreo = true;
        StateHasChanged();
        await HandleSubmit();
    }

    private async Task GuardarYDescargar()
    {
        tipoAccion = "descargar";
        enviandoCorreo = true; 
        StateHasChanged();
        await HandleSubmit();
    }

    private async Task HandleSubmit()
    {
        try
        {
            if (string.IsNullOrEmpty(student.Id))
            {
                student.Id = Guid.NewGuid().ToString();
            }

            if (tempDate.HasValue && !isExistingStudent)
            {
                student.DateOfBirth = Timestamp.FromDateTime(tempDate.Value.ToUniversalTime());
            }

            await Firebase.AddStudentAsync(student);

            enrollment.StudentId = student.Id;
            enrollment.EnrollmentDate = DateTime.UtcNow; 
            enrollment.Turno = turnoSeleccionado == "OTRO" ? turnoManual : turnoSeleccionado;

            if (enrollment.TipoPlazo == "Una Sola Exhibición")
            {
                var curso = cursosDisponibles.FirstOrDefault(c => c.Id == enrollment.CourseId);
                if (curso != null)
                {
                    double costoConDescuento = curso.SinglePaymentCost * (1 - (enrollment.DiscountAmount / 100.0));
                    enrollment.NumeroPlazos = 1;
                    enrollment.MontoPlazo = costoConDescuento;
                }
            }

            await Firebase.AddEnrollmentAsync(enrollment);

            var pdfBytes = GeneratePdfDocument();
            
            await DescargarPdf(pdfBytes, $"Ficha_{(string.IsNullOrEmpty(student.Name) ? "Alumno" : student.Name)}.pdf");

            if (tipoAccion == "correo")
            {
                await CompartirCorreoHibrido();
            }
            else
            {
                Snackbar.Add("Inscripción guardada de forma exitosa.", Severity.Success);
            }
            
            registroCompletado = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al procesar la inscripción: {ex.Message}", Severity.Error);
        }
        finally
        {
            enviandoCorreo = false;
            StateHasChanged(); 
        }
    }

    private async Task CompartirWhatsApp()
    {
        var telefono = student.Guardian.Phone;
        if (string.IsNullOrEmpty(telefono) || telefono.Length != 10)
        {
            telefono = student.Phone;
        }

        if (string.IsNullOrEmpty(telefono) || telefono.Length != 10)
        {
            Snackbar.Add("No hay un número válido de 10 dígitos registrado.", Severity.Warning);
            return;
        }

        var nombreDestinatario = string.IsNullOrEmpty(student.Guardian.Name) ? (string.IsNullOrEmpty(student.Name) ? "Estimado" : student.Name) : student.Guardian.Name;
        var mensaje = Uri.EscapeDataString($"¡Hola {nombreDestinatario}! Confirmamos la inscripción exitosa en {configuracionEscuela.NombreEscuela}. Por este medio le compartimos su Ficha de Inscripción oficial.");
        var url = $"https://wa.me/52{telefono}?text={mensaje}";
        await JSRuntime.InvokeVoidAsync("open", url, "_blank");
    }

    private async Task CompartirCorreoHibrido()
    {
        if (string.IsNullOrWhiteSpace(student.Guardian.Email))
        {
            Snackbar.Add("El tutor no cuenta con una dirección de correo válida.", Severity.Warning);
            return;
        }

        try
        {
            var nombreTutor = string.IsNullOrEmpty(student.Guardian.Name) ? "Padre o Tutor" : student.Guardian.Name;
            var asunto = Uri.EscapeDataString("Confirmación de Inscripción - UPASER");
            var cuerpo = Uri.EscapeDataString($"Estimado(a) {nombreTutor},\n\nLe informamos que la inscripción ha sido procesada con éxito.\nPor favor, encuentre adjunta su Ficha de Inscripción oficial en formato PDF.\n\nSaludos cordiales,\nControl Escolar - UPASER");
            
            var mailtoUrl = $"mailto:{student.Guardian.Email}?subject={asunto}&body={cuerpo}";
            await JSRuntime.InvokeVoidAsync("open", mailtoUrl, "_self");

            Snackbar.Add("Ficha guardada localmente. Gestor de correo abierto.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al abrir el gestor de correo: {ex.Message}", Severity.Error);
        }
    }


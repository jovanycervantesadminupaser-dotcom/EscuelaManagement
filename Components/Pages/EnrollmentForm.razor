    private async Task DescargarPdf(byte[] bytes, string fileName)
    {
        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JSRuntime.InvokeVoidAsync("descargarArchivoPdf", fileName, streamRef);
    }

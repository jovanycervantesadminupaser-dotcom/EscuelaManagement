@using MudBlazor
@using System.IO
@using EscuelaManagement.Data.Models
@using EscuelaManagement.Data.Services
@using Google.Cloud.Firestore
@inject FirebaseService Firebase
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<MudDialog>
    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="px-2 pb-4">
            <MudForm @ref="form" Class="fade-in-suave">
                
                <!-- ZONA DE FOTOGRAFÍA M3 -->
                <MudPaper Elevation="0" Class="pa-8 mb-6 rounded-xxl m3-section-card d-flex flex-column align-center" Style="background-color: var(--mud-palette-surface);">
                    <div class="d-flex align-center mb-4">
                        <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="background-color: rgba(16,185,129,0.15); color: #10b981;" Class="mr-3 rounded-lg">
                            <MudIcon Icon="@Icons.Material.Filled.CameraFront" />
                        </MudAvatar>
                        <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">Fotografía del Alumno</MudText>
                    </div>
                    
                    @if (isCameraOpen)
                    {
                        <div class="fade-in-suave w-100 d-flex flex-column align-center">
                            <video id="cameraVideoEdit" width="100%" style="max-width: 280px; border-radius: 16px; background-color: black; border: 4px solid var(--mud-palette-primary);" autoplay></video>
                            <div class="mt-4 d-flex gap-4">
                                <MudButton OnClick="CapturarFoto" Color="Color.Success" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Camera" Class="rounded-xl font-weight-bold px-6" Style="text-transform: none;">Capturar</MudButton>
                                <MudButton OnClick="CerrarCamara" Color="Color.Error" Variant="Variant.Text" Class="font-weight-bold rounded-xl px-4" Style="text-transform: none;">Cancelar</MudButton>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column align-center gap-4">
                            @if (!string.IsNullOrEmpty(StudentToEdit.PhotoBase64))
                            {
                                <MudImage Src="@StudentToEdit.PhotoBase64" Width="130" Height="130" ObjectFit="ObjectFit.Cover" Elevation="4" Class="rounded-xxl fade-in-suave" Style="border: 3px solid var(--mud-palette-background);" />
                            }
                            else
                            {
                                <MudPaper Width="130px" Height="130px" Class="d-flex align-center justify-center rounded-xxl fade-in-suave" Elevation="0" Style="border: 2px dashed var(--mud-palette-lines-default); background-color: var(--mud-palette-background);">
                                    <MudIcon Icon="@Icons.Material.Filled.PersonOutline" Style="font-size: 4.5rem; color: var(--mud-palette-text-disabled);" />
                                </MudPaper>
                            }
                            
                            <div class="d-flex gap-3">
                                <MudButton HtmlTag="label" for="fileInputEdit" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FileUpload" Class="rounded-xl font-weight-bold px-6 py-2" Style="text-transform: none;">Subir Archivo</MudButton>
                                <MudButton OnClick="AbrirCamara" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CameraAlt" Class="rounded-xl font-weight-bold px-6 py-2" Style="text-transform: none; background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white;">Usar Cámara</MudButton>
                            </div>
                            <InputFile id="fileInputEdit" OnChange="UploadPhoto" accept=".jpg,.jpeg,.png" style="display: none;" />
                        </div>
                    }
                </MudPaper>

                <!-- DATOS PERSONALES M3 -->
                <MudPaper Elevation="0" Class="pa-8 mb-6 rounded-xxl m3-section-card" Style="background-color: var(--mud-palette-surface);">
                    <div class="d-flex align-center mb-6">
                        <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="background-color: rgba(245,158,11,0.15); color: #f59e0b;" Class="mr-3 rounded-lg">
                            <MudIcon Icon="@Icons.Material.Filled.Face" />
                        </MudAvatar>
                        <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">Datos Personales</MudText>
                    </div>
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Nombre(s)*" @bind-Value="StudentToEdit.Name" Required="true" Variant="Variant.Outlined" Class="modern-input" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Apellido Paterno*" @bind-Value="StudentToEdit.PaternalLastName" Required="true" Variant="Variant.Outlined" Class="modern-input" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Apellido Materno" @bind-Value="StudentToEdit.MaternalLastName" Variant="Variant.Outlined" Class="modern-input" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudDatePicker T="DateTime?" Label="Fecha de Nacimiento" @bind-Date="FechaNacimiento" Variant="Variant.Outlined" Editable="true" Mask="@(new DateMask("dd/MM/yyyy"))" DateFormat="dd/MM/yyyy" Class="modern-input" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="Teléfono" @bind-Value="StudentToEdit.Phone" Variant="Variant.Outlined" Mask="@(new PatternMask("0000000000"))" Class="modern-input" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <!-- DIRECCIÓN M3 -->
                <MudPaper Elevation="0" Class="pa-8 mb-6 rounded-xxl m3-section-card" Style="background-color: var(--mud-palette-surface);">
                    <div class="d-flex align-center mb-6">
                        <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="background-color: rgba(236,72,153,0.15); color: #ec4899;" Class="mr-3 rounded-lg">
                            <MudIcon Icon="@Icons.Material.Filled.Home" />
                        </MudAvatar>
                        <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">Dirección</MudText>
                    </div>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="Calle" @bind-Value="StudentToEdit.Address!.Street" Variant="Variant.Outlined" Class="modern-input" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudTextField T="string" Label="Num. Ext/Int" @bind-Value="StudentToEdit.Address!.ExtNumber" Variant="Variant.Outlined" Class="modern-input" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudTextField T="string" Label="Código Postal" @bind-Value="StudentToEdit.Address!.ZipCode" Variant="Variant.Outlined" Class="modern-input" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="Colonia" @bind-Value="StudentToEdit.Address!.Neighborhood" Variant="Variant.Outlined" Class="modern-input" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="Municipio / Alcaldía" @bind-Value="StudentToEdit.Address!.Municipality" Variant="Variant.Outlined" Class="modern-input" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <!-- DATOS DEL TUTOR M3 -->
                <MudPaper Elevation="0" Class="pa-8 rounded-xxl m3-section-card" Style="background-color: var(--mud-palette-surface);">
                    <div class="d-flex align-center mb-6">
                        <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="background-color: rgba(139,92,246,0.15); color: #8b5cf6;" Class="mr-3 rounded-lg">
                            <MudIcon Icon="@Icons.Material.Filled.FamilyRestroom" />
                        </MudAvatar>
                        <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">Datos del Tutor (Contacto de Emergencia)</MudText>
                    </div>
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Nombre(s) del Tutor" @bind-Value="StudentToEdit.Guardian!.Name" Variant="Variant.Outlined" Class="modern-input" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Apellidos" @bind-Value="StudentToEdit.Guardian!.PaternalLastName" Variant="Variant.Outlined" Class="modern-input" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Parentesco" @bind-Value="StudentToEdit.Guardian!.Relationship" Variant="Variant.Outlined" Class="modern-input" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="Teléfono Tutor" @bind-Value="StudentToEdit.Guardian!.Phone" Variant="Variant.Outlined" Mask="@(new PatternMask("0000000000"))" Class="modern-input" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="Correo Electrónico" @bind-Value="StudentToEdit.Guardian!.Email" Variant="Variant.Outlined" InputType="InputType.Email" Class="modern-input" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>

            </MudForm>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <div class="px-6 pb-6 pt-2 w-100 d-flex justify-end gap-3" style="border-top: 1px solid var(--mud-palette-lines-default);">
            <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Default" Class="rounded-xl font-weight-bold px-6 py-2" Style="text-transform: none;">Cancelar</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Class="rounded-xl font-weight-bold px-8 py-2 btn-vivid" Style="text-transform: none; color: white;">Guardar Cambios</MudButton>
        </div>
    </DialogActions>
</MudDialog>

<style>
    /* Efecto Flotante M3 */
    .m3-section-card {
        border: 1px solid var(--mud-palette-lines-default);
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05);
        transition: transform 0.3s ease, background-color 0.3s ease, border-color 0.3s ease;
    }

    /* Inputs adaptables nativamente al Modo Oscuro */
    .modern-input .mud-input-outlined-border {
        border: 2px solid transparent !important;
        transition: all 0.3s ease-in-out;
    }
    .modern-input .mud-input {
        background-color: var(--mud-palette-background) !important;
        border-radius: 16px !important;
        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
    }
    .modern-input .mud-input.mud-input-focused {
        background-color: var(--mud-palette-surface) !important;
        transform: scale(1.02) translateY(-2px);
        box-shadow: 0 10px 20px -5px rgba(59, 130, 246, 0.15) !important;
    }
    .modern-input .mud-input.mud-input-focused .mud-input-outlined-border {
        border-color: var(--mud-palette-primary) !important;
        background-color: transparent !important;
    }

    /* Botón Vívido */
    .btn-vivid {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%) !important;
        transition: all 0.3s ease !important;
    }
    .btn-vivid:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.3) !important;
    }
</style>

@code {
    [CascadingParameter] 
    public IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] 
    public Student StudentToEdit { get; set; } = new();

    private MudForm form = default!;
    private bool isCameraOpen = false;

    private DateTime? FechaNacimiento
    {
        get => StudentToEdit.DateOfBirth?.ToDateTime();
        set => StudentToEdit.DateOfBirth = value.HasValue ? Timestamp.FromDateTime(value.Value.ToUniversalTime()) : null;
    }

    protected override void OnParametersSet()
    {
        StudentToEdit.Address ??= new();
        StudentToEdit.Guardian ??= new();
    }

    /* --- LÓGICA DE FOTOGRAFÍA --- */
    private async Task AbrirCamara()
    {
        isCameraOpen = true;
        StateHasChanged();
        await Task.Delay(100); 
        await JSRuntime.InvokeVoidAsync("cameraHelper.startCamera", "cameraVideoEdit");
    }

    private async Task CapturarFoto()
    {
        try
        {
            Snackbar.Add("Procesando imagen...", Severity.Info);
            var base64 = await JSRuntime.InvokeAsync<string>("cameraHelper.takeSnapshot", "cameraVideoEdit");
            StudentToEdit.PhotoBase64 = base64;
            await CerrarCamara();
            Snackbar.Add("¡Fotografía actualizada con éxito!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al tomar la foto: {ex.Message}", Severity.Error);
            await CerrarCamara();
        }
    }

    private async Task CerrarCamara()
    {
        await JSRuntime.InvokeVoidAsync("cameraHelper.stopCamera");
        isCameraOpen = false;
        StateHasChanged();
    }

    private async Task UploadPhoto(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            var buffer = memoryStream.ToArray();
            
            StudentToEdit.PhotoBase64 = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
            StateHasChanged();
        }
    }

    /* --- GUARDAR EXPEDIENTE --- */
    private async Task Save()
    {
        await form.ValidateAsync();
        if (form.IsValid)
        {
            await Firebase.UpdateStudentAsync(StudentToEdit);
            Snackbar.Add("Expediente actualizado exitosamente", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
@page "/alumnos"
@rendermode RenderMode.InteractiveServer
@using MudBlazor
@using System.IO
@using EscuelaManagement.Data.Models
@using EscuelaManagement.Data.Services
@using QuestPDF.Fluent
@inject FirebaseService Firebase
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-6 pb-12" Style="min-height: 100vh;">
    
    <!-- ENCABEZADO M3 EXPRESSIVE -->
    <div class="mb-8 d-flex align-center gap-4 fade-in-suave">
        <MudAvatar Size="Size.Large" Style="background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%); color: white; width: 64px; height: 64px; box-shadow: 0 10px 15px -3px rgba(139,92,246,0.3);">
            <MudIcon Icon="@Icons.Material.Filled.PeopleAlt" Size="Size.Large" />
        </MudAvatar>
        <div>
            <MudText Typo="Typo.h3" Class="font-weight-bold mb-1" Style="color: var(--mud-palette-text-primary); letter-spacing: -1px;">Gestión y Directorio de Alumnos</MudText>
            <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">Consulta expedientes, edita información y administra el estatus de los alumnos en la institución.</MudText>
        </div>
    </div>

    <!-- PANEL DE FILTROS M3 -->
    <MudPaper Elevation="0" Class="pa-8 mb-8 rounded-xxl m3-section-card fade-in-up" Style="background-color: var(--mud-palette-surface);">
        <MudGrid Class="d-flex align-center">
            <MudItem xs="12" md="6">
                <MudTextField T="string" @bind-Value="filterName" Label="Buscar por nombre o apellidos" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Placeholder="Escribe para buscar..." Class="modern-input" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="string" Label="Filtrar por Curso Inscrito" @bind-Value="filterCourseId" Variant="Variant.Outlined" Clearable="true" Class="modern-input" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var curso in listaCursos) 
                    { 
                        <MudSelectItem T="string" Value="@curso.Id">@curso.Name</MudSelectItem> 
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (isLoading)
    {
        @* EFECTO ESQUELETO MIENTRAS CARGA *@
        <MudPaper Elevation="0" Class="pa-8 rounded-xxl m3-section-card fade-in-suave" Style="background-color: var(--mud-palette-surface);">
            <div class="d-flex justify-space-between mb-6">
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="250px" Height="40px" />
            </div>
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="50px" Class="mb-4 rounded-lg" />
            @for (int i = 0; i < 5; i++)
            {
                <div class="d-flex align-center gap-4 mb-4 mt-4">
                    <MudSkeleton SkeletonType="SkeletonType.Circle" Width="40px" Height="40px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="30%" Height="30px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="25%" Height="30px" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="20%" Height="30px" Class="rounded-lg" />
                </div>
                <MudDivider />
            }
        </MudPaper>
    }
    else
    {
        <div class="fade-in-suave" style="animation-delay: 0.1s;">
            <MudPaper Elevation="0" Class="pa-8 rounded-xxl m3-section-card" Style="background-color: var(--mud-palette-surface);">
                <MudTable T="Student" Items="@AlumnosFiltrados" @bind-SelectedItem="selectedStudent" Hover="true" Elevation="0" Class="modern-table transparent-table">
                    <ToolBarContent>
                        <div class="d-flex align-center">
                            <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="background-color: rgba(139,92,246,0.15); color: #8b5cf6;" Class="mr-3 rounded-lg">
                                <MudIcon Icon="@Icons.Material.Filled.ContactPage" />
                            </MudAvatar>
                            <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">Registros Encontrados (@AlumnosFiltrados.Count())</MudText>
                        </div>
                        <MudSpacer />
                        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);"><i>*Haz clic en cualquier fila para ver el expediente completo.</i></MudText>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh Style="width: 50px; text-align:center; border-bottom: 2px solid var(--mud-palette-lines-default);"></MudTh>
                        <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); font-size: 0.75rem; border-bottom: 2px solid var(--mud-palette-lines-default);">Nombre Completo</MudTh>
                        <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); font-size: 0.75rem; border-bottom: 2px solid var(--mud-palette-lines-default);">Tutor / Parentesco</MudTh>
                        <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); font-size: 0.75rem; border-bottom: 2px solid var(--mud-palette-lines-default);">Cursos Inscritos</MudTh>
                        <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); font-size: 0.75rem; text-align: center; border-bottom: 2px solid var(--mud-palette-lines-default);">Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="alumnoRow">
                        <MudTd style="text-align: center; cursor: pointer;">
                            <MudIcon Icon="@(selectedStudent?.Id == alumnoRow?.Id ? Icons.Material.Filled.KeyboardArrowDown : Icons.Material.Filled.KeyboardArrowRight)" Color="Color.Primary" />
                        </MudTd>
                        <MudTd DataLabel="Nombre Completo" Style="cursor: pointer;">
                            <MudText Typo="Typo.body1" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary);">@(alumnoRow?.Name) @(alumnoRow?.PaternalLastName) @(alumnoRow?.MaternalLastName)</MudText>
                        </MudTd>
                        <MudTd DataLabel="Tutor" Style="cursor: pointer;">
                            <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">@(alumnoRow?.Guardian?.Name ?? "Sin tutor registrado")</MudText>
                        </MudTd>
                        <MudTd DataLabel="Cursos">
                            @foreach (var curso in ObtenerCursosDeAlumno(alumnoRow?.Id ?? ""))
                            {
                                <MudChip @key="curso" T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled" Class="font-weight-bold shadow-sm rounded-lg">@curso</MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Acciones" Style="text-align: center;">
                            @{
                                var cursosDelAlumno = ObtenerCursosCompletosDeAlumno(alumnoRow?.Id ?? "");
                                if (cursosDelAlumno.Count == 0)
                                {
                                    <MudTooltip Text="Sin cursos inscritos">
                                        <MudIconButton Icon="@Icons.Material.Filled.PrintDisabled" Disabled="true" Size="Size.Small" Class="rounded-lg" />
                                    </MudTooltip>
                                }
                                else if (cursosDelAlumno.Count == 1)
                                {
                                    <MudTooltip Text="Reimprimir Ficha de Inscripción" Arrow="true" Placement="Placement.Top">
                                        <MudIconButton Icon="@Icons.Material.Filled.Print" Color="Color.Info" Size="Size.Small" OnClick="() => ReimprimirFicha(alumnoRow!, cursosDelAlumno.First())" Class="rounded-lg action-btn" />
                                    </MudTooltip>
                                }
                                else
                                {
                                    <MudMenu Icon="@Icons.Material.Filled.Print" Color="Color.Info" Size="Size.Small" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Tooltip="Reimprimir Fichas" Class="rounded-lg action-btn">
                                        <div class="pa-2">
                                            <MudText Typo="Typo.caption" Class="font-weight-bold px-2" Color="Color.Primary">Imprimir ficha de:</MudText>
                                            @foreach (var curso in cursosDelAlumno)
                                            {
                                                <MudMenuItem OnClick="() => ReimprimirFicha(alumnoRow!, curso)">
                                                    <div class="d-flex align-center gap-2">
                                                        <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small" Color="Color.Error" />
                                                        <MudText Typo="Typo.body2">@curso.Name</MudText>
                                                    </div>
                                                </MudMenuItem>
                                            }
                                        </div>
                                    </MudMenu>
                                }
                            }
                        </MudTd>
                    </RowTemplate>
                    
                    <ChildRowContent Context="alumnoRow">
                        <MudTr Style="@(selectedStudent?.Id == alumnoRow?.Id ? "" : "display: none;")">
                            <td colspan="5" style="padding: 16px 24px; background-color: var(--mud-palette-background); border-bottom: none;">
                                <MudPaper Elevation="0" Class="pa-8 rounded-xxl my-2 m3-section-card" Style="background-color: var(--mud-palette-surface);">
                                    <MudGrid>
                                        <!-- FOTO DEL ALUMNO -->
                                        <MudItem xs="12" sm="3" Class="d-flex justify-center align-center">
                                            @if (!string.IsNullOrEmpty(alumnoRow?.PhotoBase64))
                                            {
                                                <MudImage Src="@alumnoRow!.PhotoBase64" Width="160" Height="160" ObjectFit="ObjectFit.Cover" Elevation="4" Class="rounded-xxl" Style="border: 4px solid var(--mud-palette-background);" />
                                            }
                                            else
                                            {
                                                <MudPaper Width="160px" Height="160px" Class="d-flex align-center justify-center rounded-xxl" Elevation="0" Style="border: 2px dashed var(--mud-palette-lines-default); background-color: var(--mud-palette-background);">
                                                    <MudIcon Icon="@Icons.Material.Filled.PersonOutline" Style="font-size: 5rem; color: var(--mud-palette-text-disabled);" />
                                                </MudPaper>
                                            }
                                        </MudItem>

                                        <!-- INFORMACIÓN DETALLADA -->
                                        <MudItem xs="12" sm="5">
                                            <MudText Typo="Typo.h6" Color="Color.Primary" Class="font-weight-bold mb-4">Expediente Detallado</MudText>
                                            
                                            <MudText Typo="Typo.body2" Class="mb-2" Style="color: var(--mud-palette-text-primary);">
                                                <b style="color: var(--mud-palette-text-secondary);">Dirección:</b> @(alumnoRow?.Address?.Street ?? "") @(alumnoRow?.Address?.ExtNumber ?? ""), Col. @(alumnoRow?.Address?.Neighborhood ?? ""), @(alumnoRow?.Address?.Municipality ?? "")
                                            </MudText>
                                            <MudText Typo="Typo.body2" Class="mb-2" Style="color: var(--mud-palette-text-primary);"><b style="color: var(--mud-palette-text-secondary);">Código Postal:</b> @(alumnoRow?.Address?.ZipCode ?? "N/A")</MudText>
                                            <MudText Typo="Typo.body2" Class="mb-2" Style="color: var(--mud-palette-text-primary);">
                                                <b style="color: var(--mud-palette-text-secondary);">Fecha de Nacimiento:</b> @(alumnoRow?.DateOfBirth.HasValue == true ? alumnoRow!.DateOfBirth.Value.ToDateTime().ToString("dd/MM/yyyy") : "No registrada")
                                            </MudText>
                                            <MudText Typo="Typo.body2" Class="mb-4" Style="color: var(--mud-palette-text-primary);"><b style="color: var(--mud-palette-text-secondary);">Teléfono Alumno:</b> @(alumnoRow?.Phone ?? "No registrado")</MudText>
                                            
                                            <MudDivider Class="my-4" Style="opacity: 0.5;" />
                                            
                                            <MudText Typo="Typo.body2" Class="mb-2" Style="color: var(--mud-palette-text-primary);">
                                                <b style="color: var(--mud-palette-text-secondary);">Contacto de Emergencia:</b> @(alumnoRow?.Guardian?.Name ?? "") @(alumnoRow?.Guardian?.PaternalLastName ?? "") 
                                                <span style="opacity: 0.7; color: var(--mud-palette-primary);">(@(alumnoRow?.Guardian?.Relationship ?? "N/A"))</span>
                                            </MudText>
                                            <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-primary);"><b style="color: var(--mud-palette-text-secondary);">Teléfono Tutor:</b> @(alumnoRow?.Guardian?.Phone ?? "No registrado")</MudText>
                                        </MudItem>

                                        <!-- BOTONES DE ACCIÓN -->
                                        <MudItem xs="12" sm="4" Class="d-flex flex-column justify-center gap-4" Style="border-left: 2px dashed var(--mud-palette-lines-default); padding-left: 32px;">
                                            <MudButton Variant="Variant.Filled" Color="Color.Warning" DisableElevation="true" StartIcon="@Icons.Material.Filled.Edit" FullWidth="true" Class="rounded-xl font-weight-bold py-3 hover-lift" Style="text-transform: none; color: white;" OnClick="() => EditarExpediente(alumnoRow!)">Editar Expediente</MudButton>
                                            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.PersonRemove" FullWidth="true" Class="rounded-xl font-weight-bold py-3 hover-lift" Style="text-transform: none; border-width: 2px;" OnClick="() => ConfirmarBaja(alumnoRow!)">Dar de Baja</MudButton>
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            </td>
                        </MudTr>
                    </ChildRowContent>

                    @* ESTADO VACÍO *@
                    <NoRecordsContent>
                        <div class="d-flex flex-column align-center justify-center pa-12 fade-in-suave">
                            <MudIcon Icon="@Icons.Material.Filled.GroupAdd" Color="Color.Primary" Style="font-size: 6rem; opacity: 0.3;" Class="mb-4" />
                            <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-2 font-weight-bold">Aún no hay registros</MudText>
                            <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">No encontramos alumnos que coincidan con tu búsqueda.</MudText>
                        </div>
                    </NoRecordsContent>

                    @* PAGINACIÓN *@
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" RowsPerPageString="Alumnos por página:" InfoFormat="{first_item}-{last_item} de {all_items}" />
                    </PagerContent>
                </MudTable>
            </MudPaper>
        </div>
    }

    <MudMessageBox @ref="mbox" Title="Confirmar Baja del Alumno">
        <MessageContent>
            ¿Estás seguro de que deseas dar de baja a "<b>@(alumnoABorrar?.Name) @(alumnoABorrar?.PaternalLastName)</b>"? <br /> <br /> Esta acción eliminará su expediente de los servidores de manera permanente.
        </MessageContent>
        <YesButton><MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever" Class="rounded-xl px-6 py-2 font-weight-bold" Style="text-transform: none;">Eliminar Expediente</MudButton></YesButton>
        <CancelButton><MudButton Variant="Variant.Text" Color="Color.Default" Class="rounded-xl px-4 py-2 font-weight-bold" Style="text-transform: none;">Cancelar</MudButton></CancelButton>
    </MudMessageBox>
</MudContainer>

<style>
    /* Efecto Flotante M3 */
    .m3-section-card {
        border: 1px solid var(--mud-palette-lines-default);
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05);
        transition: transform 0.3s ease, background-color 0.3s ease, border-color 0.3s ease;
    }
    .m3-section-card:hover {
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.08);
    }

    /* Inputs adaptables nativamente al Modo Oscuro */
    .modern-input .mud-input-outlined-border {
        border: 2px solid transparent !important;
        transition: all 0.3s ease-in-out;
    }
    .modern-input .mud-input {
        background-color: var(--mud-palette-background) !important;
        border-radius: 16px !important;
        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
    }
    .modern-input .mud-input.mud-input-focused {
        background-color: var(--mud-palette-surface) !important;
        transform: scale(1.02) translateY(-2px);
        box-shadow: 0 10px 20px -5px rgba(59, 130, 246, 0.15) !important;
    }
    .modern-input .mud-input.mud-input-focused .mud-input-outlined-border {
        border-color: var(--mud-palette-primary) !important;
        background-color: transparent !important;
    }

    /* Estilos limpios para la tabla */
    .transparent-table { background-color: transparent !important; }
    .modern-table .mud-table-cell {
        border-bottom: 1px solid var(--mud-palette-lines-default) !important;
        padding: 18px 16px !important;
    }
    .modern-table .mud-table-root { border: none !important; }

    /* Botones de acción y animaciones */
    .action-btn {
        background-color: var(--mud-palette-background);
        transition: all 0.2s ease;
    }
    .action-btn:hover { transform: scale(1.1); }
    
    .hover-lift { transition: all 0.3s ease; }
    .hover-lift:hover { transform: translateY(-3px); box-shadow: 0 10px 20px -5px rgba(0,0,0,0.15); }
</style>

@code {
    private MudMessageBox mbox = default!;
    private Student? alumnoABorrar;
    private Student? selectedStudent;
    private List<Student> listaAlumnos = new();
    private List<Course> listaCursos = new();
    private List<Enrollment> listaInscripciones = new();
    private ConfiguracionEscuela configuracionEscuela = new();
    private bool isLoading = true;
    private string filterName = "";
    private string filterCourseId = "";

    protected override async Task OnInitializedAsync()
    {
        QuestPDF.Settings.License = QuestPDF.Infrastructure.LicenseType.Community;
        await RecargarDatosDirectorio();
    }

    private async Task RecargarDatosDirectorio()
    {
        isLoading = true;
        StateHasChanged();
        
        configuracionEscuela = await Firebase.GetConfiguracionAsync() ?? new();
        listaAlumnos = await Firebase.GetAllStudentsAsync() ?? new();
        listaCursos = await Firebase.GetCoursesAsync() ?? new();
        listaInscripciones = await Firebase.GetAllEnrollmentsAsync() ?? new();
        
        isLoading = false;
        StateHasChanged();
    }

    private IEnumerable<Student> AlumnosFiltrados => listaAlumnos.Where(s => 
        (string.IsNullOrEmpty(filterName) || $"{s.Name} {s.PaternalLastName} {s.MaternalLastName}".Contains(filterName, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(filterCourseId) || listaInscripciones.Any(i => i.StudentId == s.Id && i.CourseId == filterCourseId)));

    private List<string> ObtenerCursosDeAlumno(string id) => 
        listaCursos.Where(c => listaInscripciones.Any(i => i.StudentId == id && i.CourseId == c.Id)).Select(c => c.Name ?? "").ToList();

    private List<Course> ObtenerCursosCompletosDeAlumno(string id) => 
        listaCursos.Where(c => listaInscripciones.Any(i => i.StudentId == id && i.CourseId == c.Id)).ToList();

    private async Task EditarExpediente(Student alumno)
    {
        var parameters = new DialogParameters<EditStudentDialog> { { x => x.StudentToEdit, alumno } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditStudentDialog>("Editar Expediente", parameters, options);
        if (!(await dialog.Result)!.Canceled) await RecargarDatosDirectorio();
    }

    private async Task ConfirmarBaja(Student alumno)
    {
        alumnoABorrar = alumno;
        if (await mbox.ShowAsync() == true)
        {
            await Firebase.DeleteStudentAsync(alumno.Id);
            Snackbar.Add("Alumno dado de baja exitosamente", Severity.Success);
            selectedStudent = null;
            await RecargarDatosDirectorio();
        }
    }

    // --- LÓGICA DE REIMPRESIÓN DE FICHA Y PÓLIZA ---
    private async Task ReimprimirFicha(Student alumno, Course curso)
    {
        try
        {
            Snackbar.Add($"Preparando ficha de inscripción para {curso.Name}...", Severity.Info);
            
            var enrollment = listaInscripciones.FirstOrDefault(e => e.StudentId == alumno.Id && e.CourseId == curso.Id);
            if (enrollment == null)
            {
                Snackbar.Add("No se encontraron los datos financieros de esta inscripción.", Severity.Warning);
                return;
            }

            var pdfBytes = GenerarFichaPdf(alumno, curso, enrollment);
            await DescargarPdf(pdfBytes, $"Ficha_Inscripcion_{alumno.Name}.pdf");
            Snackbar.Add("Ficha descargada con éxito.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al generar la ficha: {ex.Message}", Severity.Error);
        }
    }

    private byte[] GenerarFichaPdf(Student student, Course currentCourse, Enrollment enrollment)
    {
        string turnoFinal = enrollment?.Turno ?? "No asignado";
        var base64Watermark = "";
        var base64Logo = "";
        byte[]? logoBytes = null;
        byte[]? watermarkBytes = null;

        if (!string.IsNullOrEmpty(configuracionEscuela.LogoBase64))
        {
            try
            {
                base64Logo = configuracionEscuela.LogoBase64.Contains(",") ? configuracionEscuela.LogoBase64.Substring(configuracionEscuela.LogoBase64.IndexOf(",") + 1) : configuracionEscuela.LogoBase64;
                base64Watermark = base64Logo; 
                logoBytes = Convert.FromBase64String(base64Logo);
                watermarkBytes = Convert.FromBase64String(base64Watermark);
            }
            catch { }
        }

        return Document.Create(container =>
        {
            // ==========================================
            // PÁGINA 1: FICHA DE INSCRIPCIÓN Y AUTORIZACIÓN
            // ==========================================
            container.Page(page =>
            {
                page.Size(QuestPDF.Helpers.PageSizes.Letter);
                page.Margin(2, QuestPDF.Infrastructure.Unit.Centimetre);
                page.PageColor(QuestPDF.Helpers.Colors.White);
                page.DefaultTextStyle(x => x.FontSize(10).FontFamily("Arial"));

                if (watermarkBytes != null)
                {
                    page.Background().AlignCenter().AlignMiddle().Width(350).Image(watermarkBytes);
                }

                page.Header().Row(row =>
                {
                    if (logoBytes != null)
                    {
                        row.ConstantItem(100).Image(logoBytes);
                        row.ConstantItem(15);
                    }

                    row.RelativeItem().Column(col =>
                    {
                        col.Item().Text(configuracionEscuela.NombreEscuela).SemiBold().FontSize(18).FontColor(QuestPDF.Helpers.Colors.Blue.Darken2);
                        col.Item().Text("FICHA DE INSCRIPCIÓN").Bold().FontSize(12).FontColor(QuestPDF.Helpers.Colors.Grey.Darken3);
                        col.Item().Text($"Fecha de registro: {DateTime.Now:dd/MM/yyyy}").FontSize(9);
                    });

                    if (!string.IsNullOrEmpty(student.PhotoBase64))
                    {
                        try
                        {
                            var base64Data = student.PhotoBase64.Contains(",") ? student.PhotoBase64.Substring(student.PhotoBase64.IndexOf(",") + 1) : student.PhotoBase64;
                            row.ConstantItem(65).Image(Convert.FromBase64String(base64Data));
                        }
                        catch { }
                    }
                });

                page.Content().PaddingVertical(1, QuestPDF.Infrastructure.Unit.Centimetre).Column(x =>
                {
                    x.Spacing(10);
                    
                    x.Item().Background(QuestPDF.Helpers.Colors.Grey.Lighten3).Padding(5).Text("1. Datos del Alumno").SemiBold();
                    x.Item().Text($"Nombre: {student.Name} {student.PaternalLastName} {student.MaternalLastName}");
                    x.Item().Text($"Teléfono Alumno: {(string.IsNullOrEmpty(student.Phone) ? "No registrado" : student.Phone)}");
                    x.Item().Text($"Escuela de Procedencia: {(string.IsNullOrEmpty(student.PreviousSchool) ? "No registrado" : student.PreviousSchool)}");
                    
                    x.Item().Background(QuestPDF.Helpers.Colors.Grey.Lighten3).Padding(5).Text("2. Tutor y Contacto").SemiBold();
                    x.Item().Text($"Tutor: {student.Guardian?.Name} {student.Guardian?.PaternalLastName} ({student.Guardian?.Relationship})");
                    x.Item().Text($"Teléfono Tutor: {(string.IsNullOrEmpty(student.Guardian?.Phone) ? "No registrado" : student.Guardian?.Phone)}");

                    x.Item().Background(QuestPDF.Helpers.Colors.Grey.Lighten3).Padding(5).Text("3. Dirección").SemiBold();
                    x.Item().Text($"{student.Address?.Street} {student.Address?.ExtNumber}, Col. {student.Address?.Neighborhood}, {student.Address?.Municipality}. CP: {student.Address?.ZipCode}");

                    x.Item().Background(QuestPDF.Helpers.Colors.Grey.Lighten3).Padding(5).Text("4. Curso Inscrito y Plan Financiero").SemiBold();
                    var nombreCurso = currentCourse?.Name ?? "No seleccionado";
                    x.Item().Text($"Curso: {nombreCurso} | Turno: {(string.IsNullOrEmpty(turnoFinal) ? "No asignado" : turnoFinal.ToUpper())}");
                    
                    if(enrollment != null)
                    {
                        x.Item().Text($"Esquema: {enrollment.TipoPlazo} | Plazos: {enrollment.NumeroPlazos} | Pago pactado: {enrollment.MontoPlazo.ToString("C")}");
                        x.Item().Text($"Descuento Aplicado: {enrollment.DiscountAmount}%");
                    }

                    x.Item().PaddingTop(30).Background(QuestPDF.Helpers.Colors.Grey.Lighten3).Padding(5).AlignCenter().Text("AUTORIZACIÓN DE RETIRO").SemiBold();
                    x.Item().PaddingTop(10).Text($"Yo, autorizo que mi alumno(a): {student.Name} {student.PaternalLastName} {student.MaternalLastName} pueda retirarse de la institución sin que acuda alguna persona mayor de edad a recogerlo al plantel, deslindando de toda responsabilidad a UPASER después del horario de salida.").FontSize(9);
                    
                    x.Item().PaddingTop(40).AlignCenter().Column(c =>
                    {
                        c.Item().Width(200).LineHorizontal(1).LineColor(QuestPDF.Helpers.Colors.Black);
                        c.Item().PaddingTop(5).Text("Firma del Padre o Tutor").FontSize(9).Bold().AlignCenter();
                    });
                });
                
                page.Footer().AlignCenter().Text(x => { x.Span("Página "); x.CurrentPageNumber(); x.Span(" de "); x.TotalPages(); });
            });

            // ==========================================
            // PÁGINA 2 Y 3: CONDICIONADAS SI SE ACEPTÓ LA PÓLIZA
            // ==========================================
            if (enrollment != null && enrollment.AceptaPolizaGarantia) 
            {
                // --- PÁGINA 2: PÓLIZA DE GARANTÍA ---
                container.Page(page =>
                {
                    page.Size(QuestPDF.Helpers.PageSizes.Letter);
                    page.Margin(2, QuestPDF.Infrastructure.Unit.Centimetre);
                    page.PageColor(QuestPDF.Helpers.Colors.White);
                    page.DefaultTextStyle(x => x.FontSize(9).FontFamily("Arial"));

                    if (watermarkBytes != null) page.Background().AlignCenter().AlignMiddle().Width(350).Image(watermarkBytes);

                    page.Header().Row(row =>
                    {
                        if (logoBytes != null) { row.ConstantItem(100).Image(logoBytes); row.ConstantItem(15); }
                        row.RelativeItem().Column(col =>
                        {
                            col.Item().Text(configuracionEscuela.NombreEscuela).SemiBold().FontSize(18).FontColor(QuestPDF.Helpers.Colors.Blue.Darken2);
                        });
                    });
                    
                    page.Content().PaddingVertical(1, QuestPDF.Infrastructure.Unit.Centimetre).Column(x =>
                    {
                        x.Spacing(6);
                        
                        x.Item().PaddingBottom(10).AlignCenter().Text("PÓLIZA DE GARANTÍA").Bold().FontSize(14).FontColor(QuestPDF.Helpers.Colors.Blue.Darken2);
                        
                        x.Item().Text("DERECHOS").SemiBold().FontSize(10).FontColor(QuestPDF.Helpers.Colors.Grey.Darken3);
                        x.Item().Text("a) Recibir sus clases conforme lo señale su horario y fecha de evaluación.");
                        x.Item().Text("b) Conocer anticipadamente temarios, formas de trabajo y criterios de evaluación de cada una de las asignaturas.");
                        x.Item().Text("c) Ser tratado por sus docentes y autoridades educativas con cortesía, respeto y amabilidad.");
                        
                        x.Item().PaddingTop(8).Text("OBLIGACIONES").SemiBold().FontSize(10).FontColor(QuestPDF.Helpers.Colors.Grey.Darken3);
                        x.Item().Text("a) Asistir a sus clases conforme al horario establecido, teniendo como margen de tiempo 10 min. Después de haber iniciado la clase, dos retardos equivalen a una falta.");
                        x.Item().Text("b) Respetar el tiempo de receso otorgado (30 min.).");
                        x.Item().Text("c) Ser respetuoso con sus compañeros, docentes y personal en general.");
                        x.Item().Text("d) Mantener orden y disciplina.");
                        x.Item().Text("e) Cumplir con tareas e investigaciones encomendados.");
                        x.Item().Text("f) Conservar y cuidar la institución.");
                        x.Item().Text("g) Cumplir en tiempo y forma con los pagos estipulados.");
                        x.Item().Text("El incumplimiento de cualquiera de las obligaciones es motivo de la perdida de garantía.").Italic();

                        x.Item().PaddingTop(8).Text("ANULACIÓN DE LA GARANTÍA").SemiBold().FontSize(10).FontColor(QuestPDF.Helpers.Colors.Grey.Darken3);
                        x.Item().Text("• Tener menos del 90% de asistencias, tomando en cuenta que por día se pueden ver una o más clases; lo que equivale a una falta por materia.");
                        x.Item().Text("• Tener menos del 90% en entregas de tareas y actividades asignadas por el docente.");
                        x.Item().Text("• No a ver liquidado el total del curso antes de que finalice el mismo.");
                        x.Item().Text("• Tener menos de 80% en las evaluaciones que se harán por parte de UPASER.");
                        
                        x.Item().PaddingTop(4).Text(t =>
                        {
                            t.Span("NOTA. ").Bold();
                            t.Span("El alumno podrá solicitar su garantía siempre y cuando cumpla con los requisitos antes mencionados.");
                        });

                        x.Item().PaddingTop(8).Text("CLAUSULA PARA USO DE MARKETING").SemiBold().FontSize(10).FontColor(QuestPDF.Helpers.Colors.Grey.Darken3);
                        x.Item().Text("El alumno autoriza expresamente a UPASER a captar, reproducir y utilizar su imagen, nombre y/o voz a través de fotografías, grabaciones de video o cualquier otro medio audiovisual, con fines exclusivamente publicitarios, institucionales, informativos y/o académicos relacionados con las actividades de la institución.");
                        x.Item().Text("Dicha autorización se concede de manera gratuita, sin limitación territorial ni temporal, y comprende su difusión en medios digitales, electrónicos y redes sociales oficiales de UPASER, así como en cualquier otra plataforma en línea utilizada por la institución.");

                        x.Item().PaddingTop(40).Row(row =>
                        {
                            row.RelativeItem().AlignCenter().Column(c =>
                            {
                                c.Item().LineHorizontal(1).LineColor(QuestPDF.Helpers.Colors.Black);
                                c.Item().PaddingTop(5).Text("Firma del Padre o Tutor").FontSize(9).Bold().AlignCenter();
                            });
                            row.ConstantItem(50); 
                            row.RelativeItem().AlignCenter().Column(c =>
                            {
                                c.Item().LineHorizontal(1).LineColor(QuestPDF.Helpers.Colors.Black);
                                c.Item().PaddingTop(5).Text("Firma del Alumno").FontSize(9).Bold().AlignCenter();
                            });
                        });
                    });

                    page.Footer().AlignCenter().Text(x => { x.Span("Página "); x.CurrentPageNumber(); x.Span(" de "); x.TotalPages(); });
                });

                // --- PÁGINA 3: TÉRMINOS Y CONDICIONES ---
                container.Page(page =>
                {
                    page.Size(QuestPDF.Helpers.PageSizes.Letter);
                    page.Margin(2, QuestPDF.Infrastructure.Unit.Centimetre);
                    page.PageColor(QuestPDF.Helpers.Colors.White);
                    page.DefaultTextStyle(x => x.FontSize(10).FontFamily("Arial"));

                    if (watermarkBytes != null) page.Background().AlignCenter().AlignMiddle().Width(350).Image(watermarkBytes);

                    page.Header().Row(row =>
                    {
                        if (logoBytes != null) { row.ConstantItem(100).Image(logoBytes); row.ConstantItem(15); }
                        row.RelativeItem().Column(col =>
                        {
                            col.Item().Text(configuracionEscuela.NombreEscuela).SemiBold().FontSize(18).FontColor(QuestPDF.Helpers.Colors.Blue.Darken2);
                        });
                    });
                    
                    page.Content().PaddingVertical(1, QuestPDF.Infrastructure.Unit.Centimetre).Column(x =>
                    {
                        x.Spacing(10);
                        x.Item().PaddingBottom(10).AlignCenter().Text("TÉRMINOS Y CONDICIONES").Bold().FontSize(14).FontColor(QuestPDF.Helpers.Colors.Blue.Darken2);
                        
                        x.Item().Text("Es de suma importancia leer cuidadosamente este apartado antes de iniciar tu curso, para que conozcas tus derechos y obligaciones como alumno UPASER.");
                        
                        x.Item().Text("La Unidad Profesional de Asesoría y Regularización (UPASER) tiene como garantía que el alumno se quede en sus primeras 5 opciones que seleccione en el concurso ECOEMS/103 Municipios/EXAMEN DE INGRESO A UNIVERSIDAD (UNAM, IPN, UAM, UAEMex, ETC), asegurando que nuestro curso es competente bajo nuestro método de enseñanza.");
                        
                        x.Item().Text("Antes de efectuar el pago, el usuario deberá aceptar la Política de Privacidad, una vez confirmado el pago del curso seleccionado por el aspirante este no podrá solicitar reembolso.");

                        x.Item().PaddingTop(10).Text(t =>
                        {
                            t.Span("I. Clases: ").Bold();
                            t.Span("Están sujetas a modificaciones, UPASER se reserva el derecho de cancelar o cambiar cualquier clase, se les notificara a los alumnos o participantes cualquier cambio a través de los grupos de WhatsApp oficiales. UPASER esta obligado a reponer la clase cancelada, si este fuera el caso.");
                        });

                        x.Item().PaddingTop(5).Text(t =>
                        {
                            t.Span("II. Comportamiento: ").Bold();
                            t.Span("UPASER se reserva el derecho de retirar a cualquier persona registrada en el curso, cuyo comportamiento sea considerado inapropiado, por parte de UPASER o sus docentes. En estas circunstancias UPASER no reembolsara ninguna tarifa.");
                        });

                        x.Item().PaddingTop(5).Text(t =>
                        {
                            t.Span("III. Plazo para registrarse: ").Bold();
                            t.Span("Estamos contentos de apoyar a nuestros alumnos con el proceso de registro en las plataformas oficiales COMIPEMS/103 MUNICIPIOS, sin embargo, es responsabilidad total del aspirante. En caso de que el aspirante no se registre en las fechas que la convocatoria este abierta no habrá ningún tipo de reembolso por el pago efectuado al curso de capacitación.");
                        });

                        x.Item().PaddingTop(5).Text(t =>
                        {
                            t.Span("IV. Talleres opcionales: ").Bold();
                            t.Span("UPASER programara talleres a lo largo del curso de capacitación, estos talleres son considerados un plus CON COSTO para cualquier alumno UPASER.");
                        });

                        x.Item().PaddingTop(70).Row(row =>
                        {
                            row.RelativeItem().AlignCenter().Column(c =>
                            {
                                c.Item().LineHorizontal(1).LineColor(QuestPDF.Helpers.Colors.Black);
                                c.Item().PaddingTop(5).Text("Firma del Padre o Tutor").FontSize(9).Bold().AlignCenter();
                            });
                            row.ConstantItem(50); 
                            row.RelativeItem().AlignCenter().Column(c =>
                            {
                                c.Item().LineHorizontal(1).LineColor(QuestPDF.Helpers.Colors.Black);
                                c.Item().PaddingTop(5).Text("Firma del Alumno").FontSize(9).Bold().AlignCenter();
                            });
                        });
                    });

                    page.Footer().AlignCenter().Text(x => { x.Span("Página "); x.CurrentPageNumber(); x.Span(" de "); x.TotalPages(); });
                });
            }
        }).GeneratePdf();
    }

    private async Task DescargarPdf(byte[] bytes, string fileName)
    {
        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JSRuntime.InvokeVoidAsync("descargarArchivoPdf", fileName, streamRef);
    }
}
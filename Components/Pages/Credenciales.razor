@page "/credenciales"
@rendermode RenderMode.InteractiveServer
@using MudBlazor
@using System.IO
@using EscuelaManagement.Data.Models
@using EscuelaManagement.Data.Services
@using QuestPDF.Fluent

@inject FirebaseService Firebase
@inject PdfService Pdf
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-8">
    <MudText Typo="Typo.h4" GutterBottom="true" Color="MudBlazor.Color.Primary">Módulo de Credenciales</MudText>
    <MudText Typo="Typo.subtitle1" Class="mb-6 text-muted">Diseño y emisión de identificaciones PVC con calibración milimétrica.</MudText>

    <MudTabs Elevation="3" Rounded="true" ApplyEffectsToContainer="true" Color="MudBlazor.Color.Primary">
        
        @* --- PESTAÑA 1: EMISIÓN INDIVIDUAL --- *@
        <MudTabPanel Text="Emisión Individual" Icon="@Icons.Material.Filled.Badge" Class="pa-6">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="Student" Label="1. Seleccionar Alumno" Value="selectedStudent" ValueChanged="OnStudentSelected"
                                     SearchFunc="@SearchStudents" ToStringFunc="@DisplayAlumno"
                                     Variant="Variant.Outlined" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true"/>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="cursoInput" Label="Curso Asignado (Automático)" Variant="Variant.Outlined" ReadOnly="true"/>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="matriculaInput" Label="Matrícula" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="vigenciaInput" Label="Vigencia" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="directorInput" Label="Nombre del Director" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
            <MudDivider Class="my-6" />
            <div class="d-flex justify-end">
                <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Large" StartIcon="@Icons.Material.Filled.Download" OnClick="GenerarPDF" Disabled="@(selectedStudent == null)">
                    DESCARGAR PDF PVC
                </MudButton>
            </div>
        </MudTabPanel>

        @* --- PESTAÑA 2: EMISIÓN EN LOTE (HORIZONTAL) --- *@
        <MudTabPanel Text="Emisión en Lote" Icon="@Icons.Material.Filled.PeopleAlt" Class="pa-6">
            <MudAlert Severity="Severity.Info" Class="mb-4">
                El sistema generará el <b>Anverso y Reverso</b> en formato Horizontal (8.6cm x 5.4cm) con todos los encabezados (Curso, Vigencia, Director).
            </MudAlert>

            <MudGrid Class="mb-4">
                <MudItem xs="12" md="6">
                    <MudTextField T="string" @bind-Value="searchStringLote" Label="Buscar por nombre..." Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Filtrar por Curso" @bind-Value="filterCourseIdLote" Variant="Variant.Outlined" Clearable="true">
                        @foreach (var curso in listaCursos) 
                        { 
                            <MudSelectItem T="string" Value="@curso.Id">@curso.Name</MudSelectItem> 
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <MudTable T="AlumnoCredencialVM" Items="@AlumnosFiltradosLote" MultiSelection="true" @bind-SelectedItems="alumnosSeleccionados" Hover="true" Striped="true" Elevation="1">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Alumnos Disponibles para Imprimir</MudText>
                    <MudSpacer />
                    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Success" StartIcon="@Icons.Material.Filled.Print" Disabled="@(!alumnosSeleccionados.Any() || generandoPdfLote)" OnClick="GenerarPDFLote">
                        @if (generandoPdfLote)
                        {
                            <MudProgressCircular Size="MudBlazor.Size.Small" Indeterminate="true" Class="mr-2"/>
                            <span>PROCESANDO...</span>
                        }
                        else
                        {
                            <span>GENERAR @alumnosSeleccionados.Count() CREDENCIALES</span>
                        }
                    </MudButton>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Foto</MudTh>
                    <MudTh>Nombre del Alumno</MudTh>
                    <MudTh>Curso</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Foto">
                        @if (!string.IsNullOrEmpty(context.Student.PhotoBase64))
                        {
                            <MudAvatar Size="MudBlazor.Size.Medium">
                                <MudImage Src="@context.Student.PhotoBase64" ObjectFit="ObjectFit.Cover" Width="40" Height="40" />
                            </MudAvatar>
                        }
                        else
                        {
                            <MudAvatar Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Medium">@((context.Student.Name ?? "U").Substring(0, 1))</MudAvatar>
                        }
                    </MudTd>
                    <MudTd DataLabel="Nombre"><b>@context.Student.Name @context.Student.PaternalLastName</b></MudTd>
                    <MudTd DataLabel="Curso">
                        <MudChip T="string" Color="MudBlazor.Color.Info" Size="MudBlazor.Size.Small">@context.CourseName</MudChip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Align="Align.Center" Class="pa-4">No se encontraron alumnos con los filtros actuales.</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" RowsPerPageString="Filas:" />
                </PagerContent>
            </MudTable>
        </MudTabPanel>

        @* --- PESTAÑA 3: DISEÑADOR (HORIZONTAL 86x54 mm) --- *@
        <MudTabPanel Text="Configurar Plantilla" Icon="@Icons.Material.Filled.Architecture" Class="pa-6">
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.h6" Class="mb-4" Color="MudBlazor.Color.Secondary">Calibración (mm)</MudText>
                    
                    <MudExpansionPanels MultiExpansion="true">
                        <MudExpansionPanel Text="Fotografía (Anverso)" Expanded="true">
                            <MudNumericField @bind-Value="diseno.FotoX" Label="X (Izq)" Format="0.0" Step="0.5f" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudNumericField @bind-Value="diseno.FotoY" Label="Y (Arriba)" Format="0.0" Step="0.5f" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudNumericField @bind-Value="diseno.FotoW" Label="Ancho" Format="0.0" Step="0.5f" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudNumericField @bind-Value="diseno.FotoH" Label="Alto" Format="0.0" Step="0.5f" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudExpansionPanel>
                        
                        <MudExpansionPanel Text="Textos Frente">
                            <MudNumericField @bind-Value="diseno.NombreX" Label="Nombre X" Format="0.0" Step="0.5f" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudNumericField @bind-Value="diseno.NombreY" Label="Nombre Y" Format="0.0" Step="0.5f" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudNumericField @bind-Value="diseno.MatriculaX" Label="Matrícula X" Format="0.0" Step="0.5f" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudNumericField @bind-Value="diseno.MatriculaY" Label="Matrícula Y" Format="0.0" Step="0.5f" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudExpansionPanel>

                        <MudExpansionPanel Text="Reverso (Firma)">
                            <MudNumericField @bind-Value="diseno.FirmaLineaX" Label="Firma X" Format="0.0" Step="0.5f" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudNumericField @bind-Value="diseno.FirmaLineaY" Label="Firma Y" Format="0.0" Step="0.5f" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudNumericField @bind-Value="diseno.FirmaLineaW" Label="Ancho Firma" Format="0.0" Step="0.5f" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudExpansionPanel>
                    </MudExpansionPanels>

                    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Success" Class="mt-4 w-100 py-3" StartIcon="@Icons.Material.Filled.Save" OnClick="GuardarDiseno">
                        GUARDAR DISEÑO
                    </MudButton>
                </MudItem>

                <MudItem xs="12" md="9">
                    <MudGrid>
                        @* VISTA PREVIA ANVERSO *@
                        <MudItem xs="12" md="6" Class="d-flex flex-column align-center">
                            <MudText Typo="Typo.button" Class="mb-2">ANVERSO (FRENTE)</MudText>
                            <div class="credencial-preview" style="width: 325px; height: 204px; position: relative; border: 1px solid #ccc; border-radius: 8px; overflow: hidden; background: white;">
                                @if (!string.IsNullOrEmpty(diseno.PlantillaFrenteBase64))
                                {
                                    <img src="@diseno.PlantillaFrenteBase64" style="width: 100%; height: 100%; object-fit: cover; position: absolute;" />
                                }
                                
                                @* Marco de la foto *@
                                <div style="position: absolute; left: @(diseno.FotoX * 3.78)px; top: @(diseno.FotoY * 3.78)px; width: @(diseno.FotoW * 3.78)px; height: @(diseno.FotoH * 3.78)px; border: 1px dashed red; background: rgba(255,0,0,0.1); z-index: 5;"></div>
                                
                                @* Bloque Nombre Completo *@
                                <div style="position: absolute; left: @(diseno.NombreX * 3.78)px; top: @(diseno.NombreY * 3.78)px; z-index: 5; display: flex; flex-direction: column;">
                                    <span style="font-size: 8px; color: #003366; font-weight: bold; line-height: 1.2;">ALUMNO(A):</span>
                                    <span style="font-size: 12px; color: black; font-weight: bold; line-height: 1.1;">NOMBRE DEL ALUMNO</span>
                                </div>
                                
                                @* Bloque Detalles (Matrícula, Curso, Vigencia) *@
                                <div style="position: absolute; left: @(diseno.MatriculaX * 3.78)px; top: @(diseno.MatriculaY * 3.78)px; z-index: 5; display: flex; flex-direction: column;">
                                    <span style="font-size: 9px; color: black; font-weight: bold; line-height: 1.3;"><span style="color: #003366;">MATRÍCULA:</span> 123456</span>
                                    <span style="font-size: 9px; color: black; font-weight: bold; line-height: 1.3;"><span style="color: #003366;">CURSO:</span> CURSO ASIGNADO</span>
                                    <span style="font-size: 9px; color: black; font-weight: bold; line-height: 1.3;"><span style="color: #003366;">VIGENCIA:</span> @vigenciaInput</span>
                                </div>
                            </div>
                            <MudButton HtmlTag="label" for="frenteFile" Variant="Variant.Filled" Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.FileUpload" Class="mt-3">CARGAR ANVERSO</MudButton>
                            <InputFile id="frenteFile" OnChange="SubirFrente" style="display:none" accept=".jpg,.png"/>
                        </MudItem>

                        @* VISTA PREVIA REVERSO *@
                        <MudItem xs="12" md="6" Class="d-flex flex-column align-center">
                            <MudText Typo="Typo.button" Class="mb-2">REVERSO (ATRÁS)</MudText>
                            <div class="credencial-preview" style="width: 325px; height: 204px; position: relative; border: 1px solid #ccc; border-radius: 8px; overflow: hidden; background: white;">
                                @if (!string.IsNullOrEmpty(diseno.PlantillaReversoBase64))
                                {
                                    <img src="@diseno.PlantillaReversoBase64" style="width: 100%; height: 100%; object-fit: cover; position: absolute;" />
                                }
                                
                                @* Línea y Firma del Director *@
                                <div style="position: absolute; left: @(diseno.FirmaLineaX * 3.78)px; top: @(diseno.FirmaLineaY * 3.78)px; width: @(diseno.FirmaLineaW * 3.78)px; height: 1px; background: black; z-index: 5;"></div>
                                <div style="position: absolute; left: @(diseno.FirmaLineaX * 3.78)px; top: @((diseno.FirmaLineaY + 1) * 3.78)px; width: @(diseno.FirmaLineaW * 3.78)px; text-align: center; z-index: 5; display: flex; flex-direction: column;">
                                    <span style="font-size: 9px; color: black; font-weight: bold; line-height: 1.2;">@directorInput</span>
                                    <span style="font-size: 7px; color: black; line-height: 1;">DIRECTOR DEL PLANTEL</span>
                                </div>
                            </div>
                            <MudButton HtmlTag="label" for="reversoFile" Variant="Variant.Filled" Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.FileUpload" Class="mt-3">CARGAR REVERSO</MudButton>
                            <InputFile id="reversoFile" OnChange="SubirReverso" style="display:none" accept=".jpg,.png"/>
                        </MudItem>
                    </MudGrid>
                </MudItem>
            </MudGrid>
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@code {
    private List<Student> listaAlumnos = new();
    private List<Course> listaCursos = new();
    private List<Enrollment> listaInscripciones = new();
    private CredencialDiseno diseno = new();
    
    // Pestaña 1 (Individual)
    private Student? selectedStudent;
    private string matriculaInput = "000001";
    private string cursoInput = "";
    private string vigenciaInput = "2025 - 2026";
    private string directorInput = "MTRO. JOVANY IVAN CERVANTES CARRERAS";

    // Pestaña 2 (Lote)
    private bool generandoPdfLote = false;
    private string searchStringLote = "";
    private string filterCourseIdLote = "";
    private List<AlumnoCredencialVM> listaAlumnosVM = new();
    private HashSet<AlumnoCredencialVM> alumnosSeleccionados = new();

    public class AlumnoCredencialVM
    {
        public Student Student { get; set; } = new();
        public string CourseName { get; set; } = "";

        public override bool Equals(object? obj)
        {
            if (obj is AlumnoCredencialVM other) return Student.Id == other.Student.Id;
            return false;
        }

        public override int GetHashCode() => Student.Id?.GetHashCode() ?? 0;
    }

    protected override async Task OnInitializedAsync()
    {
        QuestPDF.Settings.License = QuestPDF.Infrastructure.LicenseType.Community;

        listaAlumnos = await Firebase.GetAllStudentsAsync() ?? new();
        listaCursos = await Firebase.GetCoursesAsync() ?? new();
        listaInscripciones = await Firebase.GetAllEnrollmentsAsync() ?? new();
        diseno = await Firebase.GetDisenoCredencialAsync() ?? new();

        // Llenar lista para la pestaña en Lote
        foreach (var alumno in listaAlumnos)
        {
            var inscripcion = listaInscripciones.FirstOrDefault(i => i.StudentId == alumno.Id);
            var nombreCurso = inscripcion != null ? (listaCursos.FirstOrDefault(c => c.Id == inscripcion.CourseId)?.Name ?? "Sin Curso") : "Sin Curso";
            listaAlumnosVM.Add(new AlumnoCredencialVM { Student = alumno, CourseName = nombreCurso });
        }
    }

    private string DisplayAlumno(Student? s)
    {
        if (s == null) return "";
        return $"{s.Name ?? ""} {s.PaternalLastName ?? ""} {s.MaternalLastName ?? ""}".Trim();
    }

    // --- MÉTODOS PESTAÑA 1 (INDIVIDUAL) ---
    private Task<IEnumerable<Student>> SearchStudents(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value)) return Task.FromResult<IEnumerable<Student>>(listaAlumnos.Take(5));
        
        var filtrados = listaAlumnos.Where(s => 
            ($"{(s.Name ?? "")} {(s.PaternalLastName ?? "")}").Contains(value, StringComparison.OrdinalIgnoreCase)
        );
        return Task.FromResult<IEnumerable<Student>>(filtrados);
    }

    private void OnStudentSelected(Student? alumno)
    {
        selectedStudent = alumno;
        if (alumno != null)
        {
            var insc = listaInscripciones.FirstOrDefault(i => i.StudentId == alumno.Id);
            if (insc != null) cursoInput = listaCursos.FirstOrDefault(c => c.Id == insc.CourseId)?.Name ?? "SIN CURSO";
        }
    }

    private async Task GenerarPDF()
    {
        if (selectedStudent == null) return;
        var config = await Firebase.GetConfiguracionAsync();
        byte[] pdf = Pdf.GenerarCredencialEstudiante(selectedStudent, matriculaInput, cursoInput, vigenciaInput, directorInput, config.LogoBase64, diseno);
        using var streamRef = new DotNetStreamReference(new MemoryStream(pdf));
        await JS.InvokeVoidAsync("downloadFileFromStream", $"Credencial_{selectedStudent.Name}.pdf", streamRef);
    }

    // --- MÉTODOS PESTAÑA 2 (LOTE HORIZONTAL CON TEXTOS COMPLETOS) ---
    private IEnumerable<AlumnoCredencialVM> AlumnosFiltradosLote => listaAlumnosVM.Where(x => 
        (string.IsNullOrEmpty(searchStringLote) || $"{(x.Student.Name ?? "")} {(x.Student.PaternalLastName ?? "")}".Contains(searchStringLote, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(filterCourseIdLote) || x.CourseName == listaCursos.FirstOrDefault(c => c.Id == filterCourseIdLote)?.Name));

    private async Task GenerarPDFLote()
    {
        if (!alumnosSeleccionados.Any()) return;

        try
        {
            generandoPdfLote = true;
            StateHasChanged();
            await Task.Delay(100); 

            var pdfBytes = CrearPdfCredencialesLoteHorizontal();
            
            using var stream = new MemoryStream(pdfBytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", $"Lote_Credenciales_{DateTime.Now:yyyyMMdd_HHmm}.pdf", streamRef);
            
            Snackbar.Add($"¡{alumnosSeleccionados.Count} credenciales generadas exitosamente!", Severity.Success);
            alumnosSeleccionados.Clear();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al generar las credenciales: {ex.Message}", Severity.Error);
        }
        finally
        {
            generandoPdfLote = false;
            StateHasChanged();
        }
    }

    private byte[] CrearPdfCredencialesLoteHorizontal()
    {
        return Document.Create(container =>
        {
            container.Page(page =>
            {
                page.Size(QuestPDF.Helpers.PageSizes.Letter);
                page.Margin(1, QuestPDF.Infrastructure.Unit.Centimetre);
                page.PageColor(QuestPDF.Helpers.Colors.White);
                page.DefaultTextStyle(x => x.FontFamily("Arial"));

                page.Content().Inlined(inlined =>
                {
                    inlined.Spacing(5, QuestPDF.Infrastructure.Unit.Millimetre); 

                    foreach (var alumnoVM in alumnosSeleccionados)
                    {
                        var student = alumnoVM.Student;

                        // =====================================
                        // ANVERSO (FRENTE) HORIZONTAL 86x54 mm
                        // =====================================
                        inlined.Item().Width(86, QuestPDF.Infrastructure.Unit.Millimetre).Height(54, QuestPDF.Infrastructure.Unit.Millimetre)
                            .Border(1).BorderColor(QuestPDF.Helpers.Colors.Grey.Lighten2) 
                            .Layers(layers =>
                            {
                                // 1. Fondo de Plantilla
                                layers.PrimaryLayer().Element(e =>
                                {
                                    if (!string.IsNullOrEmpty(diseno.PlantillaFrenteBase64))
                                    {
                                        var base64Data = diseno.PlantillaFrenteBase64.Contains(",") ? diseno.PlantillaFrenteBase64.Split(',')[1] : diseno.PlantillaFrenteBase64;
                                        e.Image(Convert.FromBase64String(base64Data)).FitArea();
                                    }
                                    else
                                    {
                                        e.Background(QuestPDF.Helpers.Colors.White);
                                    }
                                });

                                // 2. Foto del alumno
                                if (!string.IsNullOrEmpty(student.PhotoBase64))
                                {
                                    var photoData = student.PhotoBase64.Contains(",") ? student.PhotoBase64.Split(',')[1] : student.PhotoBase64;
                                    layers.Layer()
                                        .PaddingLeft(diseno.FotoX, QuestPDF.Infrastructure.Unit.Millimetre)
                                        .PaddingTop(diseno.FotoY, QuestPDF.Infrastructure.Unit.Millimetre)
                                        .Width(diseno.FotoW, QuestPDF.Infrastructure.Unit.Millimetre)
                                        .Height(diseno.FotoH, QuestPDF.Infrastructure.Unit.Millimetre)
                                        .Image(Convert.FromBase64String(photoData)).FitArea();
                                }

                                // 3. Bloque de Nombre Completo
                                layers.Layer()
                                    .PaddingLeft(diseno.NombreX, QuestPDF.Infrastructure.Unit.Millimetre)
                                    .PaddingTop(diseno.NombreY, QuestPDF.Infrastructure.Unit.Millimetre)
                                    .Column(c =>
                                    {
                                        c.Item().Text("ALUMNO(A):").FontSize(6).Bold().FontColor("#003366");
                                        c.Item().Text($"{student.Name} {student.PaternalLastName} {student.MaternalLastName}".Trim()).FontSize(9).Bold().FontColor(QuestPDF.Helpers.Colors.Black);
                                    });
                                
                                // 4. Bloque de Datos (Matrícula, Curso, Vigencia)
                                layers.Layer()
                                    .PaddingLeft(diseno.MatriculaX, QuestPDF.Infrastructure.Unit.Millimetre)
                                    .PaddingTop(diseno.MatriculaY, QuestPDF.Infrastructure.Unit.Millimetre)
                                    .Column(c =>
                                    {
                                        c.Item().Text(t =>
                                        {
                                            t.Span("MATRÍCULA: ").FontSize(6).Bold().FontColor("#003366");
                                            t.Span(student.Id != null && student.Id.Length > 6 ? student.Id.Substring(0, 6).ToUpper() : "000000").FontSize(7).Bold().FontColor(QuestPDF.Helpers.Colors.Black);
                                        });
                                        c.Item().Text(t =>
                                        {
                                            t.Span("CURSO: ").FontSize(6).Bold().FontColor("#003366");
                                            t.Span(alumnoVM.CourseName).FontSize(7).Bold().FontColor(QuestPDF.Helpers.Colors.Black);
                                        });
                                        c.Item().Text(t =>
                                        {
                                            t.Span("VIGENCIA: ").FontSize(6).Bold().FontColor("#003366");
                                            t.Span(vigenciaInput).FontSize(7).Bold().FontColor(QuestPDF.Helpers.Colors.Black);
                                        });
                                    });
                            });

                        // =====================================
                        // REVERSO (ATRÁS) HORIZONTAL 86x54 mm
                        // =====================================
                        inlined.Item().Width(86, QuestPDF.Infrastructure.Unit.Millimetre).Height(54, QuestPDF.Infrastructure.Unit.Millimetre)
                            .Border(1).BorderColor(QuestPDF.Helpers.Colors.Grey.Lighten2) 
                            .Layers(layers =>
                            {
                                // 1. Fondo de Plantilla Reverso
                                layers.PrimaryLayer().Element(e =>
                                {
                                    if (!string.IsNullOrEmpty(diseno.PlantillaReversoBase64))
                                    {
                                        var base64Data = diseno.PlantillaReversoBase64.Contains(",") ? diseno.PlantillaReversoBase64.Split(',')[1] : diseno.PlantillaReversoBase64;
                                        e.Image(Convert.FromBase64String(base64Data)).FitArea();
                                    }
                                    else
                                    {
                                        e.Background(QuestPDF.Helpers.Colors.White);
                                    }
                                });

                                // 2. Línea de Firma
                                layers.Layer()
                                    .PaddingLeft(diseno.FirmaLineaX, QuestPDF.Infrastructure.Unit.Millimetre)
                                    .PaddingTop(diseno.FirmaLineaY, QuestPDF.Infrastructure.Unit.Millimetre)
                                    .Width(diseno.FirmaLineaW, QuestPDF.Infrastructure.Unit.Millimetre)
                                    .Height(0.5f, QuestPDF.Infrastructure.Unit.Millimetre)
                                    .Background(QuestPDF.Helpers.Colors.Black);

                                // 3. Textos de Firma (Nombre Director y Cargo)
                                layers.Layer()
                                    .PaddingLeft(diseno.FirmaLineaX, QuestPDF.Infrastructure.Unit.Millimetre)
                                    .PaddingTop(diseno.FirmaLineaY + 1, QuestPDF.Infrastructure.Unit.Millimetre) // Bajamos 1mm desde la línea
                                    .Width(diseno.FirmaLineaW, QuestPDF.Infrastructure.Unit.Millimetre)
                                    .Column(c =>
                                    {
                                        c.Item().AlignCenter().Text(directorInput).FontSize(7).Bold().FontColor(QuestPDF.Helpers.Colors.Black);
                                        c.Item().AlignCenter().Text("DIRECTOR DEL PLANTEL").FontSize(5).FontColor(QuestPDF.Helpers.Colors.Black);
                                    });
                            });
                    }
                });
            });
        }).GeneratePdf();
    }

    // --- MÉTODOS PESTAÑA 3 (CALIBRACIÓN) ---
    private async Task SubirFrente(InputFileChangeEventArgs e) => diseno.PlantillaFrenteBase64 = await ConvertToBase64(e.File);
    private async Task SubirReverso(InputFileChangeEventArgs e) => diseno.PlantillaReversoBase64 = await ConvertToBase64(e.File);

    private async Task<string> ConvertToBase64(IBrowserFile file)
    {
        using var ms = new MemoryStream();
        await file.OpenReadStream(1024 * 1024 * 5).CopyToAsync(ms);
        return $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
    }

    private async Task GuardarDiseno()
    {
        await Firebase.SaveDisenoCredencialAsync(diseno);
        Snackbar.Add("Diseño guardado exitosamente.", Severity.Success);
    }
}
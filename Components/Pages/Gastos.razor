@page "/gastos"
@rendermode RenderMode.InteractiveServer
@using MudBlazor
@using EscuelaManagement.Data.Models
@using EscuelaManagement.Data.Services
@inject FirebaseService Firebase
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-6 pb-12">
    
    <!-- ENCABEZADO -->
    <div class="mb-8">
        <MudText Typo="Typo.h4" Class="font-weight-bold mb-1">Control de Gastos y Egresos</MudText>
        <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">Registra y monitorea las salidas de dinero (renta, nómina, servicios, etc.)</MudText>
    </div>

    @* --- TARJETA DE RESUMEN DEL MES --- *@
    <MudGrid Class="mb-6 fade-in-suave">
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="pa-6 modern-card rounded-xl" Style="border: 1px solid var(--mud-palette-lines-default);">
                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: var(--mud-palette-text-secondary);">Total Gastos (Este Mes)</MudText>
                    <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="background-color: rgba(var(--mud-palette-error-rgb), 0.1); color: var(--mud-palette-error);" Class="rounded-lg">
                        <MudIcon Icon="@Icons.Material.Filled.TrendingDown" />
                    </MudAvatar>
                </div>
                <MudText Typo="Typo.h3" Class="font-weight-bold" Color="Color.Error">@totalGastosMes.ToString("C")</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="fade-in-suave">
        @* --- FORMULARIO PARA AGREGAR NUEVO GASTO --- *@
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="pa-6 rounded-xl h-100" Style="border: 1px solid var(--mud-palette-lines-default);">
                <MudText Typo="Typo.h6" Class="font-weight-bold mb-6" Color="Color.Primary">Registrar Salida</MudText>
                
                <MudForm @ref="form" @bind-IsValid="success">
                    <MudTextField T="string" @bind-Value="nuevoGasto.Concepto" Label="Concepto (Ej. Pago de Luz)" Required="true" RequiredError="El concepto es obligatorio" Variant="Variant.Outlined" Class="mb-4 modern-input" />
                    
                    <MudNumericField T="double" @bind-Value="nuevoGasto.Monto" Label="Monto ($)" Required="true" Min="1.0" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AttachMoney" Class="mb-4 modern-input" />
                    
                    <MudSelect T="string" Label="Categoría" @bind-Value="nuevoGasto.Categoria" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Class="mb-4 modern-input">
                        <MudSelectItem T="string" Value="@("Operativo")">Operativo (Papelería, Limpieza)</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Nómina")">Nómina (Profesores, Staff)</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Servicios")">Servicios (Luz, Internet, Agua)</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Renta")">Renta de Inmueble</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Publicidad")">Publicidad y Marketing</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Otro")">Otro</MudSelectItem>
                    </MudSelect>

                    <MudDatePicker @bind-Date="fechaTemp" Label="Fecha del Gasto" Variant="Variant.Outlined" Class="mb-4 modern-input" />
                    
                    <MudTextField T="string" @bind-Value="nuevoGasto.Notas" Label="Notas adicionales (Opcional)" Lines="3" Variant="Variant.Outlined" Class="mb-6 modern-input" />
                    
                    <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Add" FullWidth="true" Class="rounded-lg font-weight-bold py-3" Style="text-transform: none;" OnClick="GuardarGasto" Disabled="@guardando">
                        @if (guardando) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/> } Guardar Gasto
                    </MudButton>
                </MudForm>
            </MudPaper>
        </MudItem>

        @* --- TABLA DE HISTORIAL DE GASTOS --- *@
        <MudItem xs="12" md="8">
            <MudPaper Elevation="0" Class="pa-6 rounded-xl h-100" Style="border: 1px solid var(--mud-palette-lines-default);">
                <MudTable T="Gasto" Items="@listaGastos" Hover="true" Elevation="0" Class="modern-table" Filter="new Func<Gasto,bool>(FilterFunc)">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6" Class="font-weight-bold" Color="Color.Primary">Historial de Movimientos</MudText>
                        <MudSpacer />
                        <MudTextField T="string" @bind-Value="searchString" Placeholder="Buscar concepto..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0 modern-input" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="max-width: 300px;" />
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary);">Fecha</MudTh>
                        <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary);">Concepto</MudTh>
                        <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary);">Categoría</MudTh>
                        <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); text-align: right;">Monto</MudTh>
                        <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); text-align: center;">Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Fecha">
                            <MudText Typo="Typo.body2">@context.Fecha.ToLocalTime().ToString("dd/MMM/yyyy")</MudText>
                        </MudTd>
                        <MudTd DataLabel="Concepto">
                            <MudText Typo="Typo.body1" Class="font-weight-bold">@context.Concepto</MudText>
                            @if(!string.IsNullOrEmpty(context.Notas))
                            {
                                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary); display:block;">@context.Notas</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="Categoría">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="font-weight-bold">@context.Categoria</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Monto" Style="text-align: right;">
                            <MudText Typo="Typo.body1" Class="font-weight-bold" Color="Color.Error">- @context.Monto.ToString("C")</MudText>
                        </MudTd>
                        <MudTd DataLabel="Acciones" Style="text-align: center;">
                            <MudTooltip Text="Eliminar Gasto" Arrow="true" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => EliminarGasto(context))" />
                            </MudTooltip>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="d-flex flex-column align-center justify-center pa-8 fade-in-suave">
                            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Default" Style="font-size: 5rem; opacity: 0.4;" Class="mb-4" />
                            <MudText Typo="Typo.h6" Class="mb-1 font-weight-bold" Style="color: var(--mud-palette-text-secondary);">Sin Movimientos</MudText>
                            <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">Aún no hay gastos registrados que coincidan con tu búsqueda.</MudText>
                        </div>
                    </NoRecordsContent>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" RowsPerPageString="Gastos por página:" InfoFormat="{first_item}-{last_item} de {all_items}" />
                    </PagerContent>
                </MudTable>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

<style>
    /* Efecto de tarjetas principales */
    .modern-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        background-color: var(--mud-palette-background-grey);
    }
    .modern-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.15) !important;
        background-color: var(--mud-palette-surface);
        border-color: var(--mud-palette-error) !important;
    }

    /* Estilos modernos para los inputs */
    .modern-input .mud-input-outlined-border {
        border-color: var(--mud-palette-lines-default) !important;
    }
    .modern-input .mud-input {
        background-color: transparent !important;
        border-radius: 8px !important;
    }
    .modern-input .mud-input.mud-input-focused .mud-input-outlined-border {
        border-width: 2px !important;
        border-color: var(--mud-palette-primary) !important;
    }

    /* Estilos limpios para la tabla */
    .modern-table .mud-table-cell {
        border-bottom: 1px solid var(--mud-palette-lines-default) !important;
        padding: 16px 12px !important;
    }
    .modern-table .mud-table-root {
        border: none !important;
    }
</style>

@code {
    private MudForm form = default!;
    private bool success;
    private bool guardando = false;
    
    private Gasto nuevoGasto = new();
    private DateTime? fechaTemp = DateTime.Today;
    private List<Gasto> listaGastos = new();
    private string searchString = "";
    
    private double totalGastosMes = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarGastos();
    }

    private async Task CargarGastos()
    {
        listaGastos = await Firebase.GetGastosAsync();
        
        var mesActual = DateTime.UtcNow.Month;
        var anoActual = DateTime.UtcNow.Year;
        
        totalGastosMes = listaGastos
            .Where(g => g.Fecha.ToLocalTime().Month == mesActual && g.Fecha.ToLocalTime().Year == anoActual)
            .Sum(g => g.Monto);
    }

    private async Task GuardarGasto()
    {
        await form.ValidateAsync();
        if (form.IsValid)
        {
            try
            {
                guardando = true;
                StateHasChanged();

                if (fechaTemp.HasValue)
                {
                    nuevoGasto.Fecha = fechaTemp.Value;
                }

                await Firebase.AddGastoAsync(nuevoGasto);
                Snackbar.Add("Gasto registrado exitosamente", Severity.Success);
                
                nuevoGasto = new Gasto { Categoria = "Operativo" };
                fechaTemp = DateTime.Today;
                await CargarGastos();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error al guardar: {ex.Message}", Severity.Error);
            }
            finally
            {
                guardando = false;
                StateHasChanged();
            }
        }
    }

    private async Task EliminarGasto(Gasto gasto)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Confirmar Eliminación", 
            $"¿Estás seguro que deseas eliminar el registro de '{gasto.Concepto}' por {gasto.Monto.ToString("C")}?", 
            yesText: "Eliminar", cancelText: "Cancelar");

        if (result == true)
        {
            await Firebase.DeleteGastoAsync(gasto.Id);
            Snackbar.Add("Registro eliminado", Severity.Info);
            await CargarGastos();
            StateHasChanged();
        }
    }

    private bool FilterFunc(Gasto element)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (element.Concepto.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.Categoria.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }
}
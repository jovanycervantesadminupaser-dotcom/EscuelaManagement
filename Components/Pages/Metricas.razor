@page "/metricas"
@rendermode RenderMode.InteractiveServer
@using MudBlazor
@using System.IO
@using EscuelaManagement.Data.Models
@using EscuelaManagement.Data.Services
@using QuestPDF.Fluent
@inject FirebaseService Firebase
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-6 pb-12">
    
    <!-- ENCABEZADO Y EXPORTACIÓN -->
    <div class="mb-8 d-flex flex-wrap justify-space-between align-center gap-4">
        <div>
            <MudText Typo="Typo.h4" Class="font-weight-bold mb-1">Panel de Ventas y Rendimiento</MudText>
            <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">Análisis financiero, cobranza y métricas de desempeño del plantel.</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="DescargarReportePDF" Disabled="@generandoPdf" Class="rounded-lg font-weight-bold px-6" Style="text-transform: none;">
            @if (generandoPdf)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                <span>Generando...</span>
            }
            else
            {
                <span>Exportar Reporte PDF</span>
            }
        </MudButton>
    </div>

    <!-- PANEL DE FILTROS -->
    <MudPaper Elevation="0" Class="pa-6 mb-8 rounded-lg fade-in-suave" Style="border: 1px solid var(--mud-palette-lines-default);">
        <MudGrid Class="align-center">
            <MudItem xs="12" md="4" lg="3">
                <MudSelect T="string" Label="Periodo de Análisis" Value="@filtroTiempo" ValueChanged="OnFiltroCambiado" Variant="Variant.Outlined" Class="modern-input" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem T="string" Value="@("Este Mes")">Este Mes</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Este Año")">Este Año</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Histórico")">Histórico (Todo)</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Personalizado")">Personalizado...</MudSelectItem>
                </MudSelect>
            </MudItem>

            @if (filtroTiempo == "Personalizado")
            {
                <MudItem xs="12" md="4" lg="4" Class="fade-in-suave">
                    <MudDateRangePicker DateRange="rangoFechasCustom" 
                                        DateRangeChanged="OnRangoFechasCambiado" 
                                        Variant="Variant.Outlined" 
                                        Class="modern-input"
                                        AnchorOrigin="Origin.BottomCenter" 
                                        Clearable="true" 
                                        PlaceholderStart="Fecha Inicio" 
                                        PlaceholderEnd="Fecha Fin" />
                </MudItem>
            }

            <MudItem xs="12" md="4" lg="4">
                <MudSelect T="string" Label="Filtrar por Asesor" Value="@filtroAsesor" ValueChanged="OnFiltroAsesorCambiado" Variant="Variant.Outlined" Class="modern-input" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem T="string" Value="@("Todos")">Todos los Asesores</MudSelectItem>
                    @foreach(var asesor in listaAsesoresDisponibles)
                    {
                        <MudSelectItem T="string" Value="@asesor">@asesor</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (cargando)
    {
        @* EFECTO ESQUELETO *@
        <div class="fade-in-suave">
            <MudGrid Class="mb-6">
                <MudItem xs="12" md="4"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="140px" Class="rounded-xl" /></MudItem>
                <MudItem xs="12" md="4"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="140px" Class="rounded-xl" /></MudItem>
                <MudItem xs="12" md="4"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="140px" Class="rounded-xl" /></MudItem>
            </MudGrid>
            <MudGrid Class="mb-6">
                <MudItem xs="12" md="6"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="160px" Class="rounded-xl" /></MudItem>
                <MudItem xs="12" md="6"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="160px" Class="rounded-xl" /></MudItem>
            </MudGrid>
        </div>
    }
    else
    {
        <div class="fade-in-suave">
            
            @* --- 1. KPIs PRINCIPALES (UTILIDAD Y FINANZAS) --- *@
            <MudGrid Class="mb-6">
                <MudItem xs="12" md="4">
                    <MudPaper Elevation="0" Class="pa-6 modern-card rounded-xl h-100" Style="border: 1px solid var(--mud-palette-lines-default);">
                        <div class="d-flex justify-space-between align-center mb-4">
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: var(--mud-palette-text-secondary);">Ingresos Proyectados</MudText>
                            <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="background-color: rgba(var(--mud-palette-success-rgb), 0.1); color: var(--mud-palette-success);" Class="rounded-lg">
                                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" />
                            </MudAvatar>
                        </div>
                        <MudText Typo="Typo.h3" Class="font-weight-bold" Color="Color.Success">@totalIngresos.ToString("C")</MudText>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudPaper Elevation="0" Class="pa-6 modern-card rounded-xl h-100" Style="border: 1px solid var(--mud-palette-lines-default);">
                        <div class="d-flex justify-space-between align-center mb-4">
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: var(--mud-palette-text-secondary);">Egresos / Gastos</MudText>
                            <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="background-color: rgba(var(--mud-palette-error-rgb), 0.1); color: var(--mud-palette-error);" Class="rounded-lg">
                                <MudIcon Icon="@Icons.Material.Filled.TrendingDown" />
                            </MudAvatar>
                        </div>
                        <MudText Typo="Typo.h3" Class="font-weight-bold" Color="Color.Error">- @totalGastosFiltro.ToString("C")</MudText>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudPaper Elevation="0" Class="pa-6 modern-card rounded-xl h-100" Style="@($"border: 1px solid {(utilidadRealNeta >= 0 ? "var(--mud-palette-primary)" : "var(--mud-palette-warning)")};")">
                        <div class="d-flex justify-space-between align-center mb-4">
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: var(--mud-palette-text-secondary);">Utilidad Real (Neta)</MudText>
                            <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="@($"background-color: rgba({(utilidadRealNeta >= 0 ? "var(--mud-palette-primary-rgb)" : "var(--mud-palette-warning-rgb)")}, 0.1); color: {(utilidadRealNeta >= 0 ? "var(--mud-palette-primary)" : "var(--mud-palette-warning)")};")" Class="rounded-lg">
                                <MudIcon Icon="@Icons.Material.Filled.AccountBalance" />
                            </MudAvatar>
                        </div>
                        <MudText Typo="Typo.h3" Class="font-weight-bold" Style="@($"color: {(utilidadRealNeta >= 0 ? "var(--mud-palette-primary)" : "var(--mud-palette-warning)")};")">@utilidadRealNeta.ToString("C")</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @* --- 2. SALUD FINANCIERA (COBRANZA) --- *@
            <MudGrid Class="mb-6">
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-6 modern-card rounded-xl h-100" Style="border: 1px solid var(--mud-palette-lines-default);">
                        <div class="d-flex justify-space-between align-center mb-4">
                            <div>
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: var(--mud-palette-text-secondary);">Cobranza Efectiva (Dinero Real)</MudText>
                                <MudText Typo="Typo.h4" Class="font-weight-bold mt-1" Color="Color.Info">@totalCobranzaReal.ToString("C")</MudText>
                            </div>
                            <MudAvatar Variant="Variant.Filled" Size="Size.Large" Style="background-color: rgba(var(--mud-palette-info-rgb), 0.1); color: var(--mud-palette-info);" Class="rounded-lg">
                                <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Medium" />
                            </MudAvatar>
                        </div>
                        <MudProgressLinear Color="Color.Info" Value="@porcentajeCobranza" Size="Size.Large" Class="rounded-lg mb-2" />
                        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);"><b>@porcentajeCobranza.ToString("0.1")%</b> del ingreso proyectado ha sido cobrado.</MudText>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-6 modern-card rounded-xl h-100" Style="border: 1px solid var(--mud-palette-lines-default);">
                        <div class="d-flex justify-space-between align-center mb-4">
                            <div>
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: var(--mud-palette-text-secondary);">Cartera Vencida (Pendiente)</MudText>
                                <MudText Typo="Typo.h4" Class="font-weight-bold mt-1" Color="Color.Error">@carteraVencida.ToString("C")</MudText>
                            </div>
                            <MudAvatar Variant="Variant.Filled" Size="Size.Large" Style="background-color: rgba(var(--mud-palette-error-rgb), 0.1); color: var(--mud-palette-error);" Class="rounded-lg">
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Medium" />
                            </MudAvatar>
                        </div>
                        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">Diferencia entre el valor exigible a la fecha (por periodos transcurridos) y los pagos registrados.</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @* --- 3. INDICADORES SECUNDARIOS --- *@
            <MudGrid Class="mb-6">
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Elevation="0" Class="pa-6 modern-card rounded-xl d-flex flex-column align-center justify-center text-center h-100" Style="border: 1px solid var(--mud-palette-lines-default);">
                        <MudAvatar Variant="Variant.Filled" Style="background-color: rgba(var(--mud-palette-success-rgb), 0.1); color: var(--mud-palette-success);" Class="rounded-lg mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.AttachMoney" />
                        </MudAvatar>
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: var(--mud-palette-text-secondary);">Ingresos Proyectados</MudText>
                        <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Success">@totalIngresos.ToString("C")</MudText>
                        
                        @if (mostrarCrecimiento)
                        {
                            <div class="d-flex align-center mt-2">
                                <MudIcon Icon="@(crecimientoIngresos >= 0 ? Icons.Material.Filled.TrendingUp : Icons.Material.Filled.TrendingDown)" 
                                         Color="@(crecimientoIngresos >= 0 ? Color.Success : Color.Error)" Size="Size.Small" />
                                <MudText Typo="Typo.caption" Class="font-weight-bold ml-1" Color="@(crecimientoIngresos >= 0 ? Color.Success : Color.Error)">
                                    @(crecimientoIngresos >= 0 ? "+" : "")@crecimientoIngresos.ToString("0.1")% <span style="color: var(--mud-palette-text-secondary); font-weight: normal;">vs ant.</span>
                                </MudText>
                            </div>
                        }
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Elevation="0" Class="pa-6 modern-card rounded-xl d-flex flex-column align-center justify-center text-center h-100" Style="border: 1px solid var(--mud-palette-lines-default);">
                        <MudAvatar Variant="Variant.Filled" Style="background-color: rgba(var(--mud-palette-info-rgb), 0.1); color: var(--mud-palette-info);" Class="rounded-lg mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.People" />
                        </MudAvatar>
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: var(--mud-palette-text-secondary);">Total Inscripciones</MudText>
                        <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Info">@totalInscritos</MudText>

                        @if (mostrarCrecimiento)
                        {
                            <div class="d-flex align-center mt-2">
                                <MudIcon Icon="@(crecimientoInscritos >= 0 ? Icons.Material.Filled.TrendingUp : Icons.Material.Filled.TrendingDown)" 
                                         Color="@(crecimientoInscritos >= 0 ? Color.Success : Color.Error)" Size="Size.Small" />
                                <MudText Typo="Typo.caption" Class="font-weight-bold ml-1" Color="@(crecimientoInscritos >= 0 ? Color.Success : Color.Error)">
                                    @(crecimientoInscritos >= 0 ? "+" : "")@crecimientoInscritos.ToString("0.1")% <span style="color: var(--mud-palette-text-secondary); font-weight: normal;">vs ant.</span>
                                </MudText>
                            </div>
                        }
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Elevation="0" Class="pa-6 modern-card rounded-xl d-flex flex-column align-center justify-center text-center h-100" Style="border: 1px solid var(--mud-palette-lines-default);">
                        <MudAvatar Variant="Variant.Filled" Style="background-color: rgba(var(--mud-palette-warning-rgb), 0.1); color: var(--mud-palette-warning);" Class="rounded-lg mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.Star" />
                        </MudAvatar>
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: var(--mud-palette-text-secondary);">Curso Estrella</MudText>
                        <MudText Typo="Typo.h6" Class="font-weight-bold mt-1" Style="line-height: 1.2;">@cursoEstrella</MudText>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Elevation="0" Class="pa-6 modern-card rounded-xl d-flex flex-column align-center justify-center text-center h-100" Style="border: 1px solid var(--mud-palette-lines-default);">
                        <MudAvatar Variant="Variant.Filled" Style="background-color: rgba(var(--mud-palette-secondary-rgb), 0.1); color: var(--mud-palette-secondary);" Class="rounded-lg mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" />
                        </MudAvatar>
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: var(--mud-palette-text-secondary);">Mejor Asesor(a)</MudText>
                        <MudText Typo="Typo.h6" Class="font-weight-bold mt-1">@mejorAsesor</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @* --- 4. GRÁFICAS --- *@
            <MudGrid Class="mb-6">
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-6 rounded-xl h-100" Style="border: 1px solid var(--mud-palette-lines-default);">
                        <MudText Typo="Typo.h6" Class="font-weight-bold mb-4" Color="Color.Primary">Demanda por Curso</MudText>
                        <div class="d-flex justify-center">
                            @if (dataCursos.Any()) 
                            { 
                                <MudChart T="double" ChartType="ChartType.Pie" InputData="@dataCursos" InputLabels="@labelsCursos" Width="100%" Height="300px" /> 
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);" Class="py-12">No hay datos suficientes.</MudText>
                            }
                        </div>
                    </MudPaper>
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-6 rounded-xl h-100" Style="border: 1px solid var(--mud-palette-lines-default);">
                        <MudText Typo="Typo.h6" Class="font-weight-bold mb-4" Color="Color.Primary">Ventas por Asesor</MudText>
                        <div>
                            @if (SeriesAsesores.Any() && SeriesAsesores.First().Data.Any()) 
                            { 
                                <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="@SeriesAsesores" XAxisLabels="@labelsAsesores" Width="100%" Height="300px" /> 
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);" Class="py-12 text-center">No hay datos suficientes.</MudText>
                            }
                        </div>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @* --- 5. TABLA DE DESGLOSE FINANCIERO --- *@
            <MudPaper Elevation="0" Class="pa-6 rounded-xl mb-6" Style="border: 1px solid var(--mud-palette-lines-default);">
                <MudTable Items="@desgloseCursos" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Class="modern-table">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6" Class="font-weight-bold" Color="Color.Primary">Desglose Financiero por Curso</MudText>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary);">Nombre del Curso</MudTh>
                        <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); text-align:center;">Inscripciones</MudTh>
                        <MudTh Style="font-weight: bold; text-transform: uppercase; color: var(--mud-palette-text-secondary); text-align:right;">Ingresos Proyectados</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Nombre del Curso">
                            <MudText Typo="Typo.body1" Class="font-weight-bold">@context.NombreCurso</MudText>
                        </MudTd>
                        <MudTd DataLabel="Inscripciones" Style="text-align:center;">
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined" Class="font-weight-bold px-3">@context.Cantidad</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Ingresos Proyectados" Style="text-align:right;">
                            <MudText Typo="Typo.body1" Class="font-weight-bold text-success">@context.IngresoTotal.ToString("C")</MudText>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>

        </div>
    }
</MudContainer>

<style>
    /* Efecto de tarjetas principales */
    .modern-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        background-color: var(--mud-palette-background-grey);
    }
    .modern-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.15) !important;
        background-color: var(--mud-palette-surface);
        border-color: var(--mud-palette-primary) !important;
    }

    /* Estilos modernos para los inputs */
    .modern-input .mud-input-outlined-border {
        border-color: var(--mud-palette-lines-default) !important;
    }
    .modern-input .mud-input {
        background-color: transparent !important;
        border-radius: 8px !important;
    }
    .modern-input .mud-input.mud-input-focused .mud-input-outlined-border {
        border-width: 2px !important;
        border-color: var(--mud-palette-primary) !important;
    }

    /* Estilos limpios para la tabla */
    .modern-table .mud-table-cell {
        border-bottom: 1px solid var(--mud-palette-lines-default) !important;
        padding: 16px 12px !important;
    }
    .modern-table .mud-table-root {
        border: none !important;
    }
</style>

@code {
    private bool cargando = true;
    private bool generandoPdf = false;
    private string filtroTiempo = "Este Mes";
    private string filtroAsesor = "Todos";
    private DateRange rangoFechasCustom = new DateRange(DateTime.Now.AddDays(-30).Date, DateTime.Now.Date);
    
    private ConfiguracionEscuela configuracion = new();
    private List<Enrollment> todasLasInscripciones = new();
    private List<Course> todosLosCursos = new();
    private List<Payment> todosLosPagos = new();
    private List<Gasto> todosLosGastos = new();
    private List<string> listaAsesoresDisponibles = new();
    
    private double totalIngresos = 0;
    private double totalGastosFiltro = 0;
    private double utilidadRealNeta = 0;
    private int totalInscritos = 0;
    private string cursoEstrella = "N/A";
    private string mejorAsesor = "N/A";
    private double totalCobranzaReal = 0;
    private double porcentajeCobranza = 0;
    private double carteraVencida = 0;
    private bool mostrarCrecimiento = true;
    private double crecimientoIngresos = 0;
    private double crecimientoInscritos = 0;
    private double[] dataCursos = Array.Empty<double>();
    private string[] labelsCursos = Array.Empty<string>();
    private List<ChartSeries<double>> SeriesAsesores = new();
    private string[] labelsAsesores = Array.Empty<string>();
    private List<DesgloseCurso> desgloseCursos = new();

    public class DesgloseCurso { public string NombreCurso { get; set; } = ""; public int Cantidad { get; set; } public double IngresoTotal { get; set; } }

    protected override async Task OnInitializedAsync()
    {
        QuestPDF.Settings.License = QuestPDF.Infrastructure.LicenseType.Community;
        configuracion = await Firebase.GetConfiguracionAsync() ?? new();
        todasLasInscripciones = await Firebase.GetAllEnrollmentsAsync() ?? new();
        todosLosCursos = await Firebase.GetCoursesAsync() ?? new();
        todosLosPagos = await Firebase.GetAllPaymentsAsync() ?? new(); 
        todosLosGastos = await Firebase.GetGastosAsync() ?? new();

        listaAsesoresDisponibles = todasLasInscripciones.Where(e => !string.IsNullOrWhiteSpace(e.AsesorAsignado)).Select(e => e.AsesorAsignado).Distinct().OrderBy(a => a).ToList();
        ProcesarMetricas();
        cargando = false;
    }

    private void OnFiltroCambiado(string nuevoFiltro) { filtroTiempo = nuevoFiltro; ProcesarMetricas(); }
    private void OnRangoFechasCambiado(DateRange nuevoRango) { rangoFechasCustom = nuevoRango; ProcesarMetricas(); }
    private void OnFiltroAsesorCambiado(string nuevoAsesor) { filtroAsesor = nuevoAsesor; ProcesarMetricas(); }

    private void ProcesarMetricas()
    {
        var fechaActual = DateTime.UtcNow;
        DateTime? currentStart = null; DateTime? currentEnd = null; DateTime? prevStart = null; DateTime? prevEnd = null; mostrarCrecimiento = true;

        if (filtroTiempo == "Este Mes") { currentStart = new DateTime(fechaActual.Year, fechaActual.Month, 1); currentEnd = currentStart.Value.AddMonths(1).AddTicks(-1); prevStart = currentStart.Value.AddMonths(-1); prevEnd = currentStart.Value.AddTicks(-1); }
        else if (filtroTiempo == "Este Año") { currentStart = new DateTime(fechaActual.Year, 1, 1); currentEnd = currentStart.Value.AddYears(1).AddTicks(-1); prevStart = currentStart.Value.AddYears(-1); prevEnd = currentStart.Value.AddTicks(-1); }
        else if (filtroTiempo == "Personalizado" && rangoFechasCustom?.Start != null && rangoFechasCustom?.End != null) { currentStart = rangoFechasCustom.Start.Value.Date; currentEnd = rangoFechasCustom.End.Value.Date.AddDays(1).AddTicks(-1); TimeSpan duracion = currentEnd.Value - currentStart.Value; prevEnd = currentStart.Value.AddTicks(-1); prevStart = prevEnd.Value.Add(-duracion); }
        else { mostrarCrecimiento = false; }

        var queryActual = todasLasInscripciones.AsQueryable();
        var queryAnterior = todasLasInscripciones.AsQueryable();

        if (currentStart.HasValue && currentEnd.HasValue) { queryActual = queryActual.Where(e => e.EnrollmentDate >= currentStart.Value && e.EnrollmentDate <= currentEnd.Value); }
        if (prevStart.HasValue && prevEnd.HasValue) { queryAnterior = queryAnterior.Where(e => e.EnrollmentDate >= prevStart.Value && e.EnrollmentDate <= prevEnd.Value); }
        if (filtroAsesor != "Todos") { queryActual = queryActual.Where(e => e.AsesorAsignado == filtroAsesor); queryAnterior = queryAnterior.Where(e => e.AsesorAsignado == filtroAsesor); }

        var lista = queryActual.ToList(); var listaPrev = queryAnterior.ToList();
        totalInscritos = lista.Count; 
        totalIngresos = lista.Sum(e => e.MontoPlazo * (e.NumeroPlazos > 0 ? e.NumeroPlazos : 1));

        // --- FILTRAR GASTOS SEGÚN EL PERIODO ---
        var gastosQuery = todosLosGastos.AsQueryable();
        if (currentStart.HasValue && currentEnd.HasValue)
        {
            gastosQuery = gastosQuery.Where(g => g.Fecha >= currentStart.Value && g.Fecha <= currentEnd.Value);
        }
        totalGastosFiltro = gastosQuery.Sum(g => g.Monto);
        utilidadRealNeta = totalIngresos - totalGastosFiltro;

        totalCobranzaReal = 0; carteraVencida = 0;

        foreach (var inscripcion in lista)
        {
            var pagosDeEstaInscripcion = todosLosPagos.Where(p => p.StudentId == inscripcion.StudentId && p.CourseId == inscripcion.CourseId).Sum(p => p.Amount);
            totalCobranzaReal += pagosDeEstaInscripcion;
            var curso = todosLosCursos.FirstOrDefault(c => c.Id == inscripcion.CourseId);
            if (curso != null)
            {
                double costoConDescuento = curso.SinglePaymentCost * (1 - (inscripcion.DiscountAmount / 100.0));
                double abonadoAFecha = pagosDeEstaInscripcion;
                double saldoGlobalRestante = costoConDescuento - abonadoAFecha;
                double montoExigibleHoy = 0;
                string tipoPeriodo = string.IsNullOrEmpty(inscripcion.TipoPlazo) ? "Semanas" : inscripcion.TipoPlazo;
                int totalPeriodos = inscripcion.NumeroPlazos > 0 ? inscripcion.NumeroPlazos : 12;
                double costoPorPeriodo = inscripcion.MontoPlazo > 0 ? inscripcion.MontoPlazo : (costoConDescuento / totalPeriodos);

                if (tipoPeriodo.Contains("exhibición", StringComparison.OrdinalIgnoreCase) || 
                    tipoPeriodo.Contains("exhibicion", StringComparison.OrdinalIgnoreCase) || 
                    tipoPeriodo.Contains("único", StringComparison.OrdinalIgnoreCase) || 
                    tipoPeriodo.Contains("unico", StringComparison.OrdinalIgnoreCase) ||
                    tipoPeriodo.Contains("contado", StringComparison.OrdinalIgnoreCase))
                {
                    montoExigibleHoy = costoConDescuento;
                }
                else
                {
                    var fechaInscripcion = inscripcion.EnrollmentDate.ToLocalTime();
                    var diasTranscurridos = (DateTime.Now - fechaInscripcion).TotalDays;
                    int periodosTranscurridos = 0;
                    if (tipoPeriodo == "Semanas") periodosTranscurridos = (int)(diasTranscurridos / 7) + 1;
                    else if (tipoPeriodo == "Quincenas") periodosTranscurridos = (int)(diasTranscurridos / 15) + 1;
                    else if (tipoPeriodo == "Meses") periodosTranscurridos = (int)(diasTranscurridos / 30) + 1;
                    if (periodosTranscurridos > totalPeriodos) periodosTranscurridos = totalPeriodos;
                    montoExigibleHoy = periodosTranscurridos * costoPorPeriodo;
                }
                double montoVencidoReal = montoExigibleHoy - abonadoAFecha;
                if (saldoGlobalRestante <= 0) montoVencidoReal = 0;
                if (montoVencidoReal > 0.01) carteraVencida += montoVencidoReal;
            }
        }
        porcentajeCobranza = totalIngresos > 0 ? (totalCobranzaReal / totalIngresos) * 100 : 0; if (porcentajeCobranza > 100) porcentajeCobranza = 100;
        int prevInscritos = listaPrev.Count; double prevIngresos = listaPrev.Sum(e => e.MontoPlazo * (e.NumeroPlazos > 0 ? e.NumeroPlazos : 1));
        crecimientoInscritos = prevInscritos == 0 ? (totalInscritos > 0 ? 100 : 0) : ((double)(totalInscritos - prevInscritos) / prevInscritos) * 100;
        crecimientoIngresos = prevIngresos == 0 ? (totalIngresos > 0 ? 100 : 0) : ((totalIngresos - prevIngresos) / prevIngresos) * 100;

        var topCurso = lista.GroupBy(e => e.CourseId).OrderByDescending(g => g.Count()).FirstOrDefault();
        if (topCurso != null && !string.IsNullOrEmpty(topCurso.Key)) { var nombre = todosLosCursos.FirstOrDefault(c => c.Id == topCurso.Key)?.Name; cursoEstrella = nombre ?? "Curso Desconocido"; } else { cursoEstrella = "Sin registros"; }
        var topAsesor = lista.Where(e => !string.IsNullOrWhiteSpace(e.AsesorAsignado)).GroupBy(e => e.AsesorAsignado).OrderByDescending(g => g.Count()).FirstOrDefault();
        mejorAsesor = topAsesor != null ? topAsesor.Key : (filtroAsesor == "Todos" ? "Sin Asignar" : filtroAsesor);
        
        var gruposCursos = lista.GroupBy(e => e.CourseId).ToList();
        List<double> datosPie = new(); List<string> etiquetasPie = new(); desgloseCursos.Clear(); 
        foreach (var grupo in gruposCursos)
        {
            var nombreCurso = todosLosCursos.FirstOrDefault(c => c.Id == grupo.Key)?.Name ?? "Desconocido";
            int cantidadInscritos = grupo.Count(); double ingresoPorEsteCurso = grupo.Sum(e => e.MontoPlazo * (e.NumeroPlazos > 0 ? e.NumeroPlazos : 1));
            datosPie.Add(cantidadInscritos); etiquetasPie.Add($"{nombreCurso} ({cantidadInscritos})");
            desgloseCursos.Add(new DesgloseCurso { NombreCurso = nombreCurso, Cantidad = cantidadInscritos, IngresoTotal = ingresoPorEsteCurso });
        }
        dataCursos = datosPie.ToArray(); labelsCursos = etiquetasPie.ToArray(); desgloseCursos = desgloseCursos.OrderByDescending(d => d.IngresoTotal).ToList();

        var gruposAsesores = lista.GroupBy(e => string.IsNullOrWhiteSpace(e.AsesorAsignado) ? "Venta Online / Sin Asesor" : e.AsesorAsignado).OrderByDescending(g => g.Count()).ToList();
        List<double> datosBarras = new(); List<string> etiquetasBarras = new();
        foreach (var grupo in gruposAsesores) { datosBarras.Add(grupo.Count()); etiquetasBarras.Add(grupo.Key); }
        SeriesAsesores = new List<ChartSeries<double>>() { new ChartSeries<double>() { Name = "Inscripciones", Data = datosBarras.ToArray() } };
        labelsAsesores = etiquetasBarras.ToArray();
    }

    private async Task DescargarReportePDF()
    {
        try 
        { 
            generandoPdf = true; 
            StateHasChanged(); 
            await Task.Delay(100); 
            
            var pdfBytes = GeneratePdfDocument(); 
            var fileName = $"Reporte_Ventas_{DateTime.Now:yyyyMMdd}.pdf"; 
            
            using var stream = new MemoryStream(pdfBytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JSRuntime.InvokeVoidAsync("descargarArchivoPdf", fileName, streamRef);
            
            Snackbar.Add("Reporte PDF descargado exitosamente.", Severity.Success); 
        }
        catch (Exception ex) 
        { 
            Snackbar.Add($"Error al generar el PDF: {ex.Message}", Severity.Error); 
        } 
        finally 
        { 
            generandoPdf = false; 
            StateHasChanged(); 
        }
    }

    private byte[] GeneratePdfDocument()
    {
        return Document.Create(container =>
        {
            container.Page(page =>
            {
                page.Size(QuestPDF.Helpers.PageSizes.Letter); 
                page.Margin(2, QuestPDF.Infrastructure.Unit.Centimetre); 
                page.PageColor(QuestPDF.Helpers.Colors.White); 
                page.DefaultTextStyle(x => x.FontSize(10).FontFamily("Arial"));

                if (!string.IsNullOrEmpty(configuracion.LogoBase64))
                {
                    try
                    {
                        var base64Watermark = configuracion.LogoBase64.Contains(",") 
                            ? configuracion.LogoBase64.Substring(configuracion.LogoBase64.IndexOf(",") + 1) 
                            : configuracion.LogoBase64;
                        var watermarkBytes = Convert.FromBase64String(base64Watermark);

                        page.Background().AlignCenter().AlignMiddle().Width(350).Image(watermarkBytes);
                    }
                    catch { }
                }

                page.Header().Row(row =>
                {
                    if (!string.IsNullOrEmpty(configuracion.LogoBase64)) 
                    { 
                        var base64Logo = configuracion.LogoBase64.Contains(",") 
                            ? configuracion.LogoBase64.Substring(configuracion.LogoBase64.IndexOf(",") + 1) 
                            : configuracion.LogoBase64; 
                        var logoBytes = Convert.FromBase64String(base64Logo); 
                        
                        row.ConstantItem(100).Image(logoBytes);
                        row.ConstantItem(15); 
                    }
                    row.RelativeItem().Column(col => 
                    { 
                        col.Item().Text(string.IsNullOrEmpty(configuracion.NombreEscuela) ? "Institución Educativa" : configuracion.NombreEscuela).SemiBold().FontSize(16).FontColor(QuestPDF.Helpers.Colors.Blue.Darken2); 
                        col.Item().Text("REPORTE FINANCIERO Y DE VENTAS").Bold().FontSize(12).FontColor(QuestPDF.Helpers.Colors.Grey.Darken3); 
                        string periodoTexto = filtroTiempo == "Personalizado" ? $"Del {rangoFechasCustom.Start:dd/MMM/yyyy} al {rangoFechasCustom.End:dd/MMM/yyyy}" : filtroTiempo; 
                        string textoFiltroAsesor = filtroAsesor == "Todos" ? "Todos los Asesores" : $"Asesor: {filtroAsesor}"; 
                        col.Item().Text($"Periodo: {periodoTexto} | {textoFiltroAsesor}").FontSize(10); 
                    });
                });

                page.Content().PaddingVertical(1, QuestPDF.Infrastructure.Unit.Centimetre).Column(x =>
                {
                    x.Spacing(15);
                    x.Item().Background(QuestPDF.Helpers.Colors.Grey.Lighten4).Padding(10).Row(row =>
                    {
                        row.RelativeItem().Column(c => { c.Item().Text("Ingresos Proyectados").FontSize(9).FontColor(QuestPDF.Helpers.Colors.Grey.Darken2); c.Item().Text(totalIngresos.ToString("C")).SemiBold().FontSize(12).FontColor(QuestPDF.Helpers.Colors.Green.Darken2); });
                        row.RelativeItem().Column(c => { c.Item().Text("Egresos / Gastos").FontSize(9).FontColor(QuestPDF.Helpers.Colors.Grey.Darken2); c.Item().Text($"- {totalGastosFiltro.ToString("C")}").SemiBold().FontSize(12).FontColor(QuestPDF.Helpers.Colors.Red.Medium); });
                        row.RelativeItem().Column(c => { c.Item().Text("Utilidad Neta").FontSize(9).FontColor(QuestPDF.Helpers.Colors.Grey.Darken2); c.Item().Text(utilidadRealNeta.ToString("C")).SemiBold().FontSize(12).FontColor(QuestPDF.Helpers.Colors.Blue.Darken2); });
                    });

                    x.Item().Background(QuestPDF.Helpers.Colors.Grey.Lighten4).Padding(10).Row(row =>
                    {
                        row.RelativeItem().Column(c => { c.Item().Text("Cobranza Real").FontSize(9).FontColor(QuestPDF.Helpers.Colors.Grey.Darken2); c.Item().Text(totalCobranzaReal.ToString("C")).SemiBold().FontSize(12).FontColor(QuestPDF.Helpers.Colors.Blue.Darken2); });
                        row.RelativeItem().Column(c => { c.Item().Text("Cartera Vencida").FontSize(9).FontColor(QuestPDF.Helpers.Colors.Grey.Darken2); c.Item().Text(carteraVencida.ToString("C")).SemiBold().FontSize(12).FontColor(QuestPDF.Helpers.Colors.Red.Medium); });
                        row.RelativeItem().Column(c => { c.Item().Text("Inscripciones").FontSize(9).FontColor(QuestPDF.Helpers.Colors.Grey.Darken2); c.Item().Text(totalInscritos.ToString()).SemiBold().FontSize(12); });
                    });

                    x.Item().LineHorizontal(1).LineColor(QuestPDF.Helpers.Colors.Grey.Lighten2);
                    x.Item().Text("DESGLOSE POR CURSO").SemiBold().FontSize(12).FontColor(QuestPDF.Helpers.Colors.Blue.Darken3);
                    x.Item().Table(table =>
                    {
                        table.ColumnsDefinition(columns => { columns.RelativeColumn(3); columns.RelativeColumn(1); columns.RelativeColumn(1.5f); });
                        table.Header(header => { header.Cell().BorderBottom(1).PaddingBottom(5).Text("Curso / Programa").SemiBold(); header.Cell().BorderBottom(1).PaddingBottom(5).AlignCenter().Text("Inscripciones").SemiBold(); header.Cell().BorderBottom(1).PaddingBottom(5).AlignRight().Text("Monto Proyectado").SemiBold(); });
                        foreach (var item in desgloseCursos) { table.Cell().PaddingVertical(5).BorderBottom(1).BorderColor(QuestPDF.Helpers.Colors.Grey.Lighten4).Text(item.NombreCurso); table.Cell().PaddingVertical(5).BorderBottom(1).BorderColor(QuestPDF.Helpers.Colors.Grey.Lighten4).AlignCenter().Text(item.Cantidad.ToString()); table.Cell().PaddingVertical(5).BorderBottom(1).BorderColor(QuestPDF.Helpers.Colors.Grey.Lighten4).AlignRight().Text(item.IngresoTotal.ToString("C")); }
                        table.Cell().PaddingTop(10).Text(""); table.Cell().PaddingTop(10).AlignCenter().Text("PROYECCIÓN TOTAL:").SemiBold().FontSize(12); table.Cell().PaddingTop(10).AlignRight().Text(totalIngresos.ToString("C")).SemiBold().FontSize(12).FontColor(QuestPDF.Helpers.Colors.Green.Darken3);
                    });
                });
                page.Footer().AlignCenter().Text(x => { x.Span("Página "); x.CurrentPageNumber(); x.Span(" de "); x.TotalPages(); x.Span($" | Documento generado el {DateTime.Now:dd/MM/yyyy a las HH:mm hrs}"); });
            });
        }).GeneratePdf();
    }
}
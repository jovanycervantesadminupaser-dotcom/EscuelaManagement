@page "/"
@layout EscuelaManagement.Components.Layout.LoginLayout
@using MudBlazor
@using EscuelaManagement.Data.Models
@using EscuelaManagement.Data.Services
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject FirebaseService Firebase
@inject UserSessionService UserSession

<style>
    /* Contenedor principal sin bordes */
    .login-wrapper {
        display: flex;
        min-height: 100vh;
        width: 100vw;
        margin: 0;
        padding: 0;
        background-color: #f1f5f9;
    }
    
    /* ========================================================
       LADO IZQUIERDO: FOTOGRAFÍA CON OVERLAY
       ======================================================== */
    .login-left-side {
        width: 50%;
        position: relative;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .login-left-side .overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: linear-gradient(135deg, rgba(30, 27, 75, 0.85) 0%, rgba(15, 23, 42, 0.70) 100%);
        z-index: 1;
    }

    .left-content {
        z-index: 2;
        text-align: center;
        color: white;
        padding: 2rem;
    }
    
    /* ========================================================
       LADO DERECHO: TARJETA M3 Y ANIMACIONES VÍVIDAS
       ======================================================== */
    .login-right-side {
        width: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background-color: #f8fafc;
    }

    /* Tarjeta Flotante con sombra más profunda */
    .m3-login-card {
        max-width: 460px;
        width: 100%;
        background-color: #ffffff;
        border-radius: 32px !important;
        padding: 3rem 2.5rem;
        box-shadow: 0 25px 50px -12px rgba(30, 27, 75, 0.15);
        border: 1px solid rgba(226, 232, 240, 0.8);
    }

    /* --- ANIMACIONES EN LOS INPUTS (EFECTO POP-OUT) --- */
    .modern-input .mud-input-outlined-border {
        border: 2px solid transparent !important;
        transition: all 0.3s ease-in-out;
    }
    
    .modern-input .mud-input {
        background-color: #f1f5f9 !important;
        border-radius: 16px !important;
        color: #0f172a !important;
        /* Transición elástica para que se sienta fluido */
        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) !important; 
    }
    
    .modern-input .mud-input-slot {
        padding: 16px 14px !important; 
    }

    /* Estado cuando el usuario hace clic (Focus) */
    .modern-input .mud-input.mud-input-focused {
        background-color: #ffffff !important;
        transform: scale(1.03) translateY(-2px); /* Escala y eleva el input */
        box-shadow: 0 14px 25px -8px rgba(59, 130, 246, 0.35) !important; /* Resplandor azul */
    }
    
    .modern-input .mud-input.mud-input-focused .mud-input-outlined-border {
        border-color: #3b82f6 !important;
        background-color: transparent !important;
    }

    /* --- ANIMACIÓN EN EL BOTÓN PRINCIPAL (VIVID GRADIENT) --- */
    .btn-vivid {
        background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%) !important; /* Índico a Cian vibrante */
        background-size: 200% auto !important;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;
        border: none !important;
    }
    
    .btn-vivid:hover {
        background-position: right center !important; /* Anima el degradado */
        transform: translateY(-4px) scale(1.02);
        box-shadow: 0 20px 30px -8px rgba(6, 182, 212, 0.5) !important; /* Resplandor cian */
    }

    /* Diseño Responsivo */
    @@media (max-width: 960px) {
        .login-left-side {
            display: none !important; 
        }
        .login-right-side {
            width: 100%;
            background-color: #ffffff;
        }
        .m3-login-card {
            box-shadow: none;
            border: none;
            padding: 2rem 1.5rem;
        }
    }

    /* Animación de salida */
    .animacion-salida {
        animation: fadeOutUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards !important;
    }

    @@keyframes fadeOutUp {
        0% { opacity: 1; transform: translateY(0) scale(1); }
        100% { opacity: 0; transform: translateY(-40px) scale(0.98); filter: blur(4px); }
    }
</style>

<div class="login-wrapper @claseAnimacionSalida">
    
    <!-- Lado Izquierdo (Foto y Logo) -->
    <div class="login-left-side" style="@(string.IsNullOrEmpty(backgroundLoginBase64) ? "background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);" : $"background-image: url('{backgroundLoginBase64}');")">
        <div class="overlay"></div>
        <div class="left-content">
            <MudIcon Icon="@Icons.Material.Filled.School" Style="font-size: 5rem; color: white; opacity: 0.9;" Class="mb-4" />
            <MudText Typo="Typo.h2" Class="font-weight-bold mb-2" Style="letter-spacing: -1px;">UPASER</MudText>
            <MudText Typo="Typo.h5" Style="opacity: 0.85; font-weight: 300;">@nombreEscuela</MudText>
        </div>
    </div>

    <!-- Lado Derecho (Tarjeta M3) -->
    <div class="login-right-side">
        <div class="m3-login-card">
            
            <div class="mb-8 text-center">
                <MudText Typo="Typo.h4" Class="font-weight-bold mb-2" Style="color: #0f172a; letter-spacing: -0.5px;">¡Hola, Bienvenido!</MudText>
                <MudText Typo="Typo.body2" Style="color: #64748b;">Ingresa tus credenciales para acceder al sistema escolar.</MudText>
            </div>

            <MudForm @ref="form" @bind-IsValid="@success">
                
                <!-- Campo: Correo Electrónico -->
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2 ml-1" Style="color: #334155;">Correo Electrónico</MudText>
                
                <MudTextField T="string" @bind-Value="email" 
                              Placeholder="ejemplo@correo.com" 
                              Variant="Variant.Outlined" 
                              Required="true" 
                              RequiredError="El correo es obligatorio" 
                              InputType="InputType.Email" 
                              Adornment="Adornment.Start" 
                              AdornmentIcon="@Icons.Material.Filled.Email" 
                              Class="mb-6 modern-input" />

                <!-- Campo: Contraseña -->
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2 ml-1" Style="color: #334155;">Contraseña</MudText>
                
                <MudTextField T="string" @bind-Value="password" 
                              Placeholder="••••••••" 
                              Variant="Variant.Outlined" 
                              Required="true" 
                              RequiredError="La contraseña es obligatoria" 
                              InputType="@passwordInput" 
                              Adornment="Adornment.End" 
                              AdornmentIcon="@passwordInputIcon" 
                              OnAdornmentClick="TogglePasswordVisibility" 
                              AdornmentAriaLabel="Mostrar contraseña"
                              Class="mb-2 modern-input" />
            </MudForm>

            <!-- Enlace: Olvidaste tu contraseña -->
            <div class="d-flex justify-end mb-8 mt-3">
                <MudLink OnClick="RecuperarContrasena" Typo="Typo.caption" Style="color: #3b82f6; cursor: pointer; text-decoration: none; font-weight: bold; transition: color 0.2s;" Class="hover:text-cyan-500">
                    ¿Olvidaste Tu Contraseña?
                </MudLink>
            </div>

            <!-- Botón Principal Vívido -->
            <MudButton OnClick="Ingresar" 
                       Disabled="@cargando"
                       Variant="Variant.Filled" 
                       Size="Size.Large" 
                       FullWidth="true" 
                       Class="rounded-xl py-4 font-weight-bold text-white shadow-md btn-vivid" 
                       Style="font-size: 15px; letter-spacing: 0.5px;">
                @if (cargando)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" Color="Color.Inherit" />
                    <MudText Class="ms-2 font-weight-bold" Style="color: white;">VERIFICANDO...</MudText>
                }
                else
                {
                    <MudText Class="font-weight-bold">INGRESAR AL SISTEMA</MudText>
                }
            </MudButton>

            <div class="text-center mt-8">
                <MudText Typo="Typo.caption" Style="color: #94a3b8;">UPASER. Todos los derechos reservados.</MudText>
            </div>

        </div>
    </div>
</div>

@code {
    private bool success;
    private bool cargando = false;
    private MudForm form = default!;
    private string email = "";
    private string password = "";
    private string nombreEscuela = "Cargando...";
    private string backgroundLoginBase64 = "";
    private string claseAnimacionSalida = "";

    private bool isShow;
    private InputType passwordInput = InputType.Password;
    private string passwordInputIcon = Icons.Material.Filled.VisibilityOff;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var configuracion = await Firebase.GetConfiguracionAsync();
            if (configuracion != null)
            {
                nombreEscuela = !string.IsNullOrEmpty(configuracion.NombreEscuela) ? configuracion.NombreEscuela : "EscuelaManager";
                backgroundLoginBase64 = configuracion.BackgroundLoginBase64 ?? "";
            }
        }
        catch
        {
            nombreEscuela = "EscuelaManager";
        }
    }

    private void TogglePasswordVisibility()
    {
        if (isShow)
        {
            isShow = false;
            passwordInputIcon = Icons.Material.Filled.VisibilityOff;
            passwordInput = InputType.Password;
        }
        else
        {
            isShow = true;
            passwordInputIcon = Icons.Material.Filled.Visibility;
            passwordInput = InputType.Text;
        }
    }

    private async Task Ingresar()
    {
        await form.ValidateAsync();
        if (form.IsValid)
        {
            cargando = true;
            StateHasChanged();

            try
            {
                var usuariosDB = await Firebase.GetUsuariosAsync();
                var usuarioValido = usuariosDB.FirstOrDefault(u => u.Correo == email && u.Password == password);

                if (usuarioValido != null)
                {
                    if (!usuarioValido.Activo)
                    {
                        Snackbar.Add("Tu cuenta está suspendida. Contacta a Dirección.", Severity.Warning);
                    }
                    else
                    {
                        await UserSession.IniciarSesionAsync(usuarioValido.Nombre, usuarioValido.Correo, usuarioValido.Rol);
                        Snackbar.Add($"¡Bienvenido, {usuarioValido.Nombre}!", Severity.Success);
                        
                        // --- INICIA LA ANIMACIÓN ---
                        claseAnimacionSalida = "animacion-salida";
                        StateHasChanged();
                        await Task.Delay(400); 
                        
                        Navigation.NavigateTo("/inicio", forceLoad: false);
                    }
                }
                else
                {
                    if (email == "admin@admin.com" && password == "123456")
                    {
                        await UserSession.IniciarSesionAsync("Llave Maestra", email, "Administrador");
                        Snackbar.Add("Entrando con Llave Maestra.", Severity.Info);
                        
                        claseAnimacionSalida = "animacion-salida";
                        StateHasChanged();
                        await Task.Delay(400); 
                        
                        Navigation.NavigateTo("/inicio", forceLoad: false);
                    }
                    else
                    {
                        Snackbar.Add("Credenciales incorrectas. Verifica tu correo y contraseña.", Severity.Error);
                    }
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error de conexión: {ex.Message}", Severity.Error);
            }
            finally
            {
                cargando = false;
                StateHasChanged();
            }
        }
    }

    private async Task RecuperarContrasena()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            Snackbar.Add("Por favor, ingresa tu correo electrónico para buscar tu cuenta.", Severity.Warning);
            return;
        }

        cargando = true;
        StateHasChanged();

        try
        {
            var usuariosDB = await Firebase.GetUsuariosAsync();
            var usuarioExiste = usuariosDB.FirstOrDefault(u => u.Correo == email);

            if (usuarioExiste != null)
            {
                Snackbar.Add($"Cuenta localizada. Por seguridad, solicita a Administración el restablecimiento de contraseña para el usuario {usuarioExiste.Nombre}.", Severity.Info);
            }
            else
            {
                Snackbar.Add("No encontramos ninguna cuenta asociada a este correo.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al buscar la cuenta: {ex.Message}", Severity.Error);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }
}
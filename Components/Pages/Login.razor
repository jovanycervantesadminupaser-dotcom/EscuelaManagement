@page "/"
@layout EscuelaManagement.Components.Layout.LoginLayout
@using MudBlazor
@using EscuelaManagement.Data.Models
@using EscuelaManagement.Data.Services
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject FirebaseService Firebase
@inject UserSessionService UserSession

<style>
    /* Contenedor principal para ocupar toda la pantalla sin bordes */
    .login-wrapper {
        display: flex;
        min-height: 100vh;
        width: 100vw;
        margin: 0;
        padding: 0;
    }
    
    /* Lado Izquierdo: Fotografía con Overlay */
    .login-left-side {
        width: 50%;
        position: relative;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    /* La capa azul transparente sobre la foto */
    .login-left-side .overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background-color: rgba(0, 51, 102, 0.70); /* Azul institucional transparente */
        z-index: 1;
    }

    .left-content {
        z-index: 2;
        text-align: center;
        color: white;
        padding: 2rem;
    }
    
    /* Lado Derecho: Área de Trabajo Blanca */
    .login-right-side {
        width: 50%;
        background-color: #FFFFFF;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

    .form-container {
        max-width: 420px;
        width: 100%;
    }

    /* Estilos de los inputs modernos (Cajas grises sin borde) */
    .modern-input .mud-input-outlined-border {
        border: none !important;
    }
    .modern-input .mud-input {
        background-color: #F3F4F6 !important;
        border-radius: 8px !important;
        color: #1F2937 !important;
    }
    .modern-input .mud-input-slot {
        padding: 16px 14px !important; 
    }

    /* Diseño Responsivo: Ocultar foto en celulares (Doble arroba para evitar error de C#) */
    @@media (max-width: 960px) {
        .login-left-side {
            display: none !important; 
        }
        .login-right-side {
            width: 100%;
        }
    }
</style>

<div class="login-wrapper">
    
    <!-- Lado Izquierdo (Foto y Logo) -->
    <div class="login-left-side" style="@(string.IsNullOrEmpty(backgroundLoginBase64) ? "background-color: #003366;" : $"background-image: url('{backgroundLoginBase64}');")">
        <div class="overlay"></div>
        <div class="left-content">
            <MudIcon Icon="@Icons.Material.Filled.School" Style="font-size: 5rem; color: white;" Class="mb-4" />
            <MudText Typo="Typo.h2" Class="font-weight-bold mb-2">UPASER</MudText>
            <MudText Typo="Typo.h5" Style="opacity: 0.9;">@nombreEscuela</MudText>
        </div>
    </div>

    <!-- Lado Derecho (Formulario Blanco) -->
    <div class="login-right-side">
        <div class="form-container">
            
            <MudText Typo="Typo.h4" Class="font-weight-bold mb-1" Style="color: #1F2937;">¡Bienvenido de vuelta!</MudText>
            <MudText Typo="Typo.body1" Class="mb-8" Style="color: #6B7280;">Ingresa tus credenciales para acceder al sistema escolar.</MudText>

            <MudForm @ref="form" @bind-IsValid="@success">
                
                <!-- Campo: Correo Electrónico -->
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-1" Style="color: #1F2937;">Correo Electrónico</MudText>
                
                <MudTextField T="string" @bind-Value="email" 
                              Placeholder="ejemplo@correo.com" 
                              Variant="Variant.Outlined" 
                              Required="true" 
                              RequiredError="El correo es obligatorio" 
                              InputType="InputType.Email" 
                              Adornment="Adornment.Start" 
                              AdornmentIcon="@Icons.Material.Filled.Email" 
                              Class="mb-4 modern-input" />

                <!-- Campo: Contraseña -->
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-1" Style="color: #1F2937;">Contraseña</MudText>
                
                <MudTextField T="string" @bind-Value="password" 
                              Placeholder="••••••••" 
                              Variant="Variant.Outlined" 
                              Required="true" 
                              RequiredError="La contraseña es obligatoria" 
                              InputType="@passwordInput" 
                              Adornment="Adornment.End" 
                              AdornmentIcon="@passwordInputIcon" 
                              OnAdornmentClick="TogglePasswordVisibility" 
                              AdornmentAriaLabel="Mostrar contraseña"
                              Class="mb-2 modern-input" />
            </MudForm>

            <!-- Enlace: Olvidaste tu contraseña -->
            <div class="d-flex justify-end mb-8 mt-1">
                <MudLink OnClick="RecuperarContrasena" Typo="Typo.body2" Style="color: #003366; cursor: pointer; text-decoration: none;">
                    ¿Olvidaste Tu Contraseña?
                </MudLink>
            </div>

            <!-- Botón Principal -->
            <MudButton OnClick="Ingresar" 
                       Disabled="@cargando"
                       Variant="Variant.Filled" 
                       Size="Size.Large" 
                       FullWidth="true" 
                       Class="rounded-lg py-3 font-weight-bold text-white" 
                       Style="background-color: #003366; font-size: 16px; letter-spacing: 0.5px;">
                @if (cargando)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" Color="Color.Inherit" />
                    <MudText Class="ms-2" Style="color: white;">VERIFICANDO...</MudText>
                }
                else
                {
                    <MudText>INGRESAR AL SISTEMA</MudText>
                }
            </MudButton>

            <div class="text-center mt-12">
                <MudText Typo="Typo.caption" Style="color: #9CA3AF;">UPASER. Todos los derechos reservados.</MudText>
            </div>

        </div>
    </div>
</div>

@code {
    private bool success;
    private bool cargando = false;
    private MudForm form = default!;
    private string email = "";
    private string password = "";
    private string nombreEscuela = "Cargando...";
    private string backgroundLoginBase64 = "";

    private bool isShow;
    private InputType passwordInput = InputType.Password;
    private string passwordInputIcon = Icons.Material.Filled.VisibilityOff;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var configuracion = await Firebase.GetConfiguracionAsync();
            if (configuracion != null)
            {
                nombreEscuela = !string.IsNullOrEmpty(configuracion.NombreEscuela) ? configuracion.NombreEscuela : "EscuelaManager";
                backgroundLoginBase64 = configuracion.BackgroundLoginBase64 ?? "";
            }
        }
        catch
        {
            nombreEscuela = "EscuelaManager";
        }
    }

    private void TogglePasswordVisibility()
    {
        if (isShow)
        {
            isShow = false;
            passwordInputIcon = Icons.Material.Filled.VisibilityOff;
            passwordInput = InputType.Password;
        }
        else
        {
            isShow = true;
            passwordInputIcon = Icons.Material.Filled.Visibility;
            passwordInput = InputType.Text;
        }
    }

    private async Task Ingresar()
    {
        await form.ValidateAsync();
        if (form.IsValid)
        {
            cargando = true;
            StateHasChanged();

            try
            {
                var usuariosDB = await Firebase.GetUsuariosAsync();
                var usuarioValido = usuariosDB.FirstOrDefault(u => u.Correo == email && u.Password == password);

                if (usuarioValido != null)
                {
                    if (!usuarioValido.Activo)
                    {
                        Snackbar.Add("Tu cuenta está suspendida. Contacta a Dirección.", Severity.Warning);
                    }
                    else
                    {
                        await UserSession.IniciarSesionAsync(usuarioValido.Nombre, usuarioValido.Correo, usuarioValido.Rol);
                        Snackbar.Add($"¡Bienvenido, {usuarioValido.Nombre}!", Severity.Success);
                        Navigation.NavigateTo("/inicio", forceLoad: true);
                    }
                }
                else
                {
                    if (email == "admin@admin.com" && password == "123456")
                    {
                        await UserSession.IniciarSesionAsync("Llave Maestra", email, "Administrador");
                        Snackbar.Add("Entrando con Llave Maestra.", Severity.Info);
                        Navigation.NavigateTo("/inicio", forceLoad: true);
                    }
                    else
                    {
                        Snackbar.Add("Credenciales incorrectas. Verifica tu correo y contraseña.", Severity.Error);
                    }
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error de conexión: {ex.Message}", Severity.Error);
            }
            finally
            {
                cargando = false;
                StateHasChanged();
            }
        }
    }

    private async Task RecuperarContrasena()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            Snackbar.Add("Por favor, ingresa tu correo electrónico para buscar tu cuenta.", Severity.Warning);
            return;
        }

        cargando = true;
        StateHasChanged();

        try
        {
            var usuariosDB = await Firebase.GetUsuariosAsync();
            var usuarioExiste = usuariosDB.FirstOrDefault(u => u.Correo == email);

            if (usuarioExiste != null)
            {
                Snackbar.Add($"Cuenta localizada. Por seguridad, solicita a Administración el restablecimiento de contraseña para el usuario {usuarioExiste.Nombre}.", Severity.Info);
            }
            else
            {
                Snackbar.Add("No encontramos ninguna cuenta asociada a este correo.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al buscar la cuenta: {ex.Message}", Severity.Error);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }
}
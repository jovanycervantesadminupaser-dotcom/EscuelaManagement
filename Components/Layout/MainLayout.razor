@inherits LayoutComponentBase
@using MudBlazor
@using EscuelaManagement.Data.Models
@using EscuelaManagement.Data.Services
@inject NavigationManager Navigation
@inject FirebaseService Firebase

<style>
    /* 1. Fondo general de la aplicación (Gris claro) */
    .mud-layout {
        background-color: #F3F4F6 !important;
    }

    /* 2. DISEÑO DEL MENÚ LATERAL (Sidebar Azul) */
    /* Teñimos el Drawer (el menú) de azul oscuro */
    .modern-sidebar .mud-drawer-content {
        background-color: #003366 !important;
        color: #FFFFFF !important;
    }
    
    /* Hacemos que los textos y los iconos dentro del menú sean blancos o grises claros */
    .modern-sidebar .mud-nav-link {
        color: #E5E7EB !important; /* Texto gris muy claro */
        padding: 12px 16px;
        margin: 4px 12px;
        border-radius: 8px; /* Botones redondeados dentro del menú */
        transition: all 0.2s ease-in-out;
    }
    .modern-sidebar .mud-nav-link-icon {
        color: rgba(255, 255, 255, 0.7) !important; /* Iconos un poco transparentes */
    }

    /* 3. Efectos al pasar el mouse y al seleccionar (Hover & Active) */
    .modern-sidebar .mud-nav-link:hover {
        background-color: rgba(255, 255, 255, 0.1) !important;
        color: #FFFFFF !important;
    }
    .modern-sidebar .mud-nav-link:hover .mud-nav-link-icon {
        color: #FFFFFF !important;
    }
    
    /* El enlace activo (donde el usuario está actualmente) */
    .modern-sidebar .mud-nav-link.active {
        background-color: rgba(255, 255, 255, 0.2) !important;
        color: #FFFFFF !important;
        font-weight: bold;
    }
    .modern-sidebar .mud-nav-link.active .mud-nav-link-icon {
        color: #FFFFFF !important;
    }
    
    /* Si tienes submenús (NavGroup), les cambiamos el color también */
    .modern-sidebar .mud-nav-group > .mud-nav-link {
        color: #FFFFFF !important;
    }
</style>

<MudThemeProvider @ref="@_mudThemeProvider" @bind-IsDarkMode="@_isDarkMode" Theme="_themeCustom" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    
    <!-- BARRA SUPERIOR (Appbar Blanca) -->
    <!-- Usamos Color="Color.Surface" (Blanco) y un Elevation suave -->
    <MudAppBar Elevation="1" Color="Color.Surface" Fixed="true">
        <!-- El botón del menú ahora es oscuro (Color.Dark) para que se vea sobre el blanco -->
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Dark" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        
        <!-- Nombre de la escuela en azul oscuro -->
        <MudText Typo="Typo.h6" Class="ml-3 font-weight-bold" Style="color: #003366;">@nombreEscuela</MudText>
        
        <MudSpacer />
        
        <!-- BOTÓN INTERRUPTOR PARA MODO OSCURO -->
        <MudToggleIconButton @bind-Toggled="@_isDarkMode"
                     Icon="@Icons.Material.Filled.DarkMode" Color="Color.Dark" Title="Activar Modo Oscuro"
                     ToggledIcon="@Icons.Material.Filled.LightMode" ToggledColor="Color.Dark" ToggledTitle="Activar Modo Claro" 
                     Class="mr-4" />

        <!-- Botón de Cerrar Sesión minimalista -->
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Logout" Size="Size.Small" OnClick="CerrarSesion">
            Salir
        </MudButton>
    </MudAppBar>

    <!-- MENÚ LATERAL (Sidebar Azul) -->
    <!-- Le agregamos la clase 'modern-sidebar' que definimos en el CSS arriba -->
    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Docked" Class="modern-sidebar" Fixed="true">
        
        <!-- Espacio en la parte superior del menú para separar del borde -->
        <div class="mt-4 mb-2 px-4">
             <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.5); font-weight: bold; letter-spacing: 1px;">MENÚ PRINCIPAL</MudText>
        </div>
        
        <NavMenu />
    </MudDrawer>

    <!-- CONTENIDO PRINCIPAL -->
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-6 pb-12">
            <div @key="Navigation.Uri" class="@claseAnimacion">
                @Body
            </div>
        </MudContainer>
    </MudMainContent>

    <!-- BOTÓN FLOTANTE DE ACCIÓN RÁPIDA (FAB) -->
    <div style="position: fixed; bottom: 30px; right: 30px; z-index: 9999;">
        <MudMenu @bind-Open="_fabOpen" AnchorOrigin="Origin.TopCenter" TransformOrigin="Origin.BottomCenter">
            <ActivatorContent>
                <MudFab Color="Color.Secondary" 
                        StartIcon="@Icons.Material.Filled.Add" 
                        Size="Size.Large" 
                        Elevation="4" 
                        OnClick="@(() => _fabOpen = !_fabOpen)" />
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Href="/pagos" Icon="@Icons.Material.Filled.PointOfSale" IconColor="Color.Success" OnClick="@(() => _fabOpen = false)">Cobro Rápido</MudMenuItem>
                <MudMenuItem Href="/inscripciones" Icon="@Icons.Material.Filled.PersonAdd" IconColor="Color.Info" OnClick="@(() => _fabOpen = false)">Inscribir Alumno</MudMenuItem>
            </ChildContent>
        </MudMenu>
    </div>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private string nombreEscuela = "Cargando...";
    private string claseAnimacion = "fade-in-up";

    private bool _isDarkMode;
    private bool _fabOpen = false;
    private MudThemeProvider _mudThemeProvider = default!;

    // Mantenemos tu tema personalizado
    private readonly MudTheme _themeCustom = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#003366",      
            Secondary = "#0099B8",    
            Success = "#76C043",      
            Background = "#F3F4F6", /* Gris muy claro para el fondo */
            Surface = "#FFFFFF",      
            AppbarBackground = "#FFFFFF" /* Cambiamos a blanco por defecto */
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#0099B8",      
            Secondary = "#76C043",    
            Success = "#76C043",
            Background = "#121824",    
            Surface = "#1A2332",      
            AppbarBackground = "#1A2332",
            TextPrimary = "#ECEFF1",   
            TextSecondary = "#B0BEC5"  
        }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var configuracion = await Firebase.GetConfiguracionAsync();
            nombreEscuela = !string.IsNullOrEmpty(configuracion.NombreEscuela) ? configuracion.NombreEscuela : "EscuelaManager";
        }
        catch
        {
            nombreEscuela = "EscuelaManager";
        }
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task CerrarSesion()
    {
        claseAnimacion = "fade-out-down";
        StateHasChanged(); 
        await Task.Delay(400);
        Navigation.NavigateTo("/");
        claseAnimacion = "fade-in-up"; 
    }
}
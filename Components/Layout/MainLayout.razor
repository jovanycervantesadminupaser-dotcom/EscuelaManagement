@inherits LayoutComponentBase
@using MudBlazor
@using EscuelaManagement.Data.Models
@using EscuelaManagement.Data.Services
@inject NavigationManager Navigation
@inject FirebaseService Firebase

<MudThemeProvider @ref="@_mudThemeProvider" @bind-IsDarkMode="@_isDarkMode" Theme="_themeCustom" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h5" Class="ml-3">@nombreEscuela</MudText>
        
        <MudSpacer />
        
        <!-- BOTÓN INTERRUPTOR PARA MODO OSCURO -->
        <MudToggleIconButton @bind-Toggled="@_isDarkMode"
                             Icon="@Icons.Material.Filled.DarkMode" Color="Color.Inherit" Title="Activar Modo Oscuro"
                             ToggledIcon="@Icons.Material.Filled.LightMode" ToggledColor="Color.Inherit" ToggledTitle="Activar Modo Claro" 
                             Class="mr-2" />

        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Logout" OnClick="CerrarSesion">
            Cerrar Sesión
        </MudButton>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4">
            <div @key="Navigation.Uri" class="@claseAnimacion">
                @Body
            </div>
        </MudContainer>
    </MudMainContent>

    <!-- BOTÓN FLOTANTE DE ACCIÓN RÁPIDA (FAB) CON CONTROL MANUAL -->
    <div style="position: fixed; bottom: 30px; right: 30px; z-index: 9999;">
        <MudMenu @bind-Open="_fabOpen" AnchorOrigin="Origin.TopCenter" TransformOrigin="Origin.BottomCenter">
            <ActivatorContent>
                <MudFab Color="Color.Secondary" 
                        StartIcon="@Icons.Material.Filled.FlashOn" 
                        Size="Size.Large" 
                        Elevation="4" 
                        OnClick="@(() => _fabOpen = !_fabOpen)" />
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Href="/pagos" Icon="@Icons.Material.Filled.PointOfSale" IconColor="Color.Success" OnClick="@(() => _fabOpen = false)">Cobro Rápido</MudMenuItem>
                <MudMenuItem Href="/alumnos" Icon="@Icons.Material.Filled.PersonAdd" IconColor="Color.Info" OnClick="@(() => _fabOpen = false)">Inscribir Alumno</MudMenuItem>
            </ChildContent>
        </MudMenu>
    </div>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private string nombreEscuela = "Cargando...";
    private string claseAnimacion = "fade-in-up";

    // Variables para Modo Oscuro y Control del Botón Flotante
    private bool _isDarkMode;
    private bool _fabOpen = false;
    private MudThemeProvider _mudThemeProvider = default!;

    private readonly MudTheme _themeCustom = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#003366",      
            Secondary = "#0099B8",    
            Success = "#76C043",      
            Background = "#F4F6F9",    
            Surface = "#FFFFFF",      
            AppbarBackground = "#003366"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#0099B8",      
            Secondary = "#76C043",    
            Success = "#76C043",
            Background = "#121824",    
            Surface = "#1A2332",      
            AppbarBackground = "#1A2332",
            TextPrimary = "#ECEFF1",   
            TextSecondary = "#B0BEC5"  
        }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var configuracion = await Firebase.GetConfiguracionAsync();
            nombreEscuela = !string.IsNullOrEmpty(configuracion.NombreEscuela) ? configuracion.NombreEscuela : "EscuelaManager";
        }
        catch
        {
            nombreEscuela = "EscuelaManager";
        }
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task CerrarSesion()
    {
        claseAnimacion = "fade-out-down";
        StateHasChanged(); 
        await Task.Delay(400);
        Navigation.NavigateTo("/");
        claseAnimacion = "fade-in-up"; 
    }
}